annot(#noCore)

# A result type's condition written over [$out], returning a value the predicate is decided false
  on: [Nat | $out.isZ == True] is [Nat_isZ], and [S(n= Z).isZ == True] reaches only [False], so the
  result is empty and the definition is refused statically. The twin page refineOut.ct has the
  forms that hold or are left to the runtime.
#noCore
module(Data/Primitive)
  data(Integer)
  data(True)
  data(False)

  class(Boolean, [True, False])
module(Catln)
  data(IO)

(_ :: Boolean == _ :: Boolean) -> Boolean
(l :: True == r :: True)= True
(l :: False == r :: False)= True
(l :: True == r :: False)= False
(l :: False == r :: True)= False

class(Nat, [Z, S(n -> Nat)])

isZero(n -> Nat) -> Boolean
isZero(n= Z)= True
isZero(n= S(n@m))= False

:Nat.isZ -> Boolean= isZero(n= this)

h(a -> Nat) -> (Nat | $out.isZ == True)= S(n= Z)

g(x -> Nat) -> IO= IO

main -> IO= g(x= h(a= Z))
