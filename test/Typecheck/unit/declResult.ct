annot(#noCore)

# A definition's declared result refines what its body gives at every call. [hGen] returns its
  argument where a [Nat_isZ] ([Nat | $this.isZ == True]) is declared: on every [Nat] the predicate
  is undecided, so the definition is guaranteed by shape and the check is the runtime's — but a
  CALL is read within the declaration, so [hZ]'s [hGen(a= Z)] is a [Z] within the refinement,
  decided true, and [onNat]'s [hGen(a= n)] keeps the predicate on the value it passes on. The twin
  page declResultFails.err.ct calls it with an [S], on which the predicate is decided false and the
  call is empty.
#noCore
module(Data/Primitive)
  data(Integer)
  data(True)
  data(False)

  class(Boolean, [True, False])
module(Catln)
  data(IO)

(_ :: Boolean == _ :: Boolean) -> Boolean
(l :: True == r :: True)= True
(l :: False == r :: False)= True
(l :: True == r :: False)= False
(l :: False == r :: True)= False

class(Nat, [Z, S(n -> Nat)])

isZero(n -> Nat) -> Boolean
isZero(n= Z)= True
isZero(n= S(n@m))= False

:Nat.isZ -> Boolean= isZero(n= this)

hGen(a -> Nat) -> Nat_isZ= a

hZ= hGen(a= Z)

onNat(n -> Nat) -> Nat= hGen(a= n)
