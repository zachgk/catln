annot(#noCore)

# A result declared within a refinement, returning a value the predicate is decided false on:
  [S(n= Z).isZ == True] reaches only [False], so the result is empty and the definition is refused
  statically rather than left to the runtime. The twin page refineRuntime.ct has the forms the type
  checker cannot decide.
#noCore
module(Data/Primitive)
  data(Integer)
  data(True)
  data(False)

  class(Boolean, [True, False])
module(Catln)
  data(IO)

(_ :: Boolean == _ :: Boolean) -> Boolean
(l :: True == r :: True)= True
(l :: False == r :: False)= True
(l :: True == r :: False)= False
(l :: False == r :: True)= False

class(Nat, [Z, S(n -> Nat)])

isZero(n -> Nat) -> Boolean
isZero(n= Z)= True
isZero(n= S(n@m))= False

:Nat.isZ -> Boolean= isZero(n= this)

h(a -> Nat) -> Nat_isZ= S(n= Z)

g(x -> Nat) -> IO= IO

main -> IO= g(x= h(a= Z))
