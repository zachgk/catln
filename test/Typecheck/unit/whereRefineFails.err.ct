annot(#noCore)

# A call of a body refined by its condition, passing a value the predicate is decided false on:
  [k] returns [a | a.isZ == True], so [k(a= S(n= Z))] is [S(n= Z) | $this.isZ == True], on which
  [isZ] reaches only [False]; the result is empty and the page is refused statically. The twin
  page whereRefine.ct has the calls that hold.
#noCore
module(Data/Primitive)
  data(Integer)
  data(True)
  data(False)

  class(Boolean, [True, False])
module(Catln)
  data(IO)

(_ :: Boolean == _ :: Boolean) -> Boolean
(l :: True == r :: True)= True
(l :: False == r :: False)= True
(l :: True == r :: False)= False
(l :: False == r :: True)= False

class(Nat, [Z, S(n -> Nat)])

isZero(n -> Nat) -> Boolean
isZero(n= Z)= True
isZero(n= S(n@m))= False

:Nat.isZ -> Boolean= isZero(n= this)

k(a -> Nat) -> Nat= a | a.isZ == True

g(x -> Nat) -> IO= IO

main -> IO= g(x= k(a= S(n= Z)))
