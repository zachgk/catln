annot(#noCore)

# A body's condition refines its value by the condition's form. [k] returns [a | a.isZ == True]:
  the where's type is [a] within the predicate [$this.isZ == True], the form [Nat_isZ] desugars
  to, with the base argument named as the refined value, so [kDecl] is guaranteed within its
  declared [Nat_isZ] by the predicate itself and [kZ]'s [k(a= Z)] settles to the [Z] it passes.
  [kFn] applies the predicate as a function; [kOther] conditions on another argument, whose
  predicate is over that argument's variable; [kArg] conditions on a bare argument, which states
  no predicate (its value is still checked where the condition is written). The twin error
  pages whereRefineFails.err.ct and whereRefineFnFails.err.ct call [k] and [kFn] on an [S], on
  which the predicate is decided false, and are refused statically; before the form was kept,
  the predicate carried the condition's reached values and said nothing of the value, so those
  calls failed only at runtime.
#noCore
module(Data/Primitive)
  data(Integer)
  data(True)
  data(False)

  class(Boolean, [True, False])
module(Catln)
  data(IO)

(_ :: Boolean == _ :: Boolean) -> Boolean
(l :: True == r :: True)= True
(l :: False == r :: False)= True
(l :: True == r :: False)= False
(l :: False == r :: True)= False

class(Nat, [Z, S(n -> Nat)])

isZero(n -> Nat) -> Boolean
isZero(n= Z)= True
isZero(n= S(n@m))= False

:Nat.isZ -> Boolean= isZero(n= this)

k(a -> Nat) -> Nat= a | a.isZ == True

kFn(a -> Nat) -> Nat= a | isZero(n= a)

kDecl(a -> Nat) -> Nat_isZ= a | a.isZ == True

kOther(a -> Nat, b -> Nat) -> Nat= a | b.isZ == True

kArg(a -> Nat, b -> Boolean) -> Nat= a | b

kZ= k(a= Z)

g(x -> Nat) -> IO= IO

main -> IO= g(x= kDecl(a= kFn(a= kOther(a= kArg(a= kZ, b= True), b= Z))))
