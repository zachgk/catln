import "core"

# Repro: a destructured element binding in a definition pattern must inherit the element bound
  declared on the function's argument. Here `bothEq` is declared over Pair[$A -> Eq, $B -> Eq], so
  the destructured `first` binding `f` should be bounded by Eq and `f == f` should type-check and
  dispatch. Concrete construction/extraction already works (a value's element binds fine); this
  isolates the *parametric* case where the element's only bound comes from the declaration.
data(Pair[$A, $B](first -> $A, second -> $B))
bothEq(p -> Pair[$A -> /Data/Algebra/Eq, $B -> /Data/Algebra/Eq]) -> Boolean
bothEq(Pair(first= f, second= s))= f == f

main{io -> IO} =
  #assert(test= bothEq(p= Pair(first= 5, second= 7)))
  io
