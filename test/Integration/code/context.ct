import "core"


# Tests a context holding more than one state. main adds a [Counter] beside its [io], [inc]
  replaces it, and [counterValue] reads it back, so main exits with 0 only where the counter reached 1.
  A state is found by the type it is written with: [inc] writes only the pattern, [counterValue]
  aliases it as [c], and both find the one main added.
data(Counter(i -> Integer))

# [inc] answers with only the state it changes. The bind calling it keeps the [io] it never named.
inc{Counter(i)}= (){Counter(i + 1)}

counterValue{Counter(i)@c}= i{Counter(i)}

main{io -> IO} -> (){IO} =
  _<- (){Counter(0)}
  _<- inc
  n<- counterValue
  _<- exit(val= n - 1)
  ()
