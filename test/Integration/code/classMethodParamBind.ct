import "core"
import "core"


module(Scratch)
  # A class method over a type its members choose, written as core's [Eqv] is while refinement
  # types cannot state that type. The abstract [rel] takes arguments of any one type and is
  # [#invalid]: each member defines it only over the type it relates, so the declaration is not
  # checked for fulfillment. The member [MyEqv] relates [Integer]s, so its definition types its
  # arguments as [Integer] itself.
  class(TEqv)

  :TEqv.rel[$T](a -> $T, b -> $T) -> Boolean
    #invalid

  data(MyEqv, isa= [/Scratch/TEqv])

  :MyEqv.rel(a -> Integer, b -> Integer)= /Data/Primitive/intEq(l= a, r= b)

  main{io -> IO} =
    #assert(test= MyEqv.rel(a= 2, b= 2))
    io
