import "core"
import "llm"


# What [/Llm/lcm] asks a model, built without asking one: this page, as it was written, with its
  annotations shown, and then the question.
double(x -> Integer) -> Integer
  # [double] is twice [x].
double(x)= x + x

> double(x= 2)
annot(#hint(text -> String))
  # A [#hint] is written for a model as what it says.

/Llm/llmshow(s= #hint(text))= "hint: " ++ text

#hint(text= "double never fails")
main{io -> IO}= io.println(msg= /Llm/lcmPrompt(input= "What does double do?")).exit(val= 0)
