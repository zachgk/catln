import "core"
import "llm"


# What [/Llm/lcm] asks a model, built without asking one: this page, as it was written, with its
  annotations shown, what is wrong with it noted where it is wrong, and then the question.
double(x -> Integer) -> Integer
  # [double] is twice [x].
double(x)= x + x

> double(x= 2)
# A print whose golden is no longer what it prints is shown with the golden it was written with,
  and noted as failing.
> double(x= 3)
  >>> 5
# A definition the compiler cannot build is noted with what the compiler said.
anyOver[$A](lst -> /Data/List/ConsList[$T -> $_A], fn(v -> $_A) -> Boolean) -> Boolean
anyOver(lst, fn(v))= /Data/List/any(lst= /Data/Functor/fmap(lst= lst, fn(v)= fn(v= v)))

annot(#hint(text -> String))
  # A [#hint] is written for a model as what it says.

/Llm/llmshow(s= #hint(text))= "hint: " ++ text

#hint(text= "double never fails")
main{io -> IO}= io.println(msg= /Llm/lcmPrompt(input= "What does double do?")).exit(val= 0)
