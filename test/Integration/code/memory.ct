import "core"
import "memory"


# Tests [Memory] in a context: main adds an empty [MemoryMap] beside its [io], creates a [Var] of
  [Integer], puts 7 in it, has a [String] refused by it, and reads it back. It exits with 0 only
  where the 7 is read back, the [Integer] was taken and the [String] refused.
  The bind chain is kept short: each bind over the memory's state costs minutes of type inference.
module(MemoryTest)
  sevenRead(found= /Data/Maybe/Some(value -> Integer))= value - 7
  sevenRead(found) else = 1

  failures(taken= /Data/Result/Ok(value), refused= /Data/Result/Fail(err))= 0
  failures(taken, refused) else = 1

main{io -> IO} -> (){IO} =
  _<- (){/Data/Memory/MemoryMap(map= /Data/Map/Leaf, next= 0)}
  x<- /Data/Memory/var(type= /Catln/typeOf[$T -> Integer])

  taken<- x := 7

  refused<- x := "seven"

  got<- /Data/Memory/read(target= x)
  _<- exit(val= /MemoryTest/sevenRead(found= got) + /MemoryTest/failures(taken= taken, refused= refused))
  ()
