import "core"


# A list of two or more held in a FIELD, built and evaluated rather than only declared.
  The printed face of @listFieldMultiple.ct@, which declares these same two cells and stops short
  of printing them: printing is what builds a value, so a list field that typechecks and a list
  field that can be evaluated are two different things to hold. The pair below the two of them is
  @listField.ct@, which prints a field holding nothing and a field holding one.
  Two shapes, because they say different things. [Tagged] holds two BARE CONSTANTS, where the
  spine's element type is read from the cells themselves and the field's declared bound is what it
  has to agree with — the two were once spelled in different currencies, the declaration's
  [/Data/Primitive/String] against the join over the literals, and no arrow carried a value spelled
  one way into a slot spelled the other. [Holder] holds two DIFFERING ARMS of a class, one carrying
  a field and one not, which is the same question one level in. @listHeterogeneous.ct@ reaches
  differing arms as an ARGUMENT, where the call bounds them; a field has only its declaration.
  The arm is [Mixed/Labelled] and not @Mixed/Tagged@: a class arm sharing its last name with a data
  type in the same page makes @every(Tagged.., ...)@ ambiguous between the two, which is a question
  about how a relative name resolves and not about what a field may hold.
data(Tagged(name -> String, tags -> /Data/List[$T -> String]))

every(Tagged.., isa= [/Catln/Doc/DShow])

class(Mixed, [Mixed/Plain, Mixed/Labelled(value -> /Data/String)])

data(Holder(items -> /Data/List[$T -> Mixed]))

every(Holder.., isa= [/Catln/Doc/DShow])

# Read back so that the values are built and not only declared, which is the whole of what this
  adds: each field holding a list is destructured and the list's length is what the run checks.
tagCount(t -> Tagged..) -> Integer
tagCount(t= Tagged(name, tags))= tags.length

itemCount(h -> Holder..) -> Integer
itemCount(h= Holder(items))= items.length

main{io -> IO} -> (){IO} =
  #assert(test= tagCount(t= /Tagged(name= "two different", tags= ["x", "y"])) == 2)
  #assert(test= itemCount(h= /Holder(items= [/Mixed/Plain, /Mixed/Labelled(value= "x")])) == 2)
  ()
