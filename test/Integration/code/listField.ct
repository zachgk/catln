import "core"


# A field of a data type may hold a list of a concrete element.
  The tags of a task read out of an Obsidian note are a list of strings rather than the run of text
  they were written as. Nothing in the checked standard library gives a list-typed field to anything
  but a list: the only one there is the [tail] a [/Data/Cons] holds, which is the list itself.
  Written twice over, against the [/Data/List] interface and against the [/Data/ConsList] the
  bracket literal builds, so that a failure says which of the two it is rather than only that a list
  in a field did not work. And written as values declared and never defined, for the reason
  [/Dated] is in @maybeField.ct@.
  A field holding TWO OR MORE does not typecheck — see
  @test/Integration/disabled/listFieldMultiple.ct@, which holds the signature and the boundary. So
  what is checked here is a field with nothing in it and a field with one thing in it, which is as
  far as a list field reaches today.
data(Tagged(name -> String, tags -> /Data/List[$T -> String]))

# Shown as the values they are, with no display type standing in for them, as a task is.
every(Tagged.., isa= [/Catln/Doc/DShow])
every(ConsTagged.., isa= [/Catln/Doc/DShow])

/Tagged(name= "none", tags= [])
/Tagged(name= "one", tags= ["x"])

data(ConsTagged(name -> String, tags -> /Data/ConsList[$T -> String]))

/ConsTagged(name= "none", tags= [])
/ConsTagged(name= "one", tags= ["x"])

# Printed so that the values are evaluated and not only built.
> /Tagged(name= "none", tags= [])
> /Tagged(name= "one", tags= ["x"])
> /ConsTagged(name= "none", tags= [])
> /ConsTagged(name= "one", tags= ["x"])
main{io -> IO}= io.exit(val= 0)
