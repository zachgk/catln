import "core"


# `dataArrow.ct` run, rather than only built.
  The core-less file next to this one is the diagnostic: eleven lines, no standard library, and it
  says whether the chain type-checks and builds a tree. What it cannot say is whether the tree
  REWRITES. A built conversion shows as its source and its destination (`Eval.Common`'s `TCalls`
  renders `A ↦ C` and keeps the tree to itself), so an identity that never fires and a two-hop
  rewrite are the same line in a golden. Evaluating is what tells them apart, and evaluating needs
  the `IO` a core-less page has not got.
  So the same three types are written again here against the library, and the arm matches the VALUE
  `C`: an `A` arriving unrewritten reaches an arm that cannot destructure it, and the assertion
  fails rather than passing on a tree that did nothing. Read `dataArrow.ct` first when both break —
  it is the one with nothing else in it.
data(A)
data(B)
data(C)

A= B

B= C

isC(c -> C) -> /Data/Primitive/Boolean
isC(c= C)= True

main{io -> IO} =
  #assert(test= isC(c= C))
  #assert(test= isC(c= B))
  #assert(test= isC(c= A))
  io
