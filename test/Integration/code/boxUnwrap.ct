import "core"
import "core"



# Repro: a return-position element var must bind from a parameterized argument.
  unwrap(b= Box(v= 5)) should type-check to Integer (the element type), not TopType.
data(Box[$T](v -> $T))

unwrap(b -> Box[$T -> $_T]) -> $_T
unwrap(Box(v))= v

main{io -> IO} =
  #assert(test= unwrap(b= Box(v= 5)) == 5)
  io
