import "core"


# Exercises applied type variables in a return annotation: [$F[$T -> $_B]] is the type the
# bound container [$F] resolves to, with its [$T] parameter rebound to [$_B] — "same shape,
# new element". This is the contract of a mapping function: the compiler cannot know the
# result's element type from [$F] alone (that would claim the element is preserved).

# An element-preserving map: [$_B] equals the input element, so the applied form claims the
# same type the bare [$F] would.
applyInc[$F -> /Data/Functor[$T -> $_A], $A, $B](lst -> $F, fn(v -> $_A) -> $_B) -> $F[$T -> $_B]
applyInc[$F -> /Data/Functor[$T -> $_A]](lst, fn(v))= /Data/fmap(lst= lst, fn(v)= fn(v= v))

incMaybe(m -> /Data/Maybe[$T -> Integer]) -> /Data/Maybe[$T -> Integer] =
  applyInc(lst= m, fn(v)= v + 1)

# An element-CHANGING map (Integer -> String): the applied form claims element [$_B] where
# the bare [$F] would wrongly claim the input's element type.
strMaybe(m -> /Data/Maybe[$T -> Integer]) -> /Data/Maybe[$T -> String] =
  applyInc(lst= m, fn(v)= v.toString)

main{io -> IO} =
  #assert(test= incMaybe(m= /Data/Some(value= 5)) == /Data/Some(value= 6))
  #assert(test= incMaybe(m= /Data/Nothing) == /Data/Nothing)
  #assert(test= strMaybe(m= /Data/Some(value= 5)) == /Data/Some(value= "5"))
  #assert(test= strMaybe(m= /Data/Nothing) == /Data/Nothing)
  io
