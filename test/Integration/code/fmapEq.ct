import "core"


# Exercises the core generic [fmap] (dispatched through the [Functor] class) with concrete
# values from an importing module, comparing results with the generic [operator==]. The law
# properties in stack/core/functor.ct check these shapes generically; this asserts exact
# values on the imported path (identity, increment, and composed increments, over both the
# [ConsList] and [Maybe] instances).
main{io -> IO} =
  # ConsList instance: identity, increment, and two increments composed.
  #assert(test= fmap(lst= /Data/Cons(head= 1, tail= /Data/Nil), fn(v)= v) == /Data/Cons(head= 1, tail= /Data/Nil))
  #assert(test= fmap(lst= /Data/Cons(head= 1, tail= /Data/Nil), fn(v)= v + 1) == /Data/Cons(head= 2, tail= /Data/Nil))
  #assert(test= fmap(lst= fmap(lst= /Data/Cons(head= 1, tail= /Data/Nil), fn(v)= v + 1), fn(v)= v + 1) == /Data/Cons(head= 3, tail= /Data/Nil))
  # Maybe instance: both arms.
  #assert(test= fmap(lst= /Data/Some(value= 1), fn(v)= v + 1) == /Data/Some(value= 2))
  #assert(test= fmap(lst= /Data/Nothing, fn(v)= v + 1) == /Data/Nothing)
  io
