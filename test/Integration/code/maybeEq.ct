import "core"


# Exercises the core [Maybe] type's [Eq] and [Ord] instances from an importing module
# (the in-module #tests in stack/core/maybe.ct cover it in-module; this covers the imported path).
main{io -> IO} =
  # Equality: both arms structural.
  #assert(test= /Data/Some(value= 1) == /Data/Some(value= 1))
  #assert(test= ~(/Data/Some(value= 1) == /Data/Some(value= 2)))
  #assert(test= ~(/Data/Some(value= 1) == /Data/Nothing))
  # Ordering: Nothing before any Some, Somes by their value.
  #assert(test= /Data/Some(value= 1).compareTo(other= /Data/Some(value= 2)).isLess)
  #assert(test= /Data/Some(value= 2).compareTo(other= /Data/Some(value= 2)).isEq)
  #assert(test= /Data/Nothing.compareTo(other= /Data/Some(value= 1)).isLess)
  #assert(test= /Data/Some(value= 1).compareTo(other= /Data/Nothing).isGreater)
  io
