import "core"


# A pattern destructuring a record inside a [/Data/Maybe/Some].
  [sumOf] takes a [/Data/Maybe] of a [Pair] and matches the [Pair] in the same pattern as the
  [/Data/Maybe/Some] holding it. The [Some] spells no element type of its own; its element is what
  its [value] field holds, so it is a [/Data/Maybe] of [Pair]s and inside the declaration.
data(Pair(a -> Integer, b -> Integer))

sumOf(m -> /Data/Maybe[$T -> Pair]) -> Integer
sumOf(m= /Data/Maybe/Nothing)= 0
sumOf(m= /Data/Maybe/Some(value= Pair(a, b)))= a + b

main{io -> IO}= io.println(msg= sumOf(m= /Data/Maybe/Some(value= Pair(a= 1, b= 2))).toString).exit(val= 0)
