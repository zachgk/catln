import "core"


# A result outside the refinement its result type is written with in full, the condition over
  [$out]: [keepOut] returns every [Integer] where [Integer | $out.nonNeg == True] is declared, and
  the predicate evaluated on its result [-2] is false, so the run fails as the result is returned.
keepOut(n -> Integer) -> (Integer | $out.nonNeg == True)= n

main{io -> IO} -> (){IO} =
  _<- exit(val= keepOut(n= -2))
  ()
