import "core"


# A result outside the refinement it is declared within: [keep] returns every [Integer] where a
  [Integer_nonNeg] is declared, and the predicate evaluated on its result [-2] is false, so the
  run fails as the result is returned.
keep(n -> Integer) -> Integer_nonNeg= n

main{io -> IO} -> (){IO} =
  _<- exit(val= keep(n= -2))
  ()
