import "core"
import "llm"


# A page for lcmPrompt.ct to show as [/Llm/lcm] would show it to a model: as it was written, with
  its annotations shown and what is wrong with it noted where it is wrong. It is written to be
  wrong in each way a prompt notes, so it is data of that test rather than a fixture of the suite:
  a fixture's prints are its tests, and these are written to fail.
double(x -> Integer) -> Integer
  # [double] is twice [x].
double(x)= x + x

> double(x= 2)
# A print whose golden is no longer what it prints is shown with the golden it was written with,
  and noted as failing.
> double(x= 3)
  >>> 5
# An annotation that fails is noted with what it failed with. This one asks for the page to be
  shown while it is being shown.
> /Llm/lcmPrompt(input= "And again?")
# A definition the compiler cannot build is noted with what the compiler said.
anyOver[$A](lst -> /Data/List/ConsList[$T -> $_A], fn(v -> $_A) -> Boolean) -> Boolean
anyOver(lst, fn(v))= /Data/List/any(lst= /Data/Functor/fmap(lst= lst, fn(v)= fn(v= v)))

annot(#hint(text -> String))
  # A [#hint] is written for a model as what it says.

/Llm/llmshow(s= #hint(text))= "hint: " ++ text

#hint(text= "double never fails")
prompt(input -> String) -> String
  # [prompt] is what a model is asked about this page: the page, and then [input].
prompt(input)= /Llm/lcmPrompt(input= input)
