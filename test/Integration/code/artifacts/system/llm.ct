import "core"
import "llm"


# Asks the configured model one thing and prints what it answered, or that it did not.
showReply(r -> /Data/Maybe[$T -> String]) -> String
showReply(r= /Data/Maybe/Nothing)= "no reply"
showReply(r= /Data/Maybe/Some(value))= value

main{io -> IO}= io.println(msg= showReply(r= io.llm(input= "Say hi"))).exit(val= 0)
