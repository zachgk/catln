import "core"
import "env"


# Reads one variable that is set and one that is not, and prints what it found of each.
show(v -> /Data/Maybe[$T -> String]) -> String
show(v= /Data/Maybe/Some(value))= "set to " ++ value
show(v= /Data/Maybe/Nothing)= "not set"

main{io -> IO}= io.println(msg= show(v= io.env(name= "CATLN_TEST_VAR"))).println(msg= show(v= io.env(name= "CATLN_UNSET_VAR"))).exit(val= 0)
