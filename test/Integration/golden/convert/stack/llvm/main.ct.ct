import "core"


module(Catln)
  # # LLVM Compiler
    The compiler from Catln to the [LLVM Compiler Infrastructure](https://llvm.org/), written in
    Catln. A build of a runnable function is a call of [llvm] on it, and what it answers with is the
    program as an LLVM module in its textual form (a `.ll` file), built up as a [String].
    The compiler follows the definitions of the program from the function it is given: it compiles
    that function, and each function a compiled one calls, until none is left to compile.
  llvm(c) -> CatlnResult..
    # [llvm] compiles the runnable argument [c] into a [CatlnResult] holding the LLVM module `main.ll`.
      The [/LLVM/LlvmProgram] state is made here, holding [c] as the one function to compile, and
      is dropped again before [llvm] answers: [/LLVM/llvmProgram] answers with the finished module.
  llvm(c)= CatlnResult(files= [BuildFile(path= "main.ll", contents= /Data/Context/unwrap(this= /ContextIn(value= /LLVM/llvmProgram, ctx= (llvmprogram= /LLVM/LlvmProgram(todo= [/LLVM/LlvmTodo(fun= c)], functions= /Data/List/Nil, externs= /Data/List/Nil)))))])
module(LLVM)
  # ## Compiling a program
    A program is compiled in a [Context] holding an [LlvmProgram]: what has been compiled so far,
    and what is still to be compiled. Each function is compiled in turn, in a [Context] holding an
    [LlvmFn] as well: the lines of that one function.
  data(LlvmTodo(fun))
    # An [LlvmTodo] is a function still to be compiled: [fun] is its name, as a value.
  data(LlvmProgram(todo -> /Data/List/ConsList[$T -> LlvmTodo..], functions -> /Data/List/ConsList[$T -> String], externs -> /Data/List/ConsList[$T -> String]))
    # An [LlvmProgram] is a program being compiled: the functions still [todo], the [functions]
      already compiled, each as the text of its definition, and the [externs] they need: the
      functions they declare and the constants they name, each a line of the module. Each list is
      kept the latest first.
  data(LlvmFn(next -> Integer, lines -> /Data/List/ConsList[$T -> String], aux -> LlvmAux..))
    # An [LlvmFn] is a function being compiled: [next] is the number of the next register it
      names, [lines] are the lines of its body written so far, the latest first, and [aux] is what
      else it knows ([LlvmAux]).
  data(LlvmAux(locals -> /Data/List/ConsList[$T -> LlvmLocal..], externs -> /Data/List/ConsList[$T -> String], strings -> Integer))
    # An [LlvmAux] is what a function being compiled knows beside its lines: the values of the
      names it has bound ([locals]), the [externs] it needs, and how many [strings] it has named.
  data(LlvmLocal(name -> String, val -> LlvmVal))
    # An [LlvmLocal] is what the name [name] stands for in the function being compiled.

  class(LlvmVal, [Operand.., LlvmContextVal..])
    # An [LlvmVal] is what a name stands for while a function is compiled: an [Operand], or a
      [Context] whose value is one ([LlvmContextVal]).

  data(LlvmContextVal(value -> Operand..))
    # An [LlvmContextVal] is a [Context] whose value is the operand [value]: what a bind hands its
      continuation. Its states are not compiled.
  data(NoLocal)
    # [NoLocal] is what [llvmFindLocal] answers for a name the function has not bound.

  class(LlvmFound, [Operand.., LlvmContextVal.., NoLocal])
    # An [LlvmFound] is what looking a name up finds: an [LlvmVal], or [NoLocal].

  llvmProgram{LlvmProgram(todo, functions, externs)} -> String{llvmprogram -> LlvmProgram..}
    # [llvmProgram] compiles each function [todo], and the functions they call, and answers with
      the module of them all.
  llvmProgram{LlvmProgram(todo= /Data/List/Nil, functions, externs)}= (llvmModule(functions= functions, externs= externs)){LlvmProgram(todo= /Data/List/Nil, functions= functions, externs= externs)}
  llvmProgram{LlvmProgram(todo= /Data/List/Cons(head= LlvmTodo(fun), tail), functions, externs)} =
    _<- (){LlvmProgram(todo= tail, functions= functions, externs= externs)}
    _<- llvmFunction(fun= fun)
    text<- llvmProgram
    text

  llvmFunction{LlvmProgram(todo, functions, externs)}(fun) -> (){llvmprogram -> LlvmProgram..}
    # [llvmFunction] compiles the function [fun] and adds it to the program's [functions]. It is
      compiled in a fresh [LlvmFn]. [fun] is a name, and the guard asks for the definition it names
      ([\@->]): [body] is then the function the definition is, of its own parameters [ps] with the
      definition's body as its body, and that body is compiled by [llvmOperand]. A name with no
      definition to compile, such as a runtime primitive, is compiled to a TODO.
    # TODO A runtime primitive is compiled where it is called rather than as a function of its own.
    # TODO The [LlvmFn] is replaced by the next function's rather than removed when the function is
    #   done. It needs a state added within a scope and removed when it ends, which is not supported
    #   yet (see [imperative] in @memory/main.ct@).
    # TODO The function is named @main@ and takes no parameters, as only [c] is compiled for now,
    #   and its states (@io@) are not passed to it.
  llvmFunction{LlvmProgram(todo, functions, externs)}(fun) | (fun(..ps) @-> _)@Some(value@body) =
    _<- (){LlvmFn(next= 0, lines= /Data/List/Nil, aux= LlvmAux(locals= /Data/List/Nil, externs= /Data/List/Nil, strings= 0))}
    retOp<- llvmOperand(f(..ps)= body(..ps))
    _<- llvmEmit(line= llvmRet(o= retOp))
    bodyLines<- llvmLines

    fnExterns<- llvmFnExterns
    _<- llvmAddFunction(text= llvmDefine(ret= llvmOperandType(o= retOp), name= "main", body= /Data/List/Cons(head= "entry:", tail= bodyLines)), needs= fnExterns)
    ()
  llvmFunction{LlvmProgram(todo, functions, externs)}(fun) | (fun(..ps) @-> _)@Nothing =
    _<- llvmAddFunction(text= llvmDefine(ret= "i32", name= "main", body= ["entry:", "  ; TODO unsupported: a function with no definition", "  ret i32 0"]), needs= /Data/List/Nil)
    ()

  # ## Compiling an expression
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps) -> _) -> /Context..(value -> Operand.., ctx -> (llvmfn -> LlvmFn..))
    # [llvmOperand] compiles the body of [f], a function of whatever parameters [ps] it has, writing
      the instructions computing it in the function's lines, and answers with the [Operand] holding
      its value. Its arms are chosen by the body of [f]: each compiles one shape of expression, and
      compiles the parts of the shape by [llvmOperand] in turn.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps) -> _) else = (Operand(type= I32, repr= "undef")){LlvmFn(next= next, lines= /Data/List/Cons(head= "  ; TODO unsupported: an expression no arm of llvmOperand compiles", tail= lines), aux= aux)}
    # An expression no other arm compiles is written as a TODO line, and its value is undefined.
    # TODO An expression that cannot be compiled should fail the build rather than be written as a
    #   TODO, once every integration fixture compiles.

  # ### Constants and parameters
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= (k :: Integer))= (Operand(type= I64, repr= k.toString)){LlvmFn(next= next, lines= lines, aux= aux)}
    # An [Integer] is an @i64@ constant, which needs no instruction.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= (k :: Float))= (Operand(type= F64, repr= k.toString)){LlvmFn(next= next, lines= lines, aux= aux)}
    # A [Float] is a @double@ constant.
    # TODO A double that a decimal does not write exactly (@0.1@) is written in LLVM's hexadecimal
    #   form instead.
  llvmOperand{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}(f(${p}, ..ps)= ${p})= (llvmParamValue(found= llvmFindLocal(locals= locals, name= p), name= p)){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= locals, externs= externs, strings= strings))}
    # A parameter [p] of the function is what the function has bound it to, or else the register
      of the same name.
    # TODO A parameter is typed as the function's callers give it, once functions are compiled for
    #   their callers; every parameter is an @i64@ for now.

  # ### Arithmetic and comparisons
    Each operator compiles its two operands by [llvmOperand] in turn, and then the instruction it
    is ([llvmInstr]), given for integers and for floats.
    # TODO An arm written as the call of a helper compiling both operands
    #   (@/ContextIn(value= llvmBinary(op, a(..ps)= a(..ps), b(..ps)= b(..ps)), ctx)@) makes inference
    #   of the core component run past 15 minutes, where these binds take seconds; each arm repeats
    #   them until that is found.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) + b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmArith(int= "add", float= "fadd"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) - b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmArith(int= "sub", float= "fsub"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) * b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmArith(int= "mul", float= "fmul"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) < b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmCompare(int= "icmp slt", float= "fcmp olt"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) > b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmCompare(int= "icmp sgt", float= "fcmp ogt"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) <= b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmCompare(int= "icmp sle", float= "fcmp ole"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) >= b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmCompare(int= "icmp sge", float= "fcmp oge"), l= leftOp, r= rightOp)
    instrOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= a(..ps) == b(..ps)) =
    leftOp<- llvmOperand(f(..ps)= a(..ps))

    rightOp<- llvmOperand(f(..ps)= b(..ps))

    instrOp<- llvmInstr(op= LlvmCompare(int= "icmp eq", float= "fcmp oeq"), l= leftOp, r= rightOp)
    instrOp

  # ### Binds and contexts
    A body running in a context is a chain of binds: each runs an expression in the body's states
    and hands what it answers to a continuation, a function of its own whose parameter destructures
    the [Context] it is given ([/Data/bindap]). The expression is compiled, and so is the body of
    the continuation, found by the guard asking for its definition: its parameters are as given, and
    each name its pattern binds is a read of a field of one of them ([/Catln/FieldOf]). The
    continuation's parameter is bound to a [Context] holding what the expression compiled to, so the
    names it binds read that.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= /Data/bindap(m= /ContextIn(value= e(..ps), ctx= s(..ps)), fn(v)= ${cont}(${argKey}= v, ..cargs))) | (${cont}(..ps) @-> _)@Some(value@contBody) =
    boundOp<- llvmOperand(f(..ps)= e(..ps))
    _<- llvmBindLocal(name= argKey, val= LlvmContextVal(value= boundOp))
    restOp<- llvmOperand(f(..ps)= contBody(..ps))
    restOp
  llvmOperand{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}(f(${p}, ..ps)= /Catln/FieldOf(this= ${p}, field= "value"))= (llvmContextValue(found= llvmFindLocal(locals= locals, name= p))){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= locals, externs= externs, strings= strings))}
    # The value of a [Context] a parameter is bound to.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= /Context(value= a(..ps), ctx= c(..ps))) =
    valueOp<- llvmOperand(f(..ps)= a(..ps))
    valueOp
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= ())= (Operand(type= I32, repr= "0")){LlvmFn(next= next, lines= lines, aux= aux)}
    # The empty tuple, which a body that only does something answers with.
    # TODO The empty tuple is an @i32@ 0, as the value a @main@ returns; it is no value at all.

  # ### Input and output
    [exit] and [println] are calls of C's @exit@ and @puts@, declared once in the module. A message
    is a constant of the module, so only one written in the program is printed for now.
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= /Catln/exit(val= a(..ps))) =
    exitOp<- llvmOperand(f(..ps)= a(..ps))

    narrowOp<- llvmNarrow(o= exitOp)
    _<- llvmExtern(line= "declare void @exit(i32)")
    _<- llvmEmit(line= "  call void @exit(" ++ llvmOperandText(o= narrowOp) ++ ")")
    Operand(type= I32, repr= "0")
  llvmOperand{LlvmFn(next, lines, aux)}(f(..ps)= /Catln/println(msg= (text :: String))) =
    _<- llvmExtern(line= "declare i32 @puts(ptr)")
    strName<- llvmString(text= text)
    _<- llvmEmit(line= "  call i32 @puts(ptr " ++ strName ++ ")")
    Operand(type= I32, repr= "0")

  llvmInstr{LlvmFn(next, lines, aux)}(op -> LlvmBinOp, l -> Operand.., r -> Operand..) -> /Context..(value -> Operand.., ctx -> (llvmfn -> LlvmFn..))
    # [llvmInstr] writes the instruction [op] of the operands [l] and [r] into a fresh register, and
      answers with it: an arithmetic one is of the operands' type, and a comparison is an @i1@.
  llvmInstr{LlvmFn(next, lines, aux)}(op= LlvmArith(int, float), l= Operand(type= I64, repr@lv), r= Operand(type= I64, repr@rv))= (Operand(type= I64, repr= "%r" ++ next.toString)){LlvmFn(next= next + 1, lines= /Data/List/Cons(head= "  %r" ++ next.toString ++ " = " ++ int ++ " i64 " ++ lv ++ ", " ++ rv, tail= lines), aux= aux)}
  llvmInstr{LlvmFn(next, lines, aux)}(op= LlvmArith(int, float), l= Operand(type= F64, repr@lv), r= Operand(type= F64, repr@rv))= (Operand(type= F64, repr= "%r" ++ next.toString)){LlvmFn(next= next + 1, lines= /Data/List/Cons(head= "  %r" ++ next.toString ++ " = " ++ float ++ " double " ++ lv ++ ", " ++ rv, tail= lines), aux= aux)}
  llvmInstr{LlvmFn(next, lines, aux)}(op= LlvmCompare(int, float), l= Operand(type= I64, repr@lv), r= Operand(type= I64, repr@rv))= (Operand(type= I1, repr= "%r" ++ next.toString)){LlvmFn(next= next + 1, lines= /Data/List/Cons(head= "  %r" ++ next.toString ++ " = " ++ int ++ " i64 " ++ lv ++ ", " ++ rv, tail= lines), aux= aux)}
  llvmInstr{LlvmFn(next, lines, aux)}(op= LlvmCompare(int, float), l= Operand(type= F64, repr@lv), r= Operand(type= F64, repr@rv))= (Operand(type= I1, repr= "%r" ++ next.toString)){LlvmFn(next= next + 1, lines= /Data/List/Cons(head= "  %r" ++ next.toString ++ " = " ++ float ++ " double " ++ lv ++ ", " ++ rv, tail= lines), aux= aux)}
  llvmInstr{LlvmFn(next, lines, aux)}(op, l, r) else = (Operand(type= I32, repr= "undef")){LlvmFn(next= next, lines= /Data/List/Cons(head= "  ; TODO unsupported: an operator of operands of different types", tail= lines), aux= aux)}
    # TODO Operands of different types are converted to one type, or refused.

  data(LlvmArith(int -> String, float -> String))
    # An [LlvmArith] is an arithmetic instruction: the one for integers ([int]) and the one for
      floats ([float]).
  data(LlvmCompare(int -> String, float -> String))
    # An [LlvmCompare] is a comparison, written as the instruction and its condition, for integers
      ([int]) and for floats ([float]).

  class(LlvmBinOp, [LlvmArith.., LlvmCompare..])
    # An [LlvmBinOp] is an instruction of two operands.

  # ## Operands
  data(Operand(type -> LlvmType, repr -> String))
    # An [Operand] is a value in LLVM, as an instruction is given it: its [type] and the text it is
      written as ([repr]), a register such as `%r1` or a constant such as `0`.

  class(LlvmType, [I64, F64, I1, I32])
    # An [LlvmType] is the type of an [Operand]: a 64-bit integer ([I64]), a double ([F64]), a
      boolean ([I1]), or a 32-bit integer ([I32]).

  data(I64)
  data(F64)
  data(I1)
  data(I32)

  llvmTypeText(t -> LlvmType) -> String
    # [llvmTypeText] is the type [t] as LLVM writes it.
  llvmTypeText(t= I64)= "i64"
  llvmTypeText(t= F64)= "double"
  llvmTypeText(t= I1)= "i1"
  llvmTypeText(t= I32)= "i32"

  llvmOperandType(o= Operand(type, repr))= llvmTypeText(t= type)
    # [llvmOperandType] is the type of the operand [o], as LLVM writes it.

  llvmRet(o= Operand(type, repr))= "  ret " ++ llvmTypeText(t= type) ++ " " ++ repr
    # [llvmRet] is the instruction returning the operand [o].

  llvmAddFunction{LlvmProgram(todo, functions, externs)}(text -> String, needs -> /Data/List/ConsList[$T -> String])= (){LlvmProgram(todo= todo, functions= /Data/List/Cons(head= text, tail= functions), externs= llvmAddNew(lines= needs, into= externs))}
    # [llvmAddFunction] adds the compiled function [text] to the program, and the externs it
      [needs] that the program does not have yet.

  llvmParamValue(found= Operand(type, repr), name)= Operand(type= type, repr= repr)
    # [llvmParamValue] is the operand a parameter [name] is: what it was [found] bound to, or the
      register of its name.
  llvmParamValue(found= LlvmContextVal(value), name)= value
  llvmParamValue(found= NoLocal, name)= Operand(type= I64, repr= "%" ++ name)

  llvmContextValue(found= LlvmContextVal(value))= value
    # [llvmContextValue] is the value of the [Context] a name was [found] bound to.
  llvmContextValue(found) else = Operand(type= I32, repr= "undef")
    # TODO A field read of a name not bound to a [Context] fails the build.

  llvmNarrow{LlvmFn(next, lines, aux)}(o -> Operand..) -> /Context..(value -> Operand.., ctx -> (llvmfn -> LlvmFn..))
    # [llvmNarrow] is the operand [o] as an @i32@, the exit code C's @exit@ takes.
  llvmNarrow{LlvmFn(next, lines, aux)}(o= Operand(type= I64, repr))= (Operand(type= I32, repr= "%r" ++ next.toString)){LlvmFn(next= next + 1, lines= /Data/List/Cons(head= "  %r" ++ next.toString ++ " = trunc i64 " ++ repr ++ " to i32", tail= lines), aux= aux)}
  llvmNarrow{LlvmFn(next, lines, aux)}(o= Operand(type= I32, repr))= (Operand(type= I32, repr= repr)){LlvmFn(next= next, lines= lines, aux= aux)}
  llvmNarrow{LlvmFn(next, lines, aux)}(o) else = (Operand(type= I32, repr= "undef")){LlvmFn(next= next, lines= /Data/List/Cons(head= "  ; TODO unsupported: an exit code that is not an integer", tail= lines), aux= aux)}

  llvmOperandText(o= Operand(type, repr))= llvmTypeText(t= type) ++ " " ++ repr
    # [llvmOperandText] is the operand [o] as an instruction is given it, its type and its text.

  # ## Compiling a function
  llvmEmit{LlvmFn(next, lines, aux)}(line -> String)= (){LlvmFn(next= next, lines= /Data/List/Cons(head= line, tail= lines), aux= aux)}
    # [llvmEmit] writes the [line] at the end of the function's body.

  llvmLines{LlvmFn(next, lines, aux)}= (llvmReversed(lines= lines, acc= /Data/List/Nil)){LlvmFn(next= next, lines= lines, aux= aux)}
    # [llvmLines] are the lines of the function's body, in the order they were written.

  llvmBindLocal{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}(name -> String, val -> LlvmVal)= (){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= /Data/List/Cons(head= LlvmLocal(name= name, val= val), tail= locals), externs= externs, strings= strings))}
    # [llvmBindLocal] binds the name [name] to [val] in the function being compiled.

  llvmFindLocal(locals -> /Data/List/ConsList[$T -> LlvmLocal..], name -> String) -> LlvmFound
    # [llvmFindLocal] is what [name] is bound to in [locals], the latest binding first, or
      [NoLocal].
  llvmFindLocal(locals= /Data/List/Nil, name)= NoLocal
  llvmFindLocal(locals= /Data/List/Cons(head= LlvmLocal(name@bound, val), tail), name) | bound == name= val
  llvmFindLocal(locals= /Data/List/Cons(head= LlvmLocal(name@bound, val), tail), name) else = llvmFindLocal(locals= tail, name= name)

  llvmExtern{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}(line -> String)= (){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= locals, externs= llvmAddNew(lines= [line], into= externs), strings= strings))}
    # [llvmExtern] notes that the function needs the line [line] of the module, a declaration or a
      constant, once.

  llvmString{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}(text -> String)= ("@.str" ++ strings.toString){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= locals, externs= /Data/List/Cons(head= llvmStringConstant(name= "@.str" ++ strings.toString, text= text), tail= externs), strings= strings + 1))}
    # [llvmString] names a constant holding the [text], a C string, and answers with its name.
    # TODO Strings are named per function, so two functions each naming one name the same constant.

  llvmFnExterns{LlvmFn(next, lines, aux= LlvmAux(locals, externs, strings))}= (externs){LlvmFn(next= next, lines= lines, aux= LlvmAux(locals= locals, externs= externs, strings= strings))}
    # [llvmFnExterns] are the externs the function being compiled needs.

  llvmStringConstant(name -> String, text -> String) -> String
    # [llvmStringConstant] is the line of the module defining the C string [text] as the constant
      [name]: its characters, escaped where a C string in LLVM cannot hold them as they are, and the
      terminating zero.
    # TODO The length counts characters, so a character of more than one byte is miscounted.
  llvmStringConstant(name, text)= name ++ " = private unnamed_addr constant [" ++ (text.length + 1).toString ++ " x i8] c\"" ++ llvmEscaped(text= text) ++ "\\00\""

  llvmEscaped(text -> String) -> String
    # [llvmEscaped] is [text] with each backslash, double quote and newline written as LLVM writes
      them in a string, by their codes.
  llvmEscaped(text)= join(sep= "\\0A", parts= join(sep= "\\22", parts= join(sep= "\\5C", parts= text.split(sep= "\\")).split(sep= "\"")).split(sep= "\n"))

  > llvmEscaped(text= "a\"b")
    >>> a\22b
  llvmAddNew(lines -> /Data/List/ConsList[$T -> String], into -> /Data/List/ConsList[$T -> String]) -> /Data/List/ConsList[$T -> String]
    # [llvmAddNew] adds to [into] each of [lines] it does not hold yet.
  llvmAddNew(lines= /Data/List/Nil, into)= into
  llvmAddNew(lines= /Data/List/Cons(head, tail), into) | llvmHas(lines= into, line= head)= llvmAddNew(lines= tail, into= into)
  llvmAddNew(lines= /Data/List/Cons(head, tail), into) else = llvmAddNew(lines= tail, into= /Data/List/Cons(head= head, tail= into))

  llvmHas(lines -> /Data/List/ConsList[$T -> String], line -> String) -> Boolean
    # [llvmHas] is whether [lines] holds [line].
  llvmHas(lines= /Data/List/Nil, line)= False
  llvmHas(lines= /Data/List/Cons(head, tail), line) | head == line= True
  llvmHas(lines= /Data/List/Cons(head, tail), line) else = llvmHas(lines= tail, line= line)

  llvmReversed(lines -> /Data/List/ConsList[$T -> String], acc -> /Data/List/ConsList[$T -> String]) -> /Data/List/ConsList[$T -> String]
    # [llvmReversed] is [lines] backwards, in front of [acc].
  llvmReversed(lines= /Data/List/Nil, acc)= acc
  llvmReversed(lines= /Data/List/Cons(head, tail), acc)= llvmReversed(lines= tail, acc= /Data/List/Cons(head= head, tail= acc))

  > join(sep= ",", parts= llvmReversed(lines= ["c", "b", "a"], acc= /Data/List/Nil))
    >>> a,b,c
  # ## Writing a module
    The parts of a module, each written as the text it is in a `.ll` file.
  llvmModule(functions -> /Data/List/ConsList[$T -> String], externs -> /Data/List/ConsList[$T -> String]) -> String
    # [llvmModule] is the module of the compiled [functions] and the [externs] they need, each given
      the latest first.
  llvmModule(functions, externs= /Data/List/Nil)= "; ModuleID = 'catln'\n\n" ++ join(sep= "\n", parts= llvmReversed(lines= functions, acc= /Data/List/Nil))
  llvmModule(functions, externs= /Data/List/Cons(head, tail))= "; ModuleID = 'catln'\n\n" ++ join(sep= "\n", parts= llvmReversed(lines= /Data/List/Cons(head= head, tail= tail), acc= /Data/List/Nil)) ++ "\n\n" ++ join(sep= "\n", parts= llvmReversed(lines= functions, acc= /Data/List/Nil))

  llvmDefine(ret -> String, name -> String, body -> /Data/List/ConsList[$T -> String]) -> String
    # [llvmDefine] is the definition of the function [name], taking no arguments and returning a
      [ret]. Its [body] is the lines of its basic blocks, each label and instruction written as it
      appears in the function.
  llvmDefine(ret, name, body)= join(sep= "\n", parts= /Data/List/Cons(head= "define " ++ ret ++ " @" ++ name ++ "() {", tail= body)) ++ "\n}\n"

  > llvmModule(functions= [llvmDefine(ret= "i32", name= "main", body= ["entry:", "  ret i32 0"])], externs= /Data/List/Nil)
    >>> ; ModuleID = 'catln'
    >>>
    >>> define i32 @main() {
    >>> entry:
    >>>   ret i32 0
    >>> }
    >>>
module(LLVM/Example)
  # ## Compiling functions
    What [llvm] compiles a function to, read as the text of the module it writes ([llvmText]).
  llvmText(c) -> String
    # [llvmText] is the text of the module [llvm] compiles [c] to.
  llvmText(c)= llvmBuiltText(result= /Catln/llvm(c= c))

  llvmBuiltText(result= CatlnResult(files= /Data/List/Cons(head= BuildFile(path, contents), tail)))= contents

  llvmExArith(x -> Integer) -> Integer
    # [llvmExArith] is arithmetic of a parameter and constants.
  llvmExArith(x)= 2 * 3 + x

  > llvmText(c= /LLVM/Example/llvmExArith)
    >>> ; ModuleID = 'catln'
    >>>
    >>> define i64 @main() {
    >>> entry:
    >>>   %r0 = mul i64 2, 3
    >>>   %r1 = add i64 %r0, %x
    >>>   ret i64 %r1
    >>> }
    >>>
  llvmExFloats(x -> Float) -> Float
    # [llvmExFloats] is arithmetic of [Float] constants.
  llvmExFloats(x)= 1.5 * 2.0 - 0.5

  > llvmText(c= /LLVM/Example/llvmExFloats)
    >>> ; ModuleID = 'catln'
    >>>
    >>> define double @main() {
    >>> entry:
    >>>   %r0 = fmul double 1.5, 2.0
    >>>   %r1 = fsub double %r0, 0.5
    >>>   ret double %r1
    >>> }
    >>>
  llvmExLess(x -> Integer) -> Boolean
    # [llvmExLess] is a comparison, an @i1@.
  llvmExLess(x)= x < 3

  > llvmText(c= /LLVM/Example/llvmExLess)
    >>> ; ModuleID = 'catln'
    >>>
    >>> define i1 @main() {
    >>> entry:
    >>>   %r0 = icmp slt i64 %x, 3
    >>>   ret i1 %r0
    >>> }
    >>>
  llvmExGreet{io -> IO} -> (){IO}
    # [llvmExGreet] prints a line and exits, compiled as a chain of binds.
  llvmExGreet{io -> IO} =
    _<- println(msg= "hello")
    _<- exit(val= 3)
    ()

  > llvmText(c= /LLVM/Example/llvmExGreet)
    >>> ; ModuleID = 'catln'
    >>>
    >>> declare void @exit(i32)
    >>> @.str0 = private unnamed_addr constant [6 x i8] c"hello\00"
    >>> declare i32 @puts(ptr)
    >>>
    >>> define i32 @main() {
    >>> entry:
    >>>   call i32 @puts(ptr @.str0)
    >>>   %r0 = trunc i64 3 to i32
    >>>   call void @exit(i32 %r0)
    >>>   ret i32 0
    >>> }
    >>>
