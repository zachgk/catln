import "core"
import "core"


# Exercises the bind operator ([<-]) routing through [bindap]'s [ap] arm. The continuation consumes
# the whole [Maybe] rather than its element, so neither the [fmap] nor the [mmap] arm can accept it.
apBind(m -> /Data/Maybe[$T -> Integer]) -> Integer =
  x<- m

  orZero(o= x)

orZero(o -> /Data/Maybe[$T -> Integer]) -> Integer
orZero(o= /Data/Maybe/Some(value))= value
orZero(o= /Data/Maybe/Nothing)= 0

main{io -> IO} =
  #assert(test= apBind(m= /Data/Maybe/Some(value= 5)) == 5)
  #assert(test= apBind(m= /Data/Maybe/Nothing) == 0)
  io
