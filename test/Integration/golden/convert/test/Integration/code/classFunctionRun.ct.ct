import "core"


# `classFunction.ct` run, rather than only built.
  A member of a class of functions is the function's name alone, and is applied as [applyAdjuster] applies
  [f]: through the member's own arrows, chosen by which member [f] is when it runs. The members answer
  differently, so an application that reached the wrong member, or none, fails an assert.
class(Adjuster)

(_ -> Adjuster)(n -> /Data/Primitive/Integer) -> /Data/Primitive/Integer

every(inc, isa= [/Adjuster])

inc(n -> /Data/Primitive/Integer) -> /Data/Primitive/Integer
inc(n)= n + 1

every(double, isa= [/Adjuster])

double(n -> /Data/Primitive/Integer) -> /Data/Primitive/Integer
double(n)= n * 2

applyAdjuster(f -> Adjuster, n -> /Data/Primitive/Integer) -> /Data/Primitive/Integer
applyAdjuster(f, n)= f(n= n)

pick(b -> /Data/Primitive/Boolean) -> Adjuster
pick(b= True)= inc
pick(b= False)= double

main{io -> IO} -> (){IO} =
  #assert(test= applyAdjuster(f= inc, n= 5) == 6)
  #assert(test= applyAdjuster(f= double, n= 5) == 10)
  #assert(test= applyAdjuster(f= pick(b= True), n= 5) == 6)
  #assert(test= applyAdjuster(f= pick(b= False), n= 5) == 10)
  ()
