/Data/Note/Page(/title= "Planner")
  # A vault not running the Day Planner plans nothing, however its daily notes are set: a bullet writing a time is writing, and a checkbox writing one is a checkbox with no block of the day.
    
    - 12:00 - 13:00 Lunch
  /Data/Note/Task/Simple(/contents= "09:00 - 10:30 Write the report", /state= /Data/Primitive/False, /time= /Data/Maybe/Nothing, /plannedDay= /Data/Maybe/Nothing)
