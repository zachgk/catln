import "core"


/Data/Note/Page(/title= "Old")
  # A note in a folder of the vault, so a query may ask where a task was written.
  /Data/Note/Task/Obsidian(/contents= "Archive the plan \9989 2025-12-20", /symbol= "x", /statusType= /Data/Note/StatusType/Done, /description= "Archive the plan", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusDate\":\"2025-12-20\",\"statusName\":\"Done\"}")
  /Data/Note/Task/Obsidian(/contents= "Review the archive \128197 2025-12-31", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Review the archive", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Some(/value= "2025-12-31"), /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Todo\"}")
