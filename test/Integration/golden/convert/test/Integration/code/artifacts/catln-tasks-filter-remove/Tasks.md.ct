/Data/Note/Page(/title= "Tasks")
  # This vault asks that every task carry a word, and that the word be taken out of what the task says.
  /Data/Note/Task/Obsidian(/contents= "#task Ship it", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Ship it", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Todo\"}", /time= /Data/Maybe/Nothing, /plannedDay= /Data/Maybe/Nothing)
  /Data/Note/Task/Obsidian(/contents= "Ship it #task", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Ship it", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Todo\"}", /time= /Data/Maybe/Nothing, /plannedDay= /Data/Maybe/Nothing)

  /Data/Note/Task/Simple(/contents= "Buy milk", /state= /Data/Primitive/False, /time= /Data/Maybe/Nothing, /plannedDay= /Data/Maybe/Nothing)
