import "core"


/Data/Note/Page(/title= "Tasks")
  # This vault is set to the dataview notation, and names a status of its own.
  /Data/Note/Task/Obsidian(/contents= "Ship it [due:: 2026-01-04] [priority:: high] [repeat:: every week]", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Ship it", /priority= /Data/Note/Priority/High, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Some(/value= "2026-01-04"), /recurrence= /Data/Maybe/Some(/value= "every week"), /rest= "{\"statusName\":\"Todo\"}")
  /Data/Note/Task/Obsidian(/contents= "Ship it between parentheses (due:: 2026-01-04)", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Ship it between parentheses", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Some(/value= "2026-01-04"), /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Todo\"}")
  /Data/Note/Task/Obsidian(/contents= "Named (id:: abc)", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "Named", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"id\":\"abc\",\"statusName\":\"Todo\"}")
  /Data/Note/Task/Obsidian(/contents= "An emoji mark in a dataview vault is writing \128197 2026-01-04", /symbol= " ", /statusType= /Data/Note/StatusType/Todo, /description= "An emoji mark in a dataview vault is writing \128197 2026-01-04", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Todo\"}")
  /Data/Note/Task/Obsidian(/contents= "A status the vault named", /symbol= "?", /statusType= /Data/Note/StatusType/OnHold, /description= "A status the vault named", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"Question\"}")
  /Data/Note/Task/Obsidian(/contents= "A symbol the vault did not name is still something to do", /symbol= "!", /statusType= /Data/Note/StatusType/Todo, /description= "A symbol the vault did not name is still something to do", /priority= /Data/Note/Priority/None, /start= /Data/Maybe/Nothing, /scheduled= /Data/Maybe/Nothing, /due= /Data/Maybe/Nothing, /recurrence= /Data/Maybe/Nothing, /rest= "{\"statusName\":\"!\"}")
