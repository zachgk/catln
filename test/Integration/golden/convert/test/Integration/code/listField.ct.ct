import "core"


# A field of a data type may hold a list of a concrete element.
  The tags of a task read out of an Obsidian note are a list of strings rather than the run of text
  they were written as. Nothing in the checked standard library gives a list-typed field to anything
  but a list: the only one there is the [tail] a [/Data/List/Cons] holds, which is the list itself.
  Written twice over, against the [/Data/List] interface and against the [/Data/List/ConsList] the
  bracket literal builds, so that a failure says which of the two it is rather than only that a list
  in a field did not work. And written as values declared and never defined, for the reason
  [/Dated] is in @maybeField.ct@.
  What is checked here is a field with nothing in it and a field with one thing in it. A field
  holding TWO OR MORE is @listFieldMultiple.ct@, and one whose elements carry a field of their own,
  two lists further down, is @listFieldNested.ct@ — both of which this file's cases are the floor
  of, since a rule that reads a spine's element type from its head alone passes here and fails
  there.
data(Tagged(name -> String, tags -> /Data/List[$T -> String]))

# Shown as the values they are, with no display type standing in for them, as a task is.
every(Tagged.., isa= [/Catln/Doc/DShow])
every(ConsTagged.., isa= [/Catln/Doc/DShow])

/Tagged(name= "none", tags= [])
/Tagged(name= "one", tags= ["x"])

data(ConsTagged(name -> String, tags -> /Data/List/ConsList[$T -> String]))

/ConsTagged(name= "none", tags= [])
/ConsTagged(name= "one", tags= ["x"])

# Read back so that the values are evaluated and not only built: a field holding a list is
  destructured and the list's length is what the run checks.
tagCount(t -> Tagged..) -> Integer
tagCount(t= Tagged(name, tags))= tags.length

consTagCount(t -> ConsTagged..) -> Integer
consTagCount(t= ConsTagged(name, tags))= tags.length

main{io -> IO} =
  #assert(test= tagCount(t= /Tagged(name= "none", tags= [])) == 0)
  #assert(test= tagCount(t= /Tagged(name= "one", tags= ["x"])) == 1)
  #assert(test= consTagCount(t= /ConsTagged(name= "none", tags= [])) == 0)
  #assert(test= consTagCount(t= /ConsTagged(name= "one", tags= ["x"])) == 1)
  io
