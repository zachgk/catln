import "core"
import "core"


# Repro: a destructured element binding in a definition pattern must inherit the element
  bound declared on the function's argument. This uses a local `Boxed` class with a member
  `unbox` instead of the stdlib `Eq` class (which is no longer an effective class — equality
  is now provided by standalone per-type `operator==` declarations, so a `$A -> Eq` bound does
  not actually gate any operation). `bothUnbox` is declared over Pair[$A -> Boxed, $B -> Boxed],
  so the destructured `first` binding `f` should inherit the `Boxed` bound and `unbox(f)` should
  type-check and dispatch. Concrete construction/extraction already works; this isolates the
  parametric case where the element's only bound comes from the declaration.
class(Boxed)

unbox(b -> /Boxed) -> /Data/Primitive/Integer

every(/Data/Primitive/Integer, isa= [/Boxed])

unbox(b -> /Data/Primitive/Integer)= b

data(Pair[$A, $B](first -> $A, second -> $B))

bothUnbox(p -> Pair[$A -> /Boxed, $B -> /Boxed](first, second)) -> /Data/Primitive/Integer
bothUnbox(p= Pair(first@f, second@s))= unbox(b= f)

main{io -> IO} =
  #assert(test= bothUnbox(p= Pair(first= 5, second= 7)) == 5)
  io
