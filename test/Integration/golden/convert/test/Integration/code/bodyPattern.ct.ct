annot(#noCore)

#noCore
# Arms chosen by the body of the function they are given.
  A higher-order argument written with a body (@f(a)= Zr@) in an arm's object is a pattern over the
  definition of the function given for it, not over a value: [kind] has an arm for each shape a
  function's body may have. A name written with a type (@(c :: Integer)@) binds the constant the body
  holds, and a name applied to the function's parameters (@g(a)@) binds the function that part of the
  body is. A parameter of the function may be named for the pattern (@a\@x@), as [same] does, to keep
  it apart from the arm's own. The last arm recurses into the parts it binds.
  No arm covers every function, so the declaration is [#invalid]. Written without the core library,
  so that when a compiler change breaks it there are a few lines to read rather than a standard
  library. `bodyPatternRun.ct` runs the same shapes.
module(Data/Primitive)
  data(Integer)
module(Catln)
  annot(#invalid)

data(In)
data(Zr)
data(Lit)

class(R, [In, Zr, Lit])

plus(l -> R, r -> R) -> R
plus(l, r)= r

kind(a -> In, f(a -> In) -> R) -> R
  #invalid
kind(a, f(a)= Zr)= Zr
kind(a, f(a@x)= x)= a
kind(a, f(a)= (c :: Integer))= Lit
kind(a, f(a)= plus(l= g(a), r= h(a)))= plus(l= kind(a= a, f(a)= g(a= a)), r= kind(a= a, f(a)= h(a= a)))

same= kind(a= In, f(a)= a)

zero= kind(a= In, f(a)= Zr)

literal= kind(a= In, f(a)= 3)

parts= kind(a= In, f(a)= plus(l= Zr, r= a))
