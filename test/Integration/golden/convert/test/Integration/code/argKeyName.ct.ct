import "core"


# An argument named the same as a function of the module it is declared in.
  [power] takes an argument called [exp], and [exp] is also a method declared beside it. A call's
  arguments are keyed by the names they are given, so `2.power(exp= 3)` fills the argument [exp]
  whatever else is called that — the method is not what the key refers to. [power] is a runtime
  primitive, which reads its argument by the key @/exp@, so a key named after the method instead is
  an argument the primitive never finds.
module(Lib)
  :Integer.exp -> Integer
  :Integer.exp= this * 10

  :Integer.power(exp -> Integer) -> Integer
    #runtime("intPow")

main{io -> IO} -> (){IO} =
  _<- println(msg= 2.power(exp= 3).toString)
  _<- exit(val= 0)
  ()
