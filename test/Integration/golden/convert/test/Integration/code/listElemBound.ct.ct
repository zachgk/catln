import "core"
import "core"


# A list whose element parameter is bounded by a CONCRETE DATA TYPE, destructured.
  Every list in the checked standard library bounds its element by a CLASS — [/Data/ToString],
  [/Data/Algebra/Ord], [/Data/Algebra/Eq] — so a bound naming a data type directly was never
  exercised by it, and the two read differently. A bare data name is the argument-less value
  ([Item] alone) and the spread is every value of the type ([Item..]), the two being disjoint; a
  bound over the elements of a list means the latter, so it is written so. The class expansion once
  rewrote a bare bound into its field form on one side of a comparison and not the other — one
  type written two ways, which meets at nothing — and a bound written bare passed only through
  that. A class has no fields, so it reads the same both ways and never showed the difference.
  Written over the [/Data/List] interface and over the [/Data/List/ConsList] the bracket literal
  builds, as @listField.ct@ is, so that a failure says which of the two it is.
data(Item(n -> /Data/Primitive/Integer))

countAll(ks -> /Data/List[$T -> Item..]) -> /Data/Primitive/Integer
countAll(ks= /Data/List/Nil)= 0
countAll(ks= /Data/List/Cons(head, tail))= 1 + countAll(ks= tail)

countCons(ks -> /Data/List/ConsList[$T -> Item..]) -> /Data/Primitive/Integer
countCons(ks= /Data/List/Nil)= 0
countCons(ks= /Data/List/Cons(head, tail))= 1 + countCons(ks= tail)

> countAll(ks= [])
  >>> 0
> countAll(ks= [/Item(n= 1), /Item(n= 2)])
  >>> 2
> countCons(ks= [])
  >>> 0
> countCons(ks= [/Item(n= 1), /Item(n= 2)])
  >>> 2
# A FIELDLESS data bound has nothing to restore, so it reads the same both ways and went through
  even while the bound above did not. Held beside it so a regression says which of the two broke.
data(Bare)

countBare(ks -> /Data/List[$T -> Bare]) -> /Data/Primitive/Integer
countBare(ks= /Data/List/Nil)= 0
countBare(ks= /Data/List/Cons(head, tail))= 1 + countBare(ks= tail)

> countBare(ks= [/Bare, /Bare])
  >>> 2
main{io -> IO}= io.exit(val= 0)
