import "core"
import "core"


# A list of two or more whose elements CARRY A FIELD, sitting under two further lists.
  The deep face of @listFieldMultiple.ct@: there the element bound has to reach a nested cons, and
  here it has to reach that cons's element as well. The shape needs all three at once — three
  levels of list, two or more in the innermost, and elements which carry a field — and each of the
  three on its own was fine long before the combination was, so it is worth holding all three
  together rather than trusting the pieces.
  Written as the JSON value type because that is where the shape was found: an object of members, a
  member holding an object of members, a member holding an array of numbers. What @json/json.ct@
  can carry was bounded by this and by nothing about JSON, so a JSON file nested three deep is read
  as a value exactly when this passes.
  Not a question of the class-typed field: @Num@ is declared as the concrete
  [/Data/Primitive/Float], and declaring it as the [/Data/Primitive/Number] class behaved the same
  both before and after, so the narrowing of a class member to one of its arms is not what this is
  about. What it was about is a spine reading its element type from its head alone — the first
  cell's field settled and the second stayed open, epoch after epoch, until the constraint loop hit
  its limit having had the right answer from the first epoch.
class(Json, [Json/Null, Json/Num(value -> /Data/Primitive/Float), Json/Arr(entries -> /Data/List[$T -> Json]), Json/Obj(entries -> /Data/List[$T -> Json/Member])])

data(Json/Member(key -> String, value -> Json))

every(Json, isa= [/Catln/Doc/DShow])
every(Json/Member.., isa= [/Catln/Doc/DShow])

# The shape: three levels of list, two field-carrying elements in the innermost.
/Nested= Json/Obj(entries= [Json/Member(key= "author", value= Json/Obj(entries= [Json/Member(key= "years", value= Json/Arr(entries= [Json/Num(value= 2020.0), Json/Num(value= 2026.0)]))]))])

# Printed so that the value is evaluated and not only built.
> /Nested
main{io -> IO}= io.exit(val= 0)
