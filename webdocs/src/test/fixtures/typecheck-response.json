eds": [], "tag": "PredsAnd"}, "ptVars": []}, "tag": "PredClass"}, "tag": "PredsOne"}, {}, []]}]]}, "tag": "PredClass"}, "tag": "PredsOne"}, {}, []]}]], {"paPreds": [], "tag": "PredsAnd"}, {"ptArgLb": true, "ptArgUb": true}]]}, "utTop": null}], "Represents calls which have a display of their own, as [DShow] represents values which do.\nA call is not a value, and that is the whole reason this is a second class rather than more\nmembers of the first. What [DShow] answers about is something the program computed and is\nholding; what this answers about is the computing \u2014 which arguments went in, what came back,\nand, where it matters, what happened in between. A mapping over a list is the case the first\nof these was written for: the list it returns is a [DShow] already and says nothing a reader\ncould not see, while which element became which is the whole of what the call did.\nOpen, as [DShow] is, and joined the same way \u2014 by an arm of [/Catln/Doc/dshowCall] written\nbeside the function, not by an [every]. See [/Data/List] in @core/list-webdocs.ct@."]}], "prgmObjMap": {"omItems": {"/id": {"omiDecls": [], "omiDefs": [{"oaAnnots": [], "oaArr": [{"tag": "Value", "veMeta": {"getMetaDat": null, "getMetaId": "eef8918f-18de-5d24-aa2d-f33d85eeecae", "getMetaPos": [{"col": 8, "line": 8, "name": "/home/claude/projects/catln/test/Integration/code/id.ct"}, {"col": 9, "line": 8, "name": "/home/claude/projects/catln/test/Integration/code/id.ct"}], "getMetaType": {"tag": "UnionType", "utConsts": [], "utLeafs": {"/x": [[[], [], {"paPreds": [], "tag": "PredsAnd"}, {"ptArgLb": true, "ptArgUb": true}]]}, "utTop": null}}, "veName": "/x"}, {"getMetaDat": {"contents": [[{"ptArgMode": {"ptArgLb": true, "ptArgUb": true}, "ptArgs": [], "ptName": "/x", "ptPreds": {"paPreds": [], "tag": "PredsAnd"}, "ptVars": []}, {"contents": [[{"tag": "TypeVar", "tvAux": {"tag": "TVArg", "tvaName": {"pkArgs": [], "pkName": "/x", "pkVars": []}}, "tvInner": {"tag": "UnionType", "utConsts": [], "utLeafs