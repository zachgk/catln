import "core/bool.ct"
import "core/cons.ct"
import "core/data.ct"
import "core/maybe.ct"
import "core/ord.ct"
import "core/string.ct"
import "core/parse.ct"


module(Data/Time)
  # # Dates and times
    A [Date] is a day of the proleptic Gregorian calendar and a [TimeOfDay] is a minute within a
    day. Both are data rather than text: a day written as @2026-01-03@ is read into a [Date] once,
    where it is written, and from then on is a value with an order and an arithmetic.
    There is no zone here and no instant. A day planned in a note is the day the note names wherever
    it is read, and a time of day is the time on the reader's own clock, so neither is pinned to a
    place on the earth. An instant would be a [Date], a [TimeOfDay] and a zone, and is left until
    something needs one.
  # ## Days
  data(Date(year -> Integer, month -> Integer, day -> Integer))
    # A [Date] is the day [day] of the month [month] (1 to 12) of the year [year], counting years
      as the Gregorian calendar does backwards as well as forwards. A [Date] built directly is not
      checked; [parseDate] and the arithmetic below make only days that exist.

  isLeapYear(year -> Integer) -> Boolean
    # [isLeapYear] is whether [year] has a 29th of February: every fourth year, except every
      hundredth, except every four hundredth.
  isLeapYear(year)= year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

  > isLeapYear(year= 2024)
    >>> True
  > isLeapYear(year= 1900)
    >>> False
  > isLeapYear(year= 2000)
    >>> True
  > isLeapYear(year= 2026)
    >>> False
  daysInMonth(year -> Integer, month -> Integer) -> Integer
    # [daysInMonth] is how many days the month [month] of the year [year] has.
  daysInMonth(year, month) | month == 2= februaryDays(leap= isLeapYear(year= year))
  daysInMonth(year, month) | month == 4 || month == 6 || month == 9 || month == 11= 30
  daysInMonth(year, month) else = 31

  februaryDays(leap -> Boolean) -> Integer
    # [februaryDays] is how many days February has in a leap year and in any other.
  februaryDays(leap= True)= 29
  februaryDays(leap= False)= 28

  > daysInMonth(year= 2024, month= 2)
    >>> 29
  > daysInMonth(year= 2026, month= 2)
    >>> 28
  > daysInMonth(year= 2026, month= 4)
    >>> 30
  > daysInMonth(year= 2026, month= 12)
    >>> 31
  # ## Counting days
    A day is counted as how many days it is after the 1st of January 1970, which turns adding days
    and comparing days into adding and comparing numbers. The count and its reverse are Howard
    Hinnant's: the year is started in March so that the leap day falls at its end, and is counted in
    eras of 400 years, which every Gregorian calendar repeats exactly.
  :Date...daysSinceEpoch -> Integer
    # [daysSinceEpoch] is how many days the date is after the 1st of January 1970, and negative for
      a day before it.
  :Date(year, month, day).daysSinceEpoch =
    fromMarch(y -> Integer, mp -> Integer) -> Integer
    fromMarch(y, mp)= fromEra(era= y // 400, yoe= y - (y // 400) * 400, doy= (153 * mp + 2) // 5 + day - 1)

    fromEra(era -> Integer, yoe -> Integer, doy -> Integer) -> Integer
    fromEra(era, yoe, doy)= era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468

    startOfYear(y -> Integer, m -> Integer) -> Integer
    startOfYear(y, m) | m <= 2= fromMarch(y= y - 1, mp= m + 9)
    startOfYear(y, m) else = fromMarch(y= y, mp= m - 3)
    startOfYear(y= year, m= month)

  > Date(year= 1970, month= 1, day= 1).daysSinceEpoch
    >>> 0
  > Date(year= 2026, month= 1, day= 3).daysSinceEpoch
    >>> 20456
  > Date(year= 1969, month= 12, day= 31).daysSinceEpoch
    >>> -1
  fromDaysSinceEpoch(days -> Integer) -> Date..
    # [fromDaysSinceEpoch] is the date [days] days after the 1st of January 1970, the reverse of
      [daysSinceEpoch].
  fromDaysSinceEpoch(days) =
    ofEra(era -> Integer, doe -> Integer) -> Date..
    ofEra(era, doe)= ofYear(era= era, doe= doe, yoe= (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365)

    ofYear(era -> Integer, doe -> Integer, yoe -> Integer) -> Date..
    ofYear(era, doe, yoe)= ofDay(y= yoe + era * 400, doy= doe - (365 * yoe + yoe // 4 - yoe // 100))

    ofDay(y -> Integer, doy -> Integer) -> Date..
    ofDay(y, doy)= ofMonth(y= y, doy= doy, mp= (5 * doy + 2) // 153)

    ofMonth(y -> Integer, doy -> Integer, mp -> Integer) -> Date..
    ofMonth(y, doy, mp) | mp < 10= Date(year= y, month= mp + 3, day= doy - (153 * mp + 2) // 5 + 1)
    ofMonth(y, doy, mp) else = Date(year= y + 1, month= mp - 9, day= doy - (153 * mp + 2) // 5 + 1)

    ofEra(era= (days + 719468) // 146097, doe= (days + 719468) % 146097)

  > fromDaysSinceEpoch(days= 20456)
    >>> 2026-01-03
  > fromDaysSinceEpoch(days= 0 - 1)
    >>> 1969-12-31
  > fromDaysSinceEpoch(days= 19782)
    >>> 2024-02-29
  :Date...addDays(n -> Integer) -> Date..
    # [addDays] is the date [n] days after this one, or before it for a negative [n], carrying
      across the ends of months and years.
  :Date(year, month, day).addDays(n)= fromDaysSinceEpoch(days= Date(year= year, month= month, day= day).daysSinceEpoch + n)

  > Date(year= 2026, month= 1, day= 31).addDays(n= 1)
    >>> 2026-02-01
  > Date(year= 2024, month= 2, day= 28).addDays(n= 1)
    >>> 2024-02-29
  > Date(year= 2026, month= 1, day= 1).addDays(n= 0 - 1)
    >>> 2025-12-31
  :Date...weekday -> Integer
    # [weekday] is the day of the week the date falls on, numbered as ISO 8601 numbers them: 1 for
      Monday through 7 for Sunday. The 1st of January 1970 was a Thursday.
  :Date(year, month, day).weekday= (Date(year= year, month= month, day= day).daysSinceEpoch + 3) % 7 + 1

  > Date(year= 2026, month= 1, day= 3).weekday
    >>> 6
  > Date(year= 1970, month= 1, day= 1).weekday
    >>> 4
  # ## Writing and reading days
  padded(n -> Integer, width -> Integer) -> String
    # [padded] writes [n] in decimal with zeros before it up to [width] digits.
  padded(n, width) | n.toString.length < width= "0" ++ padded(n= n, width= width - 1)
  padded(n, width) else = n.toString

  every(Date.., isa= [/Data/ToString])

  :Date(year, month, day).toString= padded(n= year, width= 4) ++ "-" ++ padded(n= month, width= 2) ++ "-" ++ padded(n= day, width= 2)
    # A [Date] is written as ISO 8601 writes it: @YYYY-MM-DD@.

  > Date(year= 2026, month= 1, day= 3)
    >>> 2026-01-03
  natural(s -> String) -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr]
    # [natural] reads [s] as a whole number written in decimal digits alone, with no sign, or fails
      with why it is not one.
  natural(s= String/Text(chars= /Data/List/Nil))= /Data/Result/Fail(err= /Data/IntegerParseErr/NoText)
  natural(s= String/Text(chars= /Data/List/Cons(head, tail)))= /Data/digitsValue(cs= /Data/List/Cons(head= head, tail= tail), base= 10, sign= 1, acc= 0, at= 0)

  > natural(s= "042")
    >>> 42
  > natural(s= "+42")
    >>> error: '+' at 0 is not a digit of base 10
  > natural(s= "")
    >>> error: there is no number in an empty string
  class(DateParseErr, [DateParseErr/BadShape(text -> String), DateParseErr/BadPart(part -> String, cause -> /Data/IntegerParseErr), DateParseErr/MonthOutOfRange(month -> Integer), DateParseErr/NoSuchDay(year -> Integer, month -> Integer, day -> Integer)], isa= [/Data/Err])
    # [DateParseErr] is why a string is no [Date]: it is not written @YYYY-MM-DD@ ([BadShape]), the
      year, month or day written is not a number ([BadPart]), the month is not one of the twelve
      ([MonthOutOfRange]), or the day is not one the month has ([NoSuchDay]).

  parseDate(s -> String) -> /Data/Result[$T -> Date.., $E -> DateParseErr]
    # [parseDate] reads a day written as ISO 8601 writes one, @YYYY-MM-DD@, with every digit there,
      or fails with why it is not one. A day that does not exist, such as the 30th of February, is
      not one.
  parseDate(s) | s.length == 10 && s.at(index= 4) == /Data/Maybe/Some(value= '-') && s.at(index= 7) == /Data/Maybe/Some(value= '-')= dateOf(y= natural(s= s.take(n= 4)), m= natural(s= s.slice(start= 5, end= 7)), d= natural(s= s.drop(n= 8)))
  parseDate(s) else = /Data/Result/Fail(err= DateParseErr/BadShape(text= s))

  dateOf(y -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr], m -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr], d -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr]) -> /Data/Result[$T -> Date.., $E -> DateParseErr]
    # [dateOf] is the date of the year, month and day read, where all three were read and name a
      month there is.
  dateOf(y= /Data/Result/Ok(value@yv), m= /Data/Result/Ok(value@mv), d= /Data/Result/Ok(value@dv)) | mv >= 1 && mv <= 12= dayOf(year= yv, month= mv, day= dv)
  dateOf(y= /Data/Result/Ok(value@yv), m= /Data/Result/Ok(value@mv), d= /Data/Result/Ok(value@dv)) else = /Data/Result/Fail(err= DateParseErr/MonthOutOfRange(month= mv))
  dateOf(y= /Data/Result/Fail(err), m, d)= /Data/Result/Fail(err= DateParseErr/BadPart(part= "year", cause= err))
  dateOf(y= /Data/Result/Ok(value), m= /Data/Result/Fail(err), d)= /Data/Result/Fail(err= DateParseErr/BadPart(part= "month", cause= err))
  dateOf(y= /Data/Result/Ok(value@yv), m= /Data/Result/Ok(value@mv), d= /Data/Result/Fail(err))= /Data/Result/Fail(err= DateParseErr/BadPart(part= "day", cause= err))

  dayOf(year -> Integer, month -> Integer, day -> Integer) -> /Data/Result[$T -> Date.., $E -> DateParseErr]
    # [dayOf] is the [day] of a [month] there is, where the month has that day.
  dayOf(year, month, day) | day >= 1 && day <= daysInMonth(year= year, month= month)= /Data/Result/Ok(value= Date(year= year, month= month, day= day))
  dayOf(year, month, day) else = /Data/Result/Fail(err= DateParseErr/NoSuchDay(year= year, month= month, day= day))

  > parseDate(s= "2026-01-03")
    >>> 2026-01-03
  > parseDate(s= "2024-02-29")
    >>> 2024-02-29
  > parseDate(s= "2026-02-29")
    >>> error: 2026-02-29 is not a day that exists
  > parseDate(s= "2026-13-01")
    >>> error: 13 is not a month from 1 to 12
  > parseDate(s= "2026-0x-01")
    >>> error: the month is not a number: 'x' at 1 is not a digit of base 10
  > parseDate(s= "lunch")
    >>> error: "lunch" is not a date written YYYY-MM-DD
module(Data)
  :/Data/Time/DateParseErr/BadShape(text).msg= "\"" ++ text ++ "\" is not a date written YYYY-MM-DD"
  :/Data/Time/DateParseErr/BadPart(part, cause).msg= "the " ++ part ++ " is not a number: " ++ cause.msg
  :/Data/Time/DateParseErr/MonthOutOfRange(month).msg= month.toString ++ " is not a month from 1 to 12"
  :/Data/Time/DateParseErr/NoSuchDay(year, month, day).msg= /Data/Time/Date(year= year, month= month, day= day).toString ++ " is not a day that exists"
module(Data/Time)
  # ## Ordering days
    Days are ordered by when they fall, which is the order of their counts.
  every(Date.., isa= [/Data/Algebra/Ord])

  data(DateOrdering, isa= [/Data/Algebra/Ordering])
    # [DateOrdering] orders two dates by which falls first.

# The arms answering the [/Data/Algebra/Ord] methods are written in that module, as [/Data/Maybe]'s
#   are, so that the names they answer are the class's own rather than new ones of this module.
#   Each date is written out again from its fields rather than named as [this], because a receiver
#   taken apart into its fields is not also bound whole.
module(Data/Algebra)
  :/Data/Time/DateOrdering.compare(a -> /Data/Time/Date.., b -> /Data/Time/Date..)= a.daysSinceEpoch.compareTo(other= b.daysSinceEpoch)

  :/Data/Time/Date(year, month, day).ord= /Data/Time/DateOrdering

  :/Data/Time/Date(year, month, day).compareTo(other= /Data/Time/Date(year@oy, month@om, day@od))= /Data/Time/DateOrdering.compare(a= /Data/Time/Date(year= year, month= month, day= day), b= /Data/Time/Date(year= oy, month= om, day= od))

  :/Data/Time/Date(year, month, day).eq= /Data/Time/DateOrdering

  :/Data/Time/Date(year, month, day).equal(other= /Data/Time/Date(year@oy, month@om, day@od))= /Data/Time/DateOrdering.rel(a= /Data/Time/Date(year= year, month= month, day= day), b= /Data/Time/Date(year= oy, month= om, day= od))
module(Data/Time)
  > (Date(year= 2026, month= 1, day= 3) == Date(year= 2026, month= 1, day= 3))
    >>> True
  > (Date(year= 2025, month= 12, day= 31) < Date(year= 2026, month= 1, day= 1))
    >>> True
  > (Date(year= 2026, month= 2, day= 1) < Date(year= 2026, month= 1, day= 31))
    >>> False
  # ## Times of day
  data(TimeOfDay(hour -> Integer, minute -> Integer))
    # A [TimeOfDay] is the minute [minute] (0 to 59) of the hour [hour] (0 to 23) of a day, on a
      24-hour clock.

  :TimeOfDay...minutesSinceMidnight -> Integer
    # [minutesSinceMidnight] is how many minutes into its day the time is.
  :TimeOfDay(hour, minute).minutesSinceMidnight= hour * 60 + minute

  fromMinutesSinceMidnight(minutes -> Integer) -> TimeOfDay..
    # [fromMinutesSinceMidnight] is the time [minutes] minutes into a day, counted round the clock:
      a count past the end of the day starts the next one again from midnight, and a negative count
      is counted back from the midnight that ends the day.
  fromMinutesSinceMidnight(minutes)= TimeOfDay(hour= (minutes % 1440) // 60, minute= minutes % 60)

  :TimeOfDay...addMinutes(n -> Integer) -> TimeOfDay..
    # [addMinutes] is the time [n] minutes after this one round the clock, so that 23:45 and thirty
      minutes is 00:15. What day that falls on is not a time of day's to say.
  :TimeOfDay(hour, minute).addMinutes(n)= fromMinutesSinceMidnight(minutes= hour * 60 + minute + n)

  every(TimeOfDay.., isa= [/Data/ToString])

  :TimeOfDay(hour, minute).toString= padded(n= hour, width= 2) ++ ":" ++ padded(n= minute, width= 2)
    # A [TimeOfDay] is written on a 24-hour clock as @HH:mm@.

  > TimeOfDay(hour= 9, minute= 5)
    >>> 09:05
  > TimeOfDay(hour= 23, minute= 45).addMinutes(n= 30)
    >>> 00:15
  > TimeOfDay(hour= 0, minute= 10).addMinutes(n= 0 - 20)
    >>> 23:50
  every(TimeOfDay.., isa= [/Data/Algebra/Ord])

  data(TimeOfDayOrdering, isa= [/Data/Algebra/Ordering])
    # [TimeOfDayOrdering] orders two times by which comes first in a day.
module(Data/Algebra)
  :/Data/Time/TimeOfDayOrdering.compare(a -> /Data/Time/TimeOfDay.., b -> /Data/Time/TimeOfDay..)= a.minutesSinceMidnight.compareTo(other= b.minutesSinceMidnight)

  :/Data/Time/TimeOfDay(hour, minute).ord= /Data/Time/TimeOfDayOrdering

  :/Data/Time/TimeOfDay(hour, minute).compareTo(other= /Data/Time/TimeOfDay(hour@oh, minute@om))= /Data/Time/TimeOfDayOrdering.compare(a= /Data/Time/TimeOfDay(hour= hour, minute= minute), b= /Data/Time/TimeOfDay(hour= oh, minute= om))

  :/Data/Time/TimeOfDay(hour, minute).eq= /Data/Time/TimeOfDayOrdering

  :/Data/Time/TimeOfDay(hour, minute).equal(other= /Data/Time/TimeOfDay(hour@oh, minute@om))= /Data/Time/TimeOfDayOrdering.rel(a= /Data/Time/TimeOfDay(hour= hour, minute= minute), b= /Data/Time/TimeOfDay(hour= oh, minute= om))
module(Data/Time)
  > (TimeOfDay(hour= 9, minute= 30) < TimeOfDay(hour= 10, minute= 0))
    >>> True
  > (TimeOfDay(hour= 9, minute= 30) == TimeOfDay(hour= 9, minute= 30))
    >>> True
  # ## Reading times of day
    A time is read as a note writes one: on a 24-hour clock with a colon or a dot between the hour
    and the minutes, @9:30@ or @09.30@; or on a 12-hour clock with @am@ or @pm@ after it, in either
    case and with or without a space, where the colon may be left out too, @9:30pm@ or @930 PM@.
    The minutes are always two digits. This is what the Obsidian Day Planner plugin reads at the
    start of a line.
  class(TimeParseErr, [TimeParseErr/BadShape(text -> String), TimeParseErr/BadDigits(hour -> String, minute -> String), TimeParseErr/BadPart(part -> String, cause -> /Data/IntegerParseErr), TimeParseErr/MinuteOutOfRange(minute -> Integer), TimeParseErr/HourOutOfRange(hour -> Integer), TimeParseErr/TwelveHourOutOfRange(hour -> Integer)], isa= [/Data/Err])
    # [TimeParseErr] is why a string is no [TimeOfDay]: it does not write an hour and minutes apart
      ([BadShape]); the hour is not one or two digits or the minutes not two ([BadDigits]); the
      hour or minutes written are not a number ([BadPart]); or the minutes are 60 or more
      ([MinuteOutOfRange]), the hour of a 24-hour clock is past 23 ([HourOutOfRange]), or the hour
      of a 12-hour one is not 1 to 12 ([TwelveHourOutOfRange]).

  parseTimeOfDay(s -> String) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [parseTimeOfDay] reads a time of day written either way, or fails with why it is not one. A
      time that does not exist, such as 25:00 or 13pm, is not one.
  parseTimeOfDay(s)= clockOf(t= s.trim.toLower)

  clockOf(t -> String) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [clockOf] reads a time already trimmed and in lower case, by the clock its ending says.
  clockOf(t) | t.endsWith(suffix= "am")= twelveHour(clock= clockParts(clock= t.take(n= t.length - 2).trimEnd, bare= True), pm= False)
  clockOf(t) | t.endsWith(suffix= "pm")= twelveHour(clock= clockParts(clock= t.take(n= t.length - 2).trimEnd, bare= True), pm= True)
  clockOf(t) else = twentyFourHour(clock= clockParts(clock= t, bare= False))

  clockParts(clock -> String, bare -> Boolean) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [clockParts] reads the hour and minutes [clock] writes, as a [TimeOfDay] whose hour is not yet
      checked against either clock. They are written apart by a colon or a dot, or where [bare] is
      [True], may be written together as the three or four digits of @930@ or @1130@.
  clockParts(clock, bare) | clock.contains(sub= ":")= partsOf(clock= clock, parts= clock.split(sep= ":"))
  clockParts(clock, bare) else = dottedOrBare(clock= clock, bare= bare)

  dottedOrBare(clock -> String, bare -> Boolean) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [dottedOrBare] reads a clock written with no colon: with a dot, or with nothing at all where
      that is allowed.
  dottedOrBare(clock, bare) | clock.contains(sub= ".")= partsOf(clock= clock, parts= clock.split(sep= "."))
  dottedOrBare(clock, bare) | bare && clock.length >= 3 && clock.length <= 4= partsOf(clock= clock, parts= [clock.take(n= clock.length - 2), clock.drop(n= clock.length - 2)])
  dottedOrBare(clock, bare) else = /Data/Result/Fail(err= TimeParseErr/BadShape(text= clock))

  partsOf(clock -> String, parts -> /Data/List/ConsList[$T -> String]) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [partsOf] is the hour and minutes of exactly two pieces of [clock]: an hour of one or two
      digits and minutes of exactly two, below 60.
  partsOf(clock, parts= /Data/List/Cons(head@h, tail= /Data/List/Cons(head@m, tail= /Data/List/Nil))) | h.length >= 1 && h.length <= 2 && m.length == 2= minutesOf(hour= natural(s= h), minute= natural(s= m))
  partsOf(clock, parts= /Data/List/Cons(head@h, tail= /Data/List/Cons(head@m, tail= /Data/List/Nil))) else = /Data/Result/Fail(err= TimeParseErr/BadDigits(hour= h, minute= m))
  partsOf(clock, parts= /Data/List/Nil)= /Data/Result/Fail(err= TimeParseErr/BadShape(text= clock))
  partsOf(clock, parts= /Data/List/Cons(head, tail= /Data/List/Nil))= /Data/Result/Fail(err= TimeParseErr/BadShape(text= clock))
  partsOf(clock, parts= /Data/List/Cons(head@h, tail= /Data/List/Cons(head@m, tail= /Data/List/Cons(head, tail))))= /Data/Result/Fail(err= TimeParseErr/BadShape(text= clock))

  minutesOf(hour -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr], minute -> /Data/Result[$T -> Integer, $E -> /Data/IntegerParseErr]) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [minutesOf] is the time of an hour and minutes both read, with the minutes below 60.
  minutesOf(hour= /Data/Result/Ok(value@h), minute= /Data/Result/Ok(value@m)) | m < 60= /Data/Result/Ok(value= TimeOfDay(hour= h, minute= m))
  minutesOf(hour= /Data/Result/Ok(value@h), minute= /Data/Result/Ok(value@m)) else = /Data/Result/Fail(err= TimeParseErr/MinuteOutOfRange(minute= m))
  minutesOf(hour= /Data/Result/Fail(err), minute)= /Data/Result/Fail(err= TimeParseErr/BadPart(part= "hour", cause= err))
  minutesOf(hour= /Data/Result/Ok(value), minute= /Data/Result/Fail(err))= /Data/Result/Fail(err= TimeParseErr/BadPart(part= "minute", cause= err))

  twentyFourHour(clock -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [twentyFourHour] keeps a time read on a 24-hour clock where its hour is one, 0 to 23.
  twentyFourHour(clock= /Data/Result/Ok(value= TimeOfDay(hour, minute))) | hour <= 23= /Data/Result/Ok(value= TimeOfDay(hour= hour, minute= minute))
  twentyFourHour(clock= /Data/Result/Ok(value= TimeOfDay(hour, minute))) else = /Data/Result/Fail(err= TimeParseErr/HourOutOfRange(hour= hour))
  twentyFourHour(clock= /Data/Result/Fail(err))= /Data/Result/Fail(err= err)

  twelveHour(clock -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr], pm -> Boolean) -> /Data/Result[$T -> TimeOfDay.., $E -> TimeParseErr]
    # [twelveHour] turns a time read on a 12-hour clock, whose hour is 1 to 12, into the time it is
      on a 24-hour one: 12am is midnight and 12pm is noon.
  twelveHour(clock= /Data/Result/Ok(value= TimeOfDay(hour, minute)), pm) | hour >= 1 && hour <= 12= /Data/Result/Ok(value= TimeOfDay(hour= hour % 12 + afternoon(pm= pm), minute= minute))
  twelveHour(clock= /Data/Result/Ok(value= TimeOfDay(hour, minute)), pm) else = /Data/Result/Fail(err= TimeParseErr/TwelveHourOutOfRange(hour= hour))
  twelveHour(clock= /Data/Result/Fail(err), pm)= /Data/Result/Fail(err= err)

  afternoon(pm -> Boolean) -> Integer
    # [afternoon] is how many hours a 12-hour clock's half of the day starts after midnight.
  afternoon(pm= True)= 12
  afternoon(pm= False)= 0

  > parseTimeOfDay(s= "9:30")
    >>> 09:30
  > parseTimeOfDay(s= "09.00")
    >>> 09:00
  > parseTimeOfDay(s= "9:30pm")
    >>> 21:30
  > parseTimeOfDay(s= "930 PM")
    >>> 21:30
  > parseTimeOfDay(s= "12:15am")
    >>> 00:15
  > parseTimeOfDay(s= "25:00")
    >>> error: 25 is not an hour of a 24-hour clock, 0 to 23
  > parseTimeOfDay(s= "13:00pm")
    >>> error: 13 is not an hour of a 12-hour clock, 1 to 12
  > parseTimeOfDay(s= "13pm")
    >>> error: "13" does not write an hour and minutes apart
  > parseTimeOfDay(s= "930")
    >>> error: "930" does not write an hour and minutes apart
  > parseTimeOfDay(s= "9:75")
    >>> error: 75 is not a minute, 0 to 59
  > parseTimeOfDay(s= "9:3")
    >>> error: "9" and "3" are not an hour of one or two digits and minutes of two
  > parseTimeOfDay(s= "9:3x")
    >>> error: the minute is not a number: 'x' at 1 is not a digit of base 10
module(Data)
  :/Data/Time/TimeParseErr/BadShape(text).msg= "\"" ++ text ++ "\" does not write an hour and minutes apart"
  :/Data/Time/TimeParseErr/BadDigits(hour, minute).msg= "\"" ++ hour ++ "\" and \"" ++ minute ++ "\" are not an hour of one or two digits and minutes of two"
  :/Data/Time/TimeParseErr/BadPart(part, cause).msg= "the " ++ part ++ " is not a number: " ++ cause.msg
  :/Data/Time/TimeParseErr/MinuteOutOfRange(minute).msg= minute.toString ++ " is not a minute, 0 to 59"
  :/Data/Time/TimeParseErr/HourOutOfRange(hour).msg= hour.toString ++ " is not an hour of a 24-hour clock, 0 to 23"
  :/Data/Time/TimeParseErr/TwelveHourOutOfRange(hour).msg= hour.toString ++ " is not an hour of a 12-hour clock, 1 to 12"
module(Data/Time)
  # ## Lengths of time and spans of a day
  data(Duration(minutes -> Integer))
    # A [Duration] is a length of time, counted in whole minutes.

  every(Duration.., isa= [/Data/ToString])

  :Duration(minutes).toString | minutes < 60= minutes.toString ++ "m"
    # A [Duration] is written in hours and minutes, leaving out whichever is none: @45m@, @2h@,
      @1h 30m@.
  :Duration(minutes).toString else = hoursText(minutes= minutes)

  hoursText(minutes -> Integer) -> String
    # [hoursText] writes a length of an hour or more, as hours and whatever minutes are left over.
  hoursText(minutes) | minutes % 60 == 0= (minutes // 60).toString ++ "h"
  hoursText(minutes) else = (minutes // 60).toString ++ "h " ++ (minutes % 60).toString ++ "m"

  > Duration(minutes= 90)
    >>> 1h 30m
  > Duration(minutes= 120)
    >>> 2h
  > Duration(minutes= 45)
    >>> 45m
  data(TimeRange(start -> TimeOfDay.., end -> TimeOfDay..))
    # A [TimeRange] is the span of a day from [start] to [end]. An [end] at or before [start] runs on
      past midnight into the next day.

  :TimeRange...duration -> Duration..
    # [duration] is how long the range lasts, round the clock where it runs past midnight.
  :TimeRange(start, end).duration= Duration(minutes= (end.minutesSinceMidnight - start.minutesSinceMidnight) % 1440)

  every(TimeRange.., isa= [/Data/ToString])

  :TimeRange(start, end).toString= start.toString ++ " - " ++ end.toString
    # A [TimeRange] is written as its two times with a dash between them, as a note writes one.

  > TimeRange(start= TimeOfDay(hour= 9, minute= 0), end= TimeOfDay(hour= 10, minute= 30))
    >>> 09:00 - 10:30
  > TimeRange(start= TimeOfDay(hour= 9, minute= 0), end= TimeOfDay(hour= 10, minute= 30)).duration
    >>> 1h 30m
  > TimeRange(start= TimeOfDay(hour= 23, minute= 0), end= TimeOfDay(hour= 1, minute= 0)).duration
    >>> 2h
