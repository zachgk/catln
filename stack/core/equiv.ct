import "core/primitives.ct"
import "core/algebra.ct"


module(Data/Algebra)
  # # Equivalence Relations
    An [Eqv] captures an equivalence relation over a type [$T]: a function that decides
    whether two values of [$T] are to be considered equivalent.
  data(Eqv[$T](rel(a -> $T, b -> $T) -> Boolean))
    # An [Eqv] holds the equivalence function [rel] for the type [$T].

  # [check] applies the stored equivalence function to two values of [$T].
  :/Data/Algebra/Eqv[$T](rel(a, b)).check(x -> $T, y -> $T) -> Boolean
  :/Data/Algebra/Eqv[$T](rel(a, b)).check(x, y)= rel(a= x, b= y)

  # [eq] is the standard equivalence relation for an [Eq] type; [equal] is the single method
  #   through which [operator==] dispatches. Instances and the operators live in [Data/Algebra/equality].
  :$T.eq[$T -> /Data/Algebra/Eq] -> /Data/Algebra/Eqv[$T]

  :$T.equal[$T -> /Data/Algebra/Eq](other -> $T) -> Boolean

  (_ :: $T == _ :: $T)[$T -> /Data/Algebra/Eq] -> Boolean

  (_ :: $T != _ :: $T)[$T -> /Data/Algebra/Eq] -> Boolean

  # ## Example
    The simplest [Eqv] over [Integer] compares its values with the built-in [operator==].
  exampleIntEqv =
    #example
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= a == b).check(x= 2, y= 2))
    0

  # ## Laws of equivalence
  testEqvReflexive =
    #test
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= a == b).check(x= 3, y= 3))
    0

  # Symmetry: for an [Eqv] whose relation is symmetric, equivalent values check the same in
  #   either direction. Each direction is asserted directly rather than comparing the two
  #   results with [operator==] (comparing them needs parameterized-type binding to flow
  #   [Integer] into an inline [Eqv]'s [rel], which is not yet supported).
  testEqvSymmetric =
    #test
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= True).check(x= 3, y= 5))
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= True).check(x= 5, y= 3))
    0

  # Transitivity: for an [Eqv] whose relation is transitive, a~b and b~c imply a~c. Each link
  #   is asserted directly (see the note on [testEqvSymmetric]).
  testEqvTransitive =
    #test
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= True).check(x= 3, y= 5))
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= True).check(x= 5, y= 7))
    #assert(test= /Data/Algebra/Eqv[Integer](rel(a, b)= True).check(x= 3, y= 7))
    0
