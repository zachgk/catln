import "core/functor.ct"
import "core/monad.ct"


module(Data)
  # # Lists
    A [List] is a collection of zero or more ordered items.
  class(List[$T])

  # A [List] is a collection of zero or more ordered items.
  class(ConsList[$T], [Cons[$T -> $_T](head -> $T, tail -> ConsList[$T -> $_T]), Nil])
    # The simplest kind of list can be created by prepending.
      A [ConsList] defines a list either by prepending to a list or with an empty list.

  every(ConsList[$T -> $_T], isa= [/Data/List[$T -> $_T]])

  # /operator+:<$T>($T l, ConsList<$T> r) = Cons(head=l, tail=r)
    [operator+:] is a utility operator to prepend an element onto a [List].
  # #### [length]
    The [length] of a [List] is the number of items inside of it.
  :Nil.length= 0
  /Data/Cons(head, tail).length= 1 + tail.length
  :ConsList.length -> Integer

  # The [length] of a [List] is always non-negative.
  :ConsList.length -> Integer_nonNeg
    #refine

  # #### Structural equality
    Two [ConsList]s of [Eq] elements are equal when they have the same length and equal elements
    pairwise. [consEqual] is the recursive structural comparison — a plain standalone function (it
    recurses through itself, not through [tail.equal], so the recursion stays a concrete arrow
    rather than an abstract method dispatch). The [Eq] membership and [equal] method at the end of
    this file delegate [operator==] into it.
  consEqual(a -> ConsList[$T -> /Data/Algebra/Eq], b -> ConsList[$T -> /Data/Algebra/Eq]) -> Boolean
  consEqual(a= Nil, b= Nil)= True
  consEqual(a= Nil, b= /Data/Cons(head, tail))= False
  consEqual(a= /Data/Cons(head, tail), b= Nil)= False
  consEqual(a= /Data/Cons(head@ah, tail@at), b= /Data/Cons(head@bh, tail@bt))= (ah == bh) && consEqual(a= at, b= bt)

  # ## List operations
  sum(lst -> /Data/List) -> Integer

  all(lst -> /Data/List) -> Boolean

  any(lst -> /Data/List) -> Boolean

  reversed(lst -> /Data/List) -> /Data/List

  sorted(lst -> /Data/List) -> /Data/List

  # ## ConsList runtime operations
  sum(lst -> ConsList) -> Integer
    #runtime("listSum")

  all(lst -> ConsList) -> Boolean
    #runtime("listAll")

  any(lst -> ConsList) -> Boolean
    #runtime("listAny")

  reversed(lst -> ConsList) -> ConsList
    #runtime("listReversed")

  sorted(lst -> ConsList) -> ConsList
    #runtime("listSorted")

  range(stop -> Integer) -> ConsList
    #runtime("listRange")

  every(ConsList[$T -> $_T], isa= [/Data/Functor])

# # ConsList Functor instance
module(Data/List)
  # [fmap] over a [ConsList] applies a function to every element, producing a new list.
  # This is the [ConsList] instance of the generic [fmap] declared over [Functor] in
  # [Data]. It lives in its own module so the open [Functor] interface is not required to
  # be totally covered, while still resolving for calls of [fmap] on a [ConsList].
  /Data/fmap(lst= Nil, fn(v))= Nil
  /Data/fmap(lst= /Data/Cons(head, tail), fn(v))= /Data/Cons(head= fn(v= head), tail= /Data/fmap(lst= tail, fn(v)= fn(v= v)))

  # A [ConsList] of any [Eq] element is itself an [Eq] member (see the end of this file), so
  # [operator==] checks whole lists structurally — comparing them directly rather than only their
  # [length]. The element [Eq] dispatch is generic, so lists of [Integer], [Boolean], etc. all work.
  testConsListEquality =
    #test
    #assert(test= /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)))
    #assert(test= ~(/Data/Cons(head= 1, tail= /Data/Nil) == /Data/Cons(head= 2, tail= /Data/Nil)))
    #assert(test= ~(/Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Nil)))
    #assert(test= /Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil) == /Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil))
    #assert(test= ~(/Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil) == /Data/Cons(head= /Data/Primitive/False, tail= /Data/Nil)))
    0

# # ConsList Eq membership
  Makes a [ConsList] of any [Eq] element a proper member of [Eq], so the generic [operator==]
  dispatches through the [equal] method into [consEqual]. This is the idiomatic path (vs. a
  standalone operator overload), and mirrors Haskell's `instance Eq a => Eq [a]`. The element bound
  `$T -> Eq` makes the membership conditional on the element being [Eq], so the recursive
  [consEqual] call on the elements typechecks.
module(Data)
  every(ConsList[$T -> /Data/Algebra/Eq], isa= [/Data/Algebra/Eq])
module(Data/Algebra)
  :/Data/Nil.equal(other -> /Data/ConsList[$E -> /Data/Algebra/Eq])= /Data/consEqual(a= /Data/Nil, b= other)
  :/Data/Cons[$T -> /Data/Algebra/Eq](head, tail).equal(other -> /Data/ConsList[$E -> /Data/Algebra/Eq])= /Data/consEqual(a= /Data/Cons(head= head, tail= tail), b= other)

# # ConsList Monad instance
  [mmap] over a [ConsList] is concatMap: the function returns a whole list for each element, and
  the results are appended in order.
module(Data)
  # [append] joins two lists in order — the recursive structural join, mirroring [consEqual]
  # (it recurses through itself so the recursion stays a concrete arrow).
  append(a -> ConsList[$T -> $_T], b -> ConsList[$T -> $_T]) -> ConsList[$T -> $_T]
  append(a= Nil, b)= b
  append(a= /Data/Cons(head, tail), b)= /Data/Cons(head= head, tail= append(a= tail, b= b))

  every(ConsList[$T -> $_T], isa= [/Data/Monad])
module(Data/List)
  # The [ConsList] instance of the generic [mmap] declared over [Monad] in [Data]. Like the
  # [fmap] instance above, it lives in its own module so the open [Monad] class is not
  # required to be totally covered here.
  /Data/mmap(m= Nil, fn(v))= Nil
  /Data/mmap(m= /Data/Cons(head, tail), fn(v))= /Data/append(a= fn(v= head), b= /Data/mmap(m= tail, fn(v)= fn(v= v)))

  testAppend =
    #test
    #assert(test= /Data/append(a= /Data/Cons(head= 1, tail= /Data/Nil), b= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)))
    0

  testMmapConsBind =
    #test
    #assert(test= /Data/mmap(m= /Data/Cons(head= 1, tail= /Data/Nil), fn(v)= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 2, tail= /Data/Nil))
    0

  testMmapNil =
    #test
    #assert(test= /Data/mmap(m= /Data/Nil, fn(v)= /Data/Cons(head= v, tail= /Data/Nil)) == /Data/Nil)
    0
