import "core/ord.ct"
import "core/functor.ct"
import "core/monad.ct"


module(Data)
  # # Lists
    A [List] is a collection of zero or more ordered items.
  class(List[$T])

  # A [List] is a collection of zero or more ordered items.
  class(ConsList[$T], [Cons[$T -> $_T](head -> $T, tail -> ConsList[$T -> $_T]), Nil])
    # The simplest kind of list can be created by prepending.
      A [ConsList] defines a list either by prepending to a list or with an empty list.

  every(ConsList[$T -> $_T], isa= [/Data/List[$T -> $_T]])

  # /operator+:<$T>($T l, ConsList<$T> r) = Cons(head=l, tail=r)
    [operator+:] is a utility operator to prepend an element onto a [List].
  # #### [length]
    The [length] of a [List] is the number of items inside of it.
  :Nil.length= 0
  /Data/Cons(head, tail).length= 1 + tail.length
  :ConsList.length -> Integer

  # The [length] of a [List] is always non-negative.
  :ConsList.length -> Integer_nonNeg
    #refine

  # #### Structural comparison helper
    Two [ConsList]s of [Ord] elements are ordered lexicographically: the first differing pair of
    elements decides the order, and a shorter list that is a prefix of a longer one comes first
    ([Nil] before any [Cons]). The [compareTo] instance at the end of this file compares heads then
    tails; [consThen] sequences those two comparisons, falling through to the tail's comparison only
    when the heads compare [Equal].
  consThen(first -> /Data/Algebra/Comparison, second -> /Data/Algebra/Comparison) -> /Data/Algebra/Comparison
  consThen(first= /Data/Algebra/Equal, second)= second
  consThen(first= /Data/Algebra/LessThan, second)= /Data/Algebra/LessThan
  consThen(first= /Data/Algebra/GreaterThan, second)= /Data/Algebra/GreaterThan

  # ## List operations
  sum(lst -> /Data/List) -> Integer

  all(lst -> /Data/List) -> Boolean

  any(lst -> /Data/List) -> Boolean

  reversed(lst -> /Data/List) -> /Data/List

  sorted(lst -> /Data/List) -> /Data/List

  # ## ConsList runtime operations
  sum(lst -> ConsList) -> Integer
    #runtime("listSum")

  all(lst -> ConsList) -> Boolean
    #runtime("listAll")

  any(lst -> ConsList) -> Boolean
    #runtime("listAny")

  reversed(lst -> ConsList) -> ConsList
    #runtime("listReversed")

  sorted(lst -> ConsList) -> ConsList
    #runtime("listSorted")

  range(stop -> Integer) -> ConsList
    #runtime("listRange")

  every(ConsList[$T -> $_T], isa= [/Data/Functor])

# # ConsList Functor instance
module(Data/List)
  # [fmap] over a [ConsList] applies a function to every element, producing a new list.
  # This is the [ConsList] instance of the generic [fmap] declared over [Functor] in
  # [Data]. It lives in its own module so the open [Functor] interface is not required to
  # be totally covered, while still resolving for calls of [fmap] on a [ConsList].
  /Data/fmap(lst= Nil, fn(v))= Nil
  /Data/fmap(lst= /Data/Cons(head, tail), fn(v))= /Data/Cons(head= fn(v= head), tail= /Data/fmap(lst= tail, fn(v)= fn(v= v)))

  # A [ConsList] of any [Eq] element is itself an [Eq] member (see the end of this file), so
  # [operator==] checks whole lists structurally — comparing them directly rather than only their
  # [length]. The element [Eq] dispatch is generic, so lists of [Integer], [Boolean], etc. all work.
  testConsListEquality =
    #test
    #assert(test= /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)))
    #assert(test= ~(/Data/Cons(head= 1, tail= /Data/Nil) == /Data/Cons(head= 2, tail= /Data/Nil)))
    #assert(test= ~(/Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Nil)))
    #assert(test= /Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil) == /Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil))
    #assert(test= ~(/Data/Cons(head= /Data/Primitive/True, tail= /Data/Nil) == /Data/Cons(head= /Data/Primitive/False, tail= /Data/Nil)))
    0

  # A [ConsList] of any [Ord] element is an [Ord] member (see the end of this file), so [compareTo]
  # orders lists lexicographically, with a prefix ordered before its extension.
  testOrdConsList =
    #test
    #assert(test= /Data/Cons(head= 1, tail= /Data/Nil).compareTo(other= /Data/Cons(head= 2, tail= /Data/Nil)).isLess)
    #assert(test= /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)).compareTo(other= /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil))).isEq)
    #assert(test= /Data/Cons(head= 1, tail= /Data/Nil).compareTo(other= /Data/Nil).isGreater)
    #assert(test= /Data/Cons(head= 1, tail= /Data/Nil).compareTo(other= /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil))).isLess)
    0

# # ConsList Eq membership
  Makes a [ConsList] of any [Eq] element a proper member of [Eq], so the generic [operator==]
  dispatches through the [equal] method. Two lists are equal when they match constructor for
  constructor with equal heads pairwise; the recursion runs through [tail.equal]. This is the
  idiomatic path (vs. a standalone operator overload), and mirrors Haskell's `instance Eq a => Eq
  [a]`. The element bound `$T -> Eq` makes the membership conditional on the element being [Eq], so
  the head comparison on the elements typechecks.
module(Data)
  every(ConsList[$T -> /Data/Algebra/Eq], isa= [/Data/Algebra/Eq])
module(Data/Algebra)
  :/Data/Nil.equal(other= /Data/Nil)= True
  :/Data/Nil.equal(other= /Data/Cons(head, tail))= False
  :/Data/Cons(head, tail).equal(other= /Data/Nil)= False
  :/Data/Cons[$T -> /Data/Algebra/Eq](head@ah, tail@at).equal(other= /Data/Cons(head@bh, tail@bt))= (ah == bh) && at.equal(other= bt)

# # ConsList Ord membership
  Makes a [ConsList] of any [Ord] element a proper member of [Ord], so [compareTo] dispatches per
  constructor. Lists are ordered lexicographically ([consThen] sequences the head comparison with
  the tail's); the recursion runs through [tail.compareTo]. Mirrors the [Eq] membership above (and
  every [Ord] is an [Eq], which the [Eq] membership already supplies).
module(Data)
  every(ConsList[$T -> /Data/Algebra/Ord], isa= [/Data/Algebra/Ord])
module(Data/Algebra)
  :/Data/Nil.compareTo(other= /Data/Nil)= /Data/Algebra/Equal
  :/Data/Nil.compareTo(other= /Data/Cons(head, tail))= /Data/Algebra/LessThan
  :/Data/Cons(head, tail).compareTo(other= /Data/Nil)= /Data/Algebra/GreaterThan
  :/Data/Cons[$T -> /Data/Algebra/Ord](head@ah, tail@at).compareTo(other= /Data/Cons(head@bh, tail@bt))= /Data/consThen(first= ah.compareTo(other= bh), second= at.compareTo(other= bt))

# # ConsList Monad instance
  [mmap] over a [ConsList] is concatMap: the function returns a whole list for each element, and
  the results are appended in order.
module(Data)
  # [append] joins two lists in order — the recursive structural join (it recurses through itself
  # so the recursion stays a concrete arrow).
  append(a -> ConsList[$T -> $_T], b -> ConsList[$T -> $_T]) -> ConsList[$T -> $_T]
  append(a= Nil, b)= b
  append(a= /Data/Cons(head, tail), b)= /Data/Cons(head= head, tail= append(a= tail, b= b))

  every(ConsList[$T -> $_T], isa= [/Data/Monad])
module(Data/List)
  # The [ConsList] instance of the generic [mmap] declared over [Monad] in [Data]. Like the
  # [fmap] instance above, it lives in its own module so the open [Monad] class is not
  # required to be totally covered here.
  /Data/mmap(m= Nil, fn(v))= Nil
  /Data/mmap(m= /Data/Cons(head, tail), fn(v))= /Data/append(a= fn(v= head), b= /Data/mmap(m= tail, fn(v)= fn(v= v)))

  testAppend =
    #test
    #assert(test= /Data/append(a= /Data/Cons(head= 1, tail= /Data/Nil), b= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 1, tail= /Data/Cons(head= 2, tail= /Data/Nil)))
    0

  testMmapConsBind =
    #test
    #assert(test= /Data/mmap(m= /Data/Cons(head= 1, tail= /Data/Nil), fn(v)= /Data/Cons(head= 2, tail= /Data/Nil)) == /Data/Cons(head= 2, tail= /Data/Nil))
    0

  testMmapNil =
    #test
    #assert(test= /Data/mmap(m= /Data/Nil, fn(v)= /Data/Cons(head= v, tail= /Data/Nil)) == /Data/Nil)
    0

  # [pure] for [ConsList] builds a singleton list; the call site's expected list type selects
  # this instance (return-type-directed dispatch — see [pure] in [Data/monad]).
  /Data/pure[$M -> /Data/ConsList[$T -> $_T]](v)= /Data/Cons(head= v, tail= /Data/Nil)

  pureConsInt(v -> Integer) -> /Data/Cons[$T -> Integer]
  pureConsInt(v)= /Data/pure(v= v)

  testPureCons =
    #test
    #assert(test= pureConsInt(v= 1) == /Data/Cons(head= 1, tail= /Data/Nil))
    0
