import "core/bool.ct"
import "core/str.ct"
import "core/webdoc.ct"


module(Data/Note)
  # # Notes
    A note is a piece of writing that names itself and links to other notes. Each note is a page of
    its own and each link between two notes is an import between their pages, so the graph a set of
    notes forms is the import graph of the program they are read as.
  data(Page(title -> String))
    # A [Page] is one note. It holds the [title] the note is known and linked by; the writing itself
      is the comment inside the page rather than a field of it, so reading the page is reading the
      note. Importing an Obsidian vault reads it as one [Page] per note of it.
  data(Task(contents -> String, state -> Boolean))
    # A [Task] is one thing to do, written in a note as a markdown checkbox. Its [contents] are what
      the checkbox says and its [state] is whether the box is checked. A task is a break in the
      writing of the note holding it: the comment ends where the checkbox was written, the [Task] is
      declared in its place, and the writing goes on after it as another comment. So the tasks of a
      note are declared in the order and the place they were written, and whatever is written
      indented under a checkbox is written inside its [Task] — the comment of it, and the checkboxes
      indented under it, which are tasks of that task by the same reading.

  every(Task.., isa= [/Catln/Doc/DShow])
    # A task is shown in the webdocs as the task it is, rather than as the declaration it was read
      into: a box to check and the writing beside it. It is the value itself that is shown, with no
      display type standing in for it, which is what lets checking the box in a doc server write the
      change back to the note the task was read from.
