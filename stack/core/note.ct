import "core/bool.ct"
import "core/maybe.ct"
import "core/str.ct"
import "core/webdoc.ct"


module(Data/Note)
  # # Notes
    A note is a piece of writing that names itself and links to other notes. Each note is a page of
    its own and each link between two notes is an import between their pages, so the graph a set of
    notes forms is the import graph of the program they are read as.
    A link is also a link in the writing. Where a note names another note of the same collection,
    the writing holds the link to the page that note is read as, so reading a note is a way of
    reaching the notes it names.
  data(Page(title -> String))
    # A [Page] is one note. It holds the [title] the note is known and linked by; the writing itself
      is the comment inside the page rather than a field of it, so reading the page is reading the
      note. Importing an Obsidian vault reads it as one [Page] per note of it, and a note which
      opens with a block of properties holds it as a [#properties] of the page rather than as
      writing of it.

  /Catln/Doc/dshow(s= Page(title))= /Catln/Doc/Show/Html(contents= "<h1>" ++ title ++ "</h1>")
    # A note is shown in the webdocs as the note it is: headed by the title it is known and linked
      by, rather than by the declaration that title was read into.
      Written here rather than in the doc server. A [Page] is this library's type, so what one looks
      like is this library's to say: the arm builds the heading and [/Catln/Doc/Show/Html] lays it
      into the page, so a doc server shows a note while holding nothing that knows what a note is.
      An arm and not membership of [/Catln/Doc/DShow]. A member is shown by the identity arm of
      [/Catln/Doc/dshow], which hands the value back for the webdocs to make of what they will, which
      is what a task is. Both at once is two arms matching one value with nothing to say which wins.
      The title is the whole of the display because it is the whole of what the page holds. The
      writing, the tasks and the properties are statements inside the page rather than fields of it,
      so each is shown where the note wrote it and none of them is shown twice.
      The title is not escaped. A note is titled by the file it is written in, so a note named with a
      @<@ or an @&@ has that name read as markup. The webdocs sanitize what they are shown, so the
      worst of it is a heading that reads wrongly rather than a page that runs what a filename said;
      escaping it properly waits on [String] having a way to escape.
      Shown and never written. A note is titled by the file it is written in, so retitling one is
      renaming that file, which replacing an expression of the page cannot do.

  class(Task)
    # A [Task] is one thing to do, written in a note as a markdown checkbox. A task is a break in
      the writing of the note holding it: the comment ends where the checkbox was written, the task
      is declared in its place, and the writing goes on after it as another comment. So the tasks of
      a note are declared in the order and the place they were written, and whatever is written
      indented under a checkbox is written inside its task — the comment of it, and the checkboxes
      indented under it, which are tasks of that task by the same reading.
      Which of its readings a checkbox gets is decided by the vault it was written in rather than by
      the checkbox. A vault running the Obsidian Tasks plugin writes dates, priorities and links
      into the line beside the box, and reading such a line as though it were only a line would read
      the plugin's writing as writing of the note.

  data(Task/Simple(contents -> String, state -> Boolean))
    # A [Task/Simple] is a checkbox read as a checkbox: its [contents] are what the box says and its
      [state] is whether the box is checked. It is what a note holds in a vault which does not run
      the Obsidian Tasks plugin, and what a checkbox of such a vault holds when the plugin is set to
      pass it over.

  every(Task/Simple.., isa= [/Data/Note/Task])
  every(Task/Simple.., isa= [/Catln/Doc/DShow])
    # A task is shown in the webdocs as the task it is, rather than as the declaration it was read
      into: a box to check and the writing beside it. It is the value itself that is shown, with no
      display type standing in for it, which is what lets checking the box in a doc server write the
      change back to the note the task was read from.

  class(StatusType, [StatusType/Todo, StatusType/Done, StatusType/InProgress, StatusType/OnHold, StatusType/Cancelled, StatusType/NonTask, StatusType/Empty])
    # Which kind of status the character in a box is, as the Obsidian Tasks plugin names the seven
      of them. Which character is which kind is the vault's to say and not markdown's: a vault may
      write @[/]@ for a task begun and @[-]@ for one dropped, and only the vault's own settings say
      so. So a box is read as the character it was written with and the kind that character is, and
      the kind is the reading.
  class(Priority, [Priority/Highest, Priority/High, Priority/Medium, Priority/None, Priority/Low, Priority/Lowest])
    # How urgent a task is, as the plugin's six priorities. [Priority/None] is written between
      medium and low rather than at either end, because that is where a task nobody gave a priority
      to sorts among ones somebody did.

  data(Task/Obsidian(contents -> String, symbol -> String, statusType -> StatusType, description -> String, priority -> Priority, scheduled -> /Data/Maybe[$T -> String], due -> /Data/Maybe[$T -> String], recurrence -> /Data/Maybe[$T -> String], rest -> String))
    # A [Task/Obsidian] is a checkbox in a vault running the Obsidian Tasks plugin, which writes a
      task's dates, priority, recurrence and links into the line beside the box.
      It carries that line as [contents], exactly as it was written, and everything else beside it
      as a reading of it — the same shape [Show/Properties] takes, and for the same reason: the one
      place that has to give the line back exactly as it was found is the one writing the note back,
      so reading it apart here must not be the only reading there is. Writing the note back writes
      [symbol] and [contents] and nothing else, so a line carrying something this does not yet read
      is written back carrying it.
      [symbol] is the character in the box as it was written and [statusType] is which of the seven
      kinds that character is. There is no [state] beside them: whether the box is done is
      [statusType] being [StatusType/Done], and carrying it twice would be two readings of one box
      which could disagree. The character is carried as well as the kind because writing the note
      back writes the character, and a vault may name several characters of the one kind — so the
      kind cannot say which of them this box wore.
      [description] is what the line says once the plugin's own writing is off it, which no reader
      can work out without knowing what the vault is set to — so it is carried rather than left to
      be derived. The tags stay in it, as the plugin leaves them there.
      The dates are carried as the @YYYY-MM-DD@ strings they were written as. Catln has no date to
      read them into, and inventing one here would be inventing it for the whole language rather
      than for a note.
      TODO Only a few of the fields a task carries are named here. The rest — the created and start
      dates, the done and cancelled dates, the tags apart from the description, the action on
      completion, the id, the ids it waits on, and the block link — are read exactly as these are
      and are carried together in [rest] as JSON, which is what [Show/TaskList] does with a whole
      list of tasks and what [Show/Properties] does with a block of properties. That is not because
      they are worth less. It is because a data type of eighteen fields cannot be typechecked at
      all: sixteen takes minutes and eighteen reaches the constraint limit, while ten values of a
      nine-field type cost nothing over declaring none. The measurements and the repro are in
      @test/Integration/disabled/wideDataScaling.ct@. When a wide type costs what a narrow one
      does, each of those should be a field here like the ones above.
      The done and the cancelled date are one thing among those, not two: a task is done or it is
      cancelled and never both, and [statusType] already says which of the two a task with such a
      date is.

  every(Task/Obsidian.., isa= [/Data/Note/Task])
  every(Task/Obsidian.., isa= [/Catln/Doc/DShow])

  annot(#taskList)

  data(Show/TaskList(tasks -> String))
    # [Show/TaskList] shows the tasks of every note it covers as one list. It carries them in
      [tasks], so the webdocs render the list from the compiled value rather than asking the compiler
      for it over a separate route. Each entry is the [Task] value itself, beside the page it was
      written in and the expression it was declared by. Those last two are what a list across notes
      needs and a note's own page does not: a task shown on its page is edited by naming the
      expression that page holds, where a task shown in a list has no such page, so it carries its
      own. That is what lets checking a box in the list write the note the task was read from rather
      than whatever is displaying it.
      Like [/Catln/Doc/Show/Sidebar] it is about which pages there are rather than about the program
      it is evaluated against, so the list of every task there is, is evaluated unscoped; written in
      a page it lists the tasks of what that page reaches.

  every(Show/TaskList.., isa= [/Catln/Doc/DShow])

  /Catln/Doc/dshow(s= #taskList) =
    taskList(annot) -> String
      # [taskList] renders the tasks of the pages the evaluation covers as JSON, each beside the page
        it was written in and the expression it was declared by. They are read exactly as a note's own
        page reads them, so a task in this list and the same task shown on its page are one value,
        shown one way, and edited by replacing one expression.
      #runtime("taskList")

    Show/TaskList(tasks= taskList(annot= s))

  annot(#tasks(query -> String))
    # A query a note writes over the tasks of its vault, which is what the Obsidian Tasks plugin
      reads out of a block of code a note fences as @tasks@. It is written where the note wrote the
      block, so a note asking about its tasks is a note holding that ask, and it carries [query] as
      the lines the reader typed rather than as a reading of them — the block is written back from
      it, and what a reader typed is what a reader has to be shown again.
  annot(#properties(text -> String))

  data(Show/Properties(text -> String))
    # [Show/Properties] shows the properties a note opens with: the block of @key: value@ lines
      written above the writing, as the table it reads as. It carries that block as the [text] it
      was written as rather than as the properties read out of it, because writing the note back
      writes the block again — reading it apart into fields here would be reading it apart in the
      one place that has to give it back exactly as it was found.
      A block naming a page on the web is read as a [/Catln/Doc/#overlay] of it as well, which is
      the page the note is written over. That is a second reading of the same block, made where
      the note is read rather than here: this shows what the note says, and the overlay is what
      the note says it is about.

  every(Show/Properties.., isa= [/Catln/Doc/DShow])

  /Catln/Doc/dshow(s= #properties(text))= Show/Properties(text= text)
