import "core/bool.ct"
import "core/str.ct"
import "core/webdoc.ct"


module(Data/Note)
  # # Notes
    A note is a piece of writing that names itself and links to other notes. Each note is a page of
    its own and each link between two notes is an import between their pages, so the graph a set of
    notes forms is the import graph of the program they are read as.
  data(Page(title -> String))
    # A [Page] is one note. It holds the [title] the note is known and linked by; the writing itself
      is the comment inside the page rather than a field of it, so reading the page is reading the
      note. Importing an Obsidian vault reads it as one [Page] per note of it, and a note which
      opens with a block of properties holds it as a [#properties] of the page rather than as
      writing of it.
  class(Task)
    # A [Task] is one thing to do, written in a note as a markdown checkbox. A task is a break in
      the writing of the note holding it: the comment ends where the checkbox was written, the task
      is declared in its place, and the writing goes on after it as another comment. So the tasks of
      a note are declared in the order and the place they were written, and whatever is written
      indented under a checkbox is written inside its task — the comment of it, and the checkboxes
      indented under it, which are tasks of that task by the same reading.
      Which of its readings a checkbox gets is decided by the vault it was written in rather than by
      the checkbox. A vault running the Obsidian Tasks plugin writes dates, priorities and links
      into the line beside the box, and reading such a line as though it were only a line would read
      the plugin's writing as writing of the note.

  data(Task/Simple(contents -> String, state -> Boolean))
    # A [Task/Simple] is a checkbox read as a checkbox: its [contents] are what the box says and its
      [state] is whether the box is checked. It is what a note holds in a vault which does not run
      the Obsidian Tasks plugin, and what a checkbox of such a vault holds when the plugin is set to
      pass it over.

  every(Task/Simple.., isa= [/Data/Note/Task])
  every(Task/Simple.., isa= [/Catln/Doc/DShow])
    # A task is shown in the webdocs as the task it is, rather than as the declaration it was read
      into: a box to check and the writing beside it. It is the value itself that is shown, with no
      display type standing in for it, which is what lets checking the box in a doc server write the
      change back to the note the task was read from.

  annot(#taskList)

  data(Show/TaskList(tasks -> String))
    # [Show/TaskList] shows the tasks of every note it covers as one list. It carries them in
      [tasks], so the webdocs render the list from the compiled value rather than asking the compiler
      for it over a separate route. Each entry is the [Task] value itself, beside the page it was
      written in and the expression it was declared by. Those last two are what a list across notes
      needs and a note's own page does not: a task shown on its page is edited by naming the
      expression that page holds, where a task shown in a list has no such page, so it carries its
      own. That is what lets checking a box in the list write the note the task was read from rather
      than whatever is displaying it.
      Like [/Catln/Doc/Show/Sidebar] it is about which pages there are rather than about the program
      it is evaluated against, so the list of every task there is, is evaluated unscoped; written in
      a page it lists the tasks of what that page reaches.

  every(Show/TaskList.., isa= [/Catln/Doc/DShow])

  /Catln/Doc/dshow(s= #taskList) =
    taskList(annot) -> String
      # [taskList] renders the tasks of the pages the evaluation covers as JSON, each beside the page
        it was written in and the expression it was declared by. They are read exactly as a note's own
        page reads them, so a task in this list and the same task shown on its page are one value,
        shown one way, and edited by replacing one expression.
      #runtime("taskList")

    Show/TaskList(tasks= taskList(annot= s))

  annot(#properties(text -> String))

  data(Show/Properties(text -> String))
    # [Show/Properties] shows the properties a note opens with: the block of @key: value@ lines
      written above the writing, as the table it reads as. It carries that block as the [text] it
      was written as rather than as the properties read out of it, because writing the note back
      writes the block again — reading it apart into fields here would be reading it apart in the
      one place that has to give it back exactly as it was found.
      A block naming a page on the web is read as a [/Catln/Doc/#overlay] of it as well, which is
      the page the note is written over. That is a second reading of the same block, made where
      the note is read rather than here: this shows what the note says, and the overlay is what
      the note says it is about.

  every(Show/Properties.., isa= [/Catln/Doc/DShow])

  /Catln/Doc/dshow(s= #properties(text))= Show/Properties(text= text)
