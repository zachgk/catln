import "core/compile.ct"


module(Catln/Doc)
  # # Catln WebDocs
    This provides common components and annotations used in Webdocs.
    These include the ones
  class(DShow)
    # Represents objects which can be shown in the webdocs.

  dshow(s -> DShow)= s
    # [dshow] resolves a value or annotation to its [DShow] display form. The identity arm passes a
      value that is already [DShow] straight through; the arms below turn compiler annotations (like
      [#md] or [#type]) into their visualization types.

  every(String, isa= [/Catln/Doc/DShow])
  every(CatlnResult.., isa= [/Catln/Doc/DShow])
  every(/Data/ToString, isa= [/Catln/Doc/DShow])
    # Every [/Data/ToString] value is displayable, so [ToString] is a subset of [DShow]: the
      webdocs render such a value through its [/Data/toString]. This is what lets a `> value`
      print statement accept any [ToString] type. A [DShow] value that is not [ToString] (a
      visualization like [Show/MD]) is still printable, but only [ToString] values are compared
      against a print/result golden.

  data(Show/MD(text -> String))

  every(Show/MD.., isa= [/Catln/Doc/DShow])

  dshow(s= #md(text))= Show/MD(text= text)
  dshow(s= #print(p))= p

  class(ListProgramMode, [Desugar, Typecheck, TreeBuild])
    # Which compiler stage a [#listProgram] lists: the program before typechecking, after
      typechecking, or after tree building.

  annot(#listProgram(mode -> ListProgramMode))

  data(Show/ListProgram(prgm -> String, mode -> ListProgramMode))
    # [Show/ListProgram] lists every declaration and definition of a program. It carries the
      program it lists in [prgm], so the webdocs render the page from the compiled value itself
      rather than asking the compiler for it over a separate route. The [mode] it was listed for
      travels with it, so the page's stage selector reads the annotation rather than holding its
      own state.

  every(Show/ListProgram.., isa= [/Catln/Doc/DShow])

  dshow(s= #listProgram(mode)) =
    listProgram(annot) -> String
      # [listProgram] renders the program being evaluated as JSON, at the compiler stage its
        [mode] names. The program is the one the annotation was evaluated against, so a
        [#listProgram] in a page lists that page and everything it reaches, at every stage alike.
      #runtime("listProgram")

    Show/ListProgram(prgm= listProgram(annot= s), mode= mode)

  annot(#type(name -> String))

  data(Show/TypePage(prgm -> String, name -> String))
    # [Show/TypePage] lists the declarations and definitions of a single type or class. Like
      [Show/ListProgram] it carries the listing it shows in [prgm], so the webdocs render the page
      from the compiled value rather than asking the compiler for it over a separate route. The
      [name] it was filtered by travels with it so the page can title itself.

  every(Show/TypePage.., isa= [/Catln/Doc/DShow])

  dshow(s= #type(name)) =
    filterProgram(annot) -> String
      # [filterProgram] renders the declarations and definitions of [name] as JSON. It is
        [listProgram] narrowed to one name, over the same program the annotation was evaluated
        against.
      #runtime("filterProgram")

    Show/TypePage(prgm= filterProgram(annot= s), name= name)

  annot(#typeInfer)

  data(Show/TypeInfer(constrain -> String))
    # [Show/TypeInfer] shows how the program's types were inferred. It carries that program in
      [constrain], with a type variable on every meta, so the webdocs render the page from the
      compiled value rather than asking the compiler for it over a separate route.

  every(Show/TypeInfer.., isa= [/Catln/Doc/DShow])

  dshow(s= #typeInfer) =
    typeInfer(annot) -> String
      # [typeInfer] renders the type inference of the program being evaluated as JSON, paired with
        the notes its typecheck produced. Like [listProgram] it reports on whatever program the
        annotation was evaluated against. The trace of how each point was solved is not included;
        a point is asked for on its own through [#typeInferPnt].
      #runtime("typeInfer")

    Show/TypeInfer(constrain= typeInfer(annot= s))

  annot(#typeInferPnt(pnt -> Integer))

  data(Show/TypeInferPnt(trace -> String, pnt -> Integer))
    # [Show/TypeInferPnt] shows how one point of the type inference was solved: the constraints
      mentioning it, and what each epoch updated it to. It is the drill-down of a [Show/TypeInfer],
      which is a program's worth of points, and so is shown embedded within one. The [pnt] it was
      filtered by travels with it so the page can title itself.

  every(Show/TypeInferPnt.., isa= [/Catln/Doc/DShow])

  dshow(s= #typeInferPnt(pnt)) =
    typeInferPnt(annot) -> String
      # [typeInferPnt] renders the part of the same trace that touches [pnt] as JSON. Only that
        part: the whole trace records every update of every point in every epoch, and would dwarf
        the program it describes.
      #runtime("typeInferPnt")

    Show/TypeInferPnt(trace= typeInferPnt(annot= s), pnt= pnt)

  annot(#debugger(fun -> String))

  data(Show/Debugger(run -> String, fun -> String))
    # [Show/Debugger] shows a run of one of the program's functions: what it evaluated, what it
      printed, and what it exited with. It carries that run in [run], so the webdocs render the page
      from the compiled value rather than asking the compiler for it over a separate route. The
      [fun] it ran travels with it so the page can title itself.

  every(Show/Debugger.., isa= [/Catln/Doc/DShow])

  dshow(s= #debugger(fun)) =
    debugger(annot) -> String
      # [debugger] runs [fun] in the program being evaluated and renders the run as JSON. The
        program's output is captured rather than printed, so showing a run inside a doc server does
        not write the run's output to the server's own stdout.
      #runtime("debugger")

    Show/Debugger(run= debugger(annot= s), fun= fun)
