import "core/bool.ct"
import "core/eq.ct"
import "core/ord.ct"
import "core/cons.ct"


module(Data)
  # # Strings
    A [String] is a list of characters. Its equality is defined here alongside the type.
  data(String)
  data(Char)
    # A [Char] is a single character.
      It is declared beside [String] because it is a primitive of the same kind: the compiler names
      it as one, in `Semantics.Types.charLeaf`, and an evaluation carries one as a `CharVal`. A tree
      build makes a [Char] out of a character constant, and the test generator produces them. So the
      type was already being handed to programs and read back from them; what was missing was the
      declaration saying so, and until it was written the name `/Data/Char` referred to nothing and
      was open to the world.
      A [Char] is written as a literal between single quotes: `'a'`, or an escape such as `'\n'`.
      A [String] is not yet a list of [Char] but a primitive of its own — which is why [String] is
      declared above rather than as `/Data/List[$T -> Char]`.

  # ## Characters
    A [Char] is ordered by its Unicode code point, which is also what [code] answers with. The
    primitives comparing two are named functions, so [CharOrdering] can build a [Comparison] from
    them the way [/Data/Primitive/IntOrdering] does from the integer ones.
  charLt(l -> Char, r -> Char) -> Boolean
    #runtime("charLt")

  charEq(l -> Char, r -> Char) -> Boolean
    #runtime("charEq")

  every(Char, isa= [/Data/Algebra/Ord])

  data(CharOrdering, isa= [/Data/Algebra/Ordering[$T -> Char]])

  :CharOrdering.compare(a, b)= /Data/Algebra/mkComparison(lt= /Data/charLt(l= a, r= b), eq= /Data/charEq(l= a, r= b))

  :Char.ord= CharOrdering

  :Char.compareTo(other)= this.ord.compare(a= this, b= other)

  :Char.eq= CharOrdering

  :Char.equal(other)= this.eq.rel(a= this, b= other)

  :Char.code -> Integer
    # [code] is the character's Unicode code point.
    #runtime("charCode")

  fromCode(code -> Integer) -> Char
    # [fromCode] is the character at the Unicode code point [code]. A number that is no code point
      fails the evaluation rather than answering with some other character.
    #runtime("charFromCode")

  every(Char, isa= [/Data/ToString])

  :Char.toString -> String
    #runtime("charToString")

  > ('a' == 'a')
    >>> True
  > ('a' == 'b')
    >>> False
  > 'a'.compareTo(other= 'b').isLess
    >>> True
  > 'a'.code
    >>> 97
  > fromCode(code= 98)
    >>> b
  strEqual(l -> String, r -> String) -> Boolean
    #runtime("strEq")

  # ## Equality
    [String] is an [Eq] type: [StrEqv] wraps the primitive [strEqual], and [eq]/[equal] follow.
  every(String, isa= [/Data/Algebra/Eq])

  data(StrEqv, isa= [/Data/Algebra/Eqv[$T -> String]])

  :StrEqv.rel(a, b)= /Data/strEqual(l= a, r= b)

  :String.eq= StrEqv

  :String.equal(other)= this.eq.rel(a= this, b= other)

  > ("hi" == "hi")
    >>> True
  > ("hi" == "no")
    >>> False
  # ## Concatenation
  every(String, isa= [/Data/Algebra/Semigroup])
    # [String] is a [Semigroup] under concatenation: joining strings end to end is associative.
      (Conceptually it is also a [Monoid] with the empty string as identity, but [mempty] is not
      yet dispatched by return type across multiple types, so only the [Semigroup] is declared.)

  (_ :: String ++ _ :: String) -> String
    # [operator++] joins two strings, the [Semigroup] operation on [String].
    #runtime("strConcat")

  > ("foo" ++ "bar")
    >>> foobar
