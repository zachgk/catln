import "core/bool.ct"
import "core/eq.ct"
import "core/ord.ct"
import "core/cons.ct"


module(Data)
  # # Strings
    A [String] is a list of characters: a [String/Text], whose one field [chars] holds them in
    order. So a string is taken apart and built up the way any list is, character by character.
    It is a type of its own holding a list rather than the list itself. A list is displayed as its
    items in brackets and a string as its text, and an empty string is not an empty list of
    anything else — neither of which could be told apart at runtime were a string only its list.
    [String] is a class with the one member rather than a data type so that [String] written as a
    type means every string: a data type's bare name means its argument-less form, which a string
    with characters is not.
    Only the type is declared here. What a string does — comparing two, joining two — is written
    over its characters on @core/string.ct@, a page of its own so that @core/list.ct@, which builds
    a list's text out of strings, can import it without this page's group reaching
    @core/list.ct@ (see @core/cons.ct@).
  class(String, [String/Text(chars -> /Data/List/ConsList[$T -> Char])])

  data(Char)
    # A [Char] is a single character.
      It is declared beside [String], which is made of them. A [Char] is a primitive: the compiler
      names it as one, in `Semantics.Types.charLeaf`, and an evaluation carries one as a `CharVal`. A tree
      build makes a [Char] out of a character constant, and the test generator produces them. So the
      type was already being handed to programs and read back from them; what was missing was the
      declaration saying so, and until it was written the name `/Data/Char` referred to nothing and
      was open to the world.
      A [Char] is written as a literal between single quotes: `'a'`, or an escape such as `'\n'`.

  # ## Characters
    A [Char] is ordered by its Unicode code point, which is also what [code] answers with. The
    primitives comparing two are named functions, so [CharOrdering] can build a [Comparison] from
    them the way [/Data/Primitive/IntOrdering] does from the integer ones.
  charLt(l -> Char, r -> Char) -> Boolean
    #runtime("charLt")

  charEq(l -> Char, r -> Char) -> Boolean
    #runtime("charEq")

  every(Char, isa= [/Data/Algebra/Ord])

  data(CharOrdering, isa= [/Data/Algebra/Ordering[$T -> Char]])

  :CharOrdering.compare(a, b)= /Data/Algebra/mkComparison(lt= /Data/charLt(l= a, r= b), eq= /Data/charEq(l= a, r= b))

  :Char.ord= CharOrdering

  :Char.compareTo(other)= this.ord.compare(a= this, b= other)

  :Char.eq= CharOrdering

  :Char.equal(other)= this.eq.rel(a= this, b= other)

  :Char.code -> Integer
    # [code] is the character's Unicode code point.
    #runtime("charCode")

  fromCode(code -> Integer) -> Char
    # [fromCode] is the character at the Unicode code point [code]. A number that is no code point
      fails the evaluation rather than answering with some other character.
    #runtime("charFromCode")

  every(Char, isa= [/Data/ToString])

  :Char.toString -> String
    #runtime("charToString")

  > ('a' == 'a')
    >>> True
  > ('a' == 'b')
    >>> False
  > 'a'.compareTo(other= 'b').isLess
    >>> True
  > 'a'.code
    >>> 97
  > fromCode(code= 98)
    >>> b
