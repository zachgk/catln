import "core/eq.ct"
import "core/data.ct"


module(Data/Primitive)
  # # Booleans
    [Boolean] is the type of truth values — [True] and [False] — with the standard logical
    operators. Its equality is defined here alongside the type.
  class(Boolean, [True, False])

  # [boolEq] is the primitive truth-table equality on [Boolean]s; [BoolEqv] and [equal] below build
  #   on it.
  boolEq(l -> Boolean, r -> Boolean) -> Boolean
  boolEq(l= True, r= True)= True
  boolEq(l= True, r= False)= False
  boolEq(l= False, r= True)= False
  boolEq(l= False, r= False)= True

  (~(_ :: Boolean)) -> Boolean
    # [operator~] is logical negation: it swaps [True] and [False].
  (~(_ :: True))= False
  (~(_ :: False))= True

  > (~True)
    >>> False
  (_ :: Boolean && _ :: Boolean) -> Boolean
    # [operator&&] is logical conjunction: [True] only when both operands are [True].
  (_ :: True && _ :: True)= True
  (_ :: Boolean && _ :: False)= False
  (_ :: False && _ :: Boolean)= False

  > (True && True)
    >>> True
  > (True && False)
    >>> False
  (_ :: Boolean || _ :: Boolean) -> Boolean
    # [operator||] is logical disjunction: [True] when either operand is [True].
  (_ :: True || _ :: Boolean)= True
  (_ :: Boolean || _ :: True)= True
  (_ :: False || _ :: False)= False

  > (False || True)
    >>> True
  > (False || False)
    >>> False
  (_ :: Boolean ^ _ :: Boolean) -> Boolean
    # [operator^] is exclusive-or: [True] exactly when the operands differ.
  (_ :: True ^ _ :: True)= False
  (_ :: True ^ _ :: False)= True
  (_ :: False ^ _ :: True)= True
  (_ :: False ^ _ :: False)= False

  > (True ^ False)
    >>> True
  > (True ^ True)
    >>> False
  every(Boolean, isa= [/Data/Enum])

  # ## Equality
    [Boolean] is an [Eq] type: [BoolEqv] wraps the primitive [boolEq], and [eq]/[equal] follow.
  every(Boolean, isa= [/Data/Algebra/Eq])

  data(BoolEqv, isa= [/Data/Algebra/Eqv[$T -> Boolean]])

  :BoolEqv.rel(a, b)= /Data/Primitive/boolEq(l= a, r= b)

  :Boolean.eq= BoolEqv

  :Boolean.equal(other)= this.eq.rel(a= this, b= other)

  > (True == True)
    >>> True
  > (True == False)
    >>> False
  # ## Rendering as text
  every(Boolean, isa= [/Data/ToString])
    # A [Boolean] renders as the text of its constructor.

  :True.toString= "True"
  :False.toString= "False"

  > True
    >>> True
  > False
    >>> False
