import "core/ord.ct"
import "core/functor.ct"
import "core/monad.ct"


module(Data)
  # # Maybe
    A [Maybe] holds either a single value ([Some]) or nothing ([Nothing]). Unlike a [ConsList] it is
    not recursive, so it is the simplest parameterized type on which to define structural equality
    and ordering.
  class(Maybe[$T], [Some[$T -> $_T](value -> $T), Nothing])
    # A [Maybe] is created either by wrapping a value with [Some] or with the empty [Nothing].

# # Maybe equality and ordering examples
module(Data/Maybe)
  # A [Maybe] of any [Eq] element is an [Eq] member (see the end of this file), so [operator==]
  #   checks both arms structurally.
  > (/Data/Some(value= 1) == /Data/Some(value= 1))
    >>> True
  > (/Data/Some(value= 1) == /Data/Some(value= 2))
    >>> False
  # A [Maybe] of any [Ord] element is an [Ord] member (see the end of this file), so [compareTo]
  #   orders both arms structurally, with [Nothing] before any [Some].
  > /Data/Some(value= 1).compareTo(other= /Data/Some(value= 2)).isLess
    >>> True
  > /Data/Some(value= 2).compareTo(other= /Data/Some(value= 2)).isEq
    >>> True
  > /Data/Some(value= 1).compareTo(other= /Data/Nothing).isGreater
    >>> True

# # Maybe Eq membership
  Makes a [Maybe] of any [Eq] element a proper member of [Eq], so the generic [operator==]
  dispatches through the [equal] method. Two [Maybe]s are equal when both are [Nothing], or both
  are [Some] of equal values. Mirrors the [ConsList] membership in [Data/list].
module(Data)
  every(Maybe[$T -> /Data/Algebra/Eq], isa= [/Data/Algebra/Eq])
module(Data/Algebra)
  :/Data/Nothing.equal(other= /Data/Nothing)= True
  :/Data/Nothing.equal(other= /Data/Some(value))= False
  :/Data/Some(value).equal(other= /Data/Nothing)= False
  :/Data/Some[$T -> /Data/Algebra/Eq](value@av).equal(other= /Data/Some(value@bv))= av == bv

# # Maybe Ord membership
  Makes a [Maybe] of any [Ord] element a proper member of [Ord], so [compareTo] dispatches per
  constructor. A [Maybe] of [Ord] elements is ordered with [Nothing] before any [Some], and two
  [Some]s ordered by their wrapped values. Mirrors the [Eq] membership above (and every [Ord] is an
  [Eq], which the [Eq] membership already supplies).
module(Data)
  every(Maybe[$T -> /Data/Algebra/Ord], isa= [/Data/Algebra/Ord])
module(Data/Algebra)
  :/Data/Nothing.compareTo(other= /Data/Nothing)= /Data/Algebra/Equal
  :/Data/Nothing.compareTo(other= /Data/Some(value))= /Data/Algebra/LessThan
  :/Data/Some(value).compareTo(other= /Data/Nothing)= /Data/Algebra/GreaterThan
  :/Data/Some[$T -> /Data/Algebra/Ord](value@av).compareTo(other= /Data/Some(value@bv))= av.compareTo(other= bv)

# # Maybe Functor instance
  Makes a [Maybe] a [Functor]: [fmap] applies a function to the wrapped value of a [Some] and
  leaves a [Nothing] unchanged. The instances are defined under the declaration's absolute name
  (see the [ConsList] instance in [Data/list] for the naming rationale).
module(Data)
  every(Maybe[$T -> $_T], isa= [/Data/Functor])
module(Data/Maybe)
  /Data/fmap(lst= Nothing, fn(v))= Nothing
  /Data/fmap(lst= /Data/Some(value), fn(v))= /Data/Some(value= fn(v= value))

# # Maybe Monad instance
  Makes a [Maybe] a [Monad]: [mmap] applies a value-to-[Maybe] function to the wrapped value of a
  [Some] (returning whatever [Maybe] the function produces, which flattens the two layers into one),
  and short-circuits a [Nothing] unchanged. Mirrors the [Functor] instance above; the definitions
  are written under the declaration's absolute name (see the [ConsList] instance in [Data/list] for
  the naming rationale).
module(Data)
  every(Maybe[$T -> $_T], isa= [/Data/Monad])
module(Data/Maybe)
  /Data/mmap(m= Nothing, fn(v))= Nothing
  /Data/mmap(m= /Data/Some(value), fn(v))= fn(v= value)

  # [mmap] binds through the [Some] arm (its result is whatever [Maybe] the function returns) and
  #   short-circuits the [Nothing] arm. [Maybe] is already an [Eq] member (see above), so the
  #   flattened result compares with [operator==]. (A function whose body computes the wrapped
  #   value, e.g. [Some(value= v + 1)], is not yet comparable — a pre-existing gap unrelated to
  #   [Monad]; see the note in [Data/monad].)
  > (mmap(m= /Data/Some(value= 5), fn(v)= /Data/Some(value= 6)) == /Data/Some(value= 6))
    >>> True
  > (mmap(m= /Data/Some(value= 5), fn(v)= /Data/Nothing) == /Data/Nothing)
    >>> True
  > (mmap(m= /Data/Nothing, fn(v)= /Data/Some(value= v)) == /Data/Nothing)
    >>> True
  # [pure] for [Maybe] wraps the value in a [Some]; the call site's expected [Maybe] type selects
  #   this instance (return-type-directed dispatch — see [pure] in [Data/monad]).
  /Data/pure[$M -> /Data/Maybe[$T -> $_T]](v)= /Data/Some(value= v)

  pureSomeInt(v -> Integer) -> /Data/Some[$T -> Integer]
  pureSomeInt(v)= /Data/pure(v= v)

  > (pureSomeInt(v= 5) == /Data/Some(value= 5))
    >>> True
