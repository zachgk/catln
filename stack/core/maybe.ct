import "core/ord.ct"
import "core/functor.ct"


module(Data)
  # # Maybe
    A [Maybe] holds either a single value ([Some]) or nothing ([Nothing]). Unlike a [ConsList] it is
    not recursive, so it is the simplest parameterized type on which to define structural equality
    and ordering.
  class(Maybe[$T], [Some[$T -> $_T](value -> $T), Nothing])
    # A [Maybe] is created either by wrapping a value with [Some] or with the empty [Nothing].

  # #### Structural equality
    Two [Maybe]s of [Eq] elements are equal when both are [Nothing], or both are [Some] of equal
    values. [maybeEqual] is the structural comparison — a plain standalone function, mirroring
    [consEqual] but with no self-recursion (a [Maybe] never nests). The [Eq] membership and [equal]
    method at the end of this file delegate [operator==] into it.
  maybeEqual(a -> Maybe[$T -> /Data/Algebra/Eq], b -> Maybe[$T -> /Data/Algebra/Eq]) -> Boolean
  maybeEqual(a= Nothing, b= Nothing)= True
  maybeEqual(a= Nothing, b= /Data/Some(value))= False
  maybeEqual(a= /Data/Some(value), b= Nothing)= False
  maybeEqual(a= /Data/Some(value@av), b= /Data/Some(value@bv))= av == bv

  # #### Structural comparison
    A [Maybe] of [Ord] elements is ordered with [Nothing] before any [Some], and two [Some]s ordered
    by their wrapped values. [maybeCompare] is the structural comparison, mirroring [maybeEqual].
  maybeCompare(a -> Maybe[$T -> /Data/Algebra/Ord], b -> Maybe[$T -> /Data/Algebra/Ord]) -> /Data/Algebra/Comparison
  maybeCompare(a= Nothing, b= Nothing)= /Data/Algebra/Equal
  maybeCompare(a= Nothing, b= /Data/Some(value))= /Data/Algebra/LessThan
  maybeCompare(a= /Data/Some(value), b= Nothing)= /Data/Algebra/GreaterThan
  maybeCompare(a= /Data/Some(value@av), b= /Data/Some(value@bv))= av.compareTo(other= bv)

# # Maybe equality tests
module(Data/Maybe)
  # A [Maybe] of any [Eq] element is an [Eq] member (see the end of this file), so [operator==]
  # checks both arms structurally.
  testEqSomeSomeEq =
    #test
    #assert(test= /Data/Some(value= 1) == /Data/Some(value= 1))
    0

  testEqSomeSomeNeq =
    #test
    #assert(test= ~(/Data/Some(value= 1) == /Data/Some(value= 2)))
    0

  # A [Maybe] of any [Ord] element is an [Ord] member (see the end of this file), so [compareTo]
  # orders both arms structurally, with [Nothing] before any [Some].
  testOrdMaybe =
    #test
    #assert(test= /Data/Some(value= 1).compareTo(other= /Data/Some(value= 2)).isLess)
    #assert(test= /Data/Some(value= 2).compareTo(other= /Data/Some(value= 2)).isEq)
    #assert(test= /Data/Some(value= 1).compareTo(other= /Data/Nothing).isGreater)
    0

# # Maybe Eq membership
  Makes a [Maybe] of any [Eq] element a proper member of [Eq], so the generic [operator==]
  dispatches through the [equal] method into [maybeEqual]. Mirrors the [ConsList] membership
  in [Data/list].
module(Data)
  every(Maybe[$T -> /Data/Algebra/Eq], isa= [/Data/Algebra/Eq])
module(Data/Algebra)
  :/Data/Nothing.equal(other -> /Data/Maybe[$E -> /Data/Algebra/Eq])= /Data/maybeEqual(a= /Data/Nothing, b= other)
  :/Data/Some[$T -> /Data/Algebra/Eq](value).equal(other -> /Data/Maybe[$E -> /Data/Algebra/Eq])= /Data/maybeEqual(a= /Data/Some(value= value), b= other)

# # Maybe Ord membership
  Makes a [Maybe] of any [Ord] element a proper member of [Ord], so [compareTo] dispatches per
  constructor into [maybeCompare]. Mirrors the [Eq] membership above (and every [Ord] is an
  [Eq], which the [Eq] membership already supplies).
module(Data)
  every(Maybe[$T -> /Data/Algebra/Ord], isa= [/Data/Algebra/Ord])
module(Data/Algebra)
  :/Data/Nothing.compareTo(other -> /Data/Maybe[$E -> /Data/Algebra/Ord])= /Data/maybeCompare(a= /Data/Nothing, b= other)
  :/Data/Some[$T -> /Data/Algebra/Ord](value).compareTo(other -> /Data/Maybe[$E -> /Data/Algebra/Ord])= /Data/maybeCompare(a= /Data/Some(value= value), b= other)

# # Maybe Functor instance
  Makes a [Maybe] a [Functor]: [fmap] applies a function to the wrapped value of a [Some] and
  leaves a [Nothing] unchanged. The instances are defined under the declaration's absolute name
  (see the [ConsList] instance in [Data/list] for the naming rationale).
module(Data)
  every(Maybe[$T -> $_T], isa= [/Data/Functor])
module(Data/Maybe)
  /Data/fmap(lst= Nothing, fn(v))= Nothing
  /Data/fmap(lst= /Data/Some(value), fn(v))= /Data/Some(value= fn(v= value))
