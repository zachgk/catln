import "core/bool.ct"
import "core/eq.ct"
import "core/ord.ct"
import "core/cons.ct"
import "core/char.ct"


module(Data)
  # # Strings
    A [String] is a list of characters: a [String/Text], whose one field [chars] holds them in
    order. So a string is taken apart and built up the way any list is, character by character.
    It is a type of its own holding a list rather than the list itself. A list is displayed as its
    items in brackets and a string as its text, and an empty string is not an empty list of
    anything else — neither of which could be told apart at runtime were a string only its list.
    [String] is a class with the one member rather than a data type so that [String] written as a
    type means every string: a data type's bare name means its argument-less form, which a string
    with characters is not.
    Everything a string does is written here over the list of its characters. The operations
    recur over the characters directly rather than through the list operations of @core/list.ct@,
    which builds a list's text out of strings and so imports this page.
  class(String, [String/Text(chars -> /Data/List/ConsList[$T -> Char])])

  every(Char, isa= [/Data/ToString])

  :Char.toString -> String
    #runtime("charToString")

  > 'a'.toString
    >>> a
  # ## Equality
    Two strings are equal when their characters are, one by one, through [/Data/CharOrdering].
  charsEqual(a -> /Data/List/ConsList[$T -> Char], b -> /Data/List/ConsList[$T -> Char]) -> Boolean
    # [charsEqual] is whether [a] and [b] hold the same characters in the same order. It stops at
      the first pair that differs.
  charsEqual(a= /Data/List/Nil, b= /Data/List/Nil)= True
  charsEqual(a= /Data/List/Nil, b= /Data/List/Cons(head, tail))= False
  charsEqual(a= /Data/List/Cons(head, tail), b= /Data/List/Nil)= False
  charsEqual(a= /Data/List/Cons(head@ah, tail@at), b= /Data/List/Cons(head@bh, tail@bt)) | ah == bh= charsEqual(a= at, b= bt)
  charsEqual(a= /Data/List/Cons(head@ah, tail@at), b= /Data/List/Cons(head@bh, tail@bt)) else = False

  every(String, isa= [/Data/Algebra/Eq])

  data(StrEqv, isa= [/Data/Algebra/Eqv[$T -> String]])

  :StrEqv.rel(a= String/Text(chars@ac), b= String/Text(chars@bc))= charsEqual(a= ac, b= bc)

  :String.eq= StrEqv

  :String.equal(other)= this.eq.rel(a= this, b= other)

  > ("hi" == "hi")
    >>> True
  > ("hi" == "no")
    >>> False
  > ("" == "")
    >>> True
  # ## Concatenation
  every(String, isa= [/Data/Algebra/Semigroup])
    # [String] is a [Semigroup] under concatenation: joining strings end to end is associative.
      (Conceptually it is also a [Monoid] with the empty string as identity, but [mempty] is not
      yet dispatched by return type across multiple types, so only the [Semigroup] is declared.)

  appendChars(l -> /Data/List/ConsList[$T -> Char], r -> /Data/List/ConsList[$T -> Char]) -> /Data/List/ConsList[$T -> Char]
    # [appendChars] is the characters of [l] followed by those of [r].
  appendChars(l= /Data/List/Nil, r)= r
  appendChars(l= /Data/List/Cons(head, tail), r)= /Data/List/Cons(head= head, tail= appendChars(l= tail, r= r))

  (_ :: String ++ _ :: String) -> String
    # [operator++] joins two strings, the [Semigroup] operation on [String]: the characters of the
      first followed by those of the second.
  (String/Text(chars@a) ++ String/Text(chars@b))= String/Text(chars= appendChars(l= a, r= b))

  > ("foo" ++ "bar")
    >>> foobar
