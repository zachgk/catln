import "core/bool.ct"
import "core/eq.ct"
import "core/ord.ct"
import "core/cons.ct"
import "core/char.ct"
import "core/maybe.ct"
import "core/list.ct"


module(Data)
  # # Strings
    A [String] is every string, held in any of the ways a string can be held. It is an open class
    of those representations, and two of them are declared here.
    A [String/Text] is a list of characters, whose one field [chars] holds them in order. So a
    string is taken apart and built up the way any list is, character by character. It is a type of
    its own holding a list rather than the list itself. A list is displayed as its items in
    brackets and a string as its text, and an empty string is not an empty list of anything else —
    neither of which could be told apart at runtime were a string only its list.
    A [/Catln/CStr] is a string as the interpreter holds one: packed, with nothing in it Catln can
    take apart. Every string written in a program is one, and so is every string a runtime
    primitive answers with, which is what lets a long string cost what its text does rather than a
    list cell per character.
    Every string converts to a [String/Text], so everything a string does is written here once,
    over the list of its characters, and works on any string: the tree build converts a [CStr] on
    the way into such a definition. The operations recur over the characters directly rather than
    through the list operations of @core/list.ct@.
    Most operations also have a [#runtime] arm over the [/Catln/CStr], written beside the one over
    the characters, which does the same on the packed text without taking it apart. Which of the two
    runs is the arm the string's representation reaches, and the two are held to agree by the
    representation-agreement test derived for each pair.
  class(String)

  data(String/Text(chars -> /Data/List/ConsList[$T -> Char]))

  every(String/Text.., isa= [/Data/String])

  data(/Catln/CStr)

  every(/Catln/CStr, isa= [/Data/String])

  (_ -> String) -> String/Text..
    # Every [String] converts to the [String/Text] holding its characters, which is what lets a
      string operation be written once over them.

  /Catln/CStr -> String/Text..
    # A [/Catln/CStr] as the list of its characters.
    #runtime("cstrToText")

  String/Text(chars) -> /Catln/CStr
    # A [String/Text] packed, which is the string a runtime primitive is declared to take.
    #runtime("textToCStr")

  every(Char, isa= [/Data/ToString])

  :Char.toString= String/Text(chars= /Data/List/Cons(head= this, tail= /Data/List/Nil))
    # A [Char] renders as the string holding only it.

  > 'a'.toString
    >>> a
  # ## Equality
    Two strings are equal when their characters are, one by one, through [/Data/CharOrdering].
  charsEqual(a -> /Data/List/ConsList[$T -> Char], b -> /Data/List/ConsList[$T -> Char]) -> Boolean
    # [charsEqual] is whether [a] and [b] hold the same characters in the same order. It stops at
      the first pair that differs.
  charsEqual(a= /Data/List/Nil, b= /Data/List/Nil)= True
  charsEqual(a= /Data/List/Nil, b= /Data/List/Cons(head, tail))= False
  charsEqual(a= /Data/List/Cons(head, tail), b= /Data/List/Nil)= False
  charsEqual(a= /Data/List/Cons(head@ah, tail@at), b= /Data/List/Cons(head@bh, tail@bt)) | ah == bh= charsEqual(a= at, b= bt)
  charsEqual(a= /Data/List/Cons(head@ah, tail@at), b= /Data/List/Cons(head@bh, tail@bt)) else = False

  every(String, isa= [/Data/Algebra/Eq])

  data(StrEqv, isa= [/Data/Algebra/Eqv])

  :StrEqv.rel(a= String/Text(chars@ac), b= String/Text(chars@bc))= charsEqual(a= ac, b= bc)
  :StrEqv.rel(a -> /Catln/CStr, b -> /Catln/CStr)= cstrEqual(a= a, b= b)

  cstrEqual(a -> /Catln/CStr, b -> /Catln/CStr) -> Boolean
    # [cstrEqual] is whether two packed strings hold the same characters.
    #runtime("cstrEqual")

  :String.eq= StrEqv

  :String.equal(other)= this.eq.rel(a= this, b= other)

  > ("hi" == "hi")
    >>> True
  > ("hi" == "no")
    >>> False
  > ("" == "")
    >>> True
  # ## Concatenation
  every(String, isa= [/Data/Algebra/Semigroup])
    # [String] is a [Semigroup] under concatenation: joining strings end to end is associative.
      (Conceptually it is also a [Monoid] with the empty string as identity, but [mempty] is not
      yet dispatched by return type across multiple types, so only the [Semigroup] is declared.)

  appendChars(l -> /Data/List/ConsList[$T -> Char], r -> /Data/List/ConsList[$T -> Char]) -> /Data/List/ConsList[$T -> Char]
    # [appendChars] is the characters of [l] followed by those of [r].
  appendChars(l= /Data/List/Nil, r)= r
  appendChars(l= /Data/List/Cons(head, tail), r)= /Data/List/Cons(head= head, tail= appendChars(l= tail, r= r))

  (_ :: String ++ _ :: String) -> String
    # [operator++] joins two strings, the [Semigroup] operation on [String]: the characters of the
      first followed by those of the second.
  (String/Text(chars@a) ++ String/Text(chars@b))= String/Text(chars= appendChars(l= a, r= b))
  (_ :: /Catln/CStr ++ _ :: /Catln/CStr) -> /Catln/CStr
    #runtime("cstr++")

  > ("foo" ++ "bar")
    >>> foobar
  # A string ending in a newline prints its last line empty.
  > ("foo" ++ "\n")
    >>> foo
    >>>
  # ## Numbers as text
  :Integer.toStringBase(base -> Integer) -> String
    # [toStringBase] writes the number in [base] (2 to 36), with the digits of [digitChar] and a
      leading `-` when it is negative.
  :Integer.toStringBase(base) | this < 0= "-" ++ (0 - this).toStringBase(base= base)
  :Integer.toStringBase(base) else  =
    digitsOnto(n -> Integer, acc -> /Data/List/ConsList[$T -> Char]) -> /Data/List/ConsList[$T -> Char]
    digitsOnto(n, acc) | n < base= /Data/List/Cons(head= digitChar(digit= n), tail= acc)
    digitsOnto(n, acc) else = digitsOnto(n= n // base, acc= /Data/List/Cons(head= digitChar(digit= n % base), tail= acc))

    String/Text(chars= digitsOnto(n= this, acc= /Data/List/Nil))

  > 255.toStringBase(base= 16)
    >>> ff
  > 5.toStringBase(base= 2)
    >>> 101
  > 0.toStringBase(base= 10)
    >>> 0
  > (0 - 42).toStringBase(base= 10)
    >>> -42
  # ## Floats as text
    A [Float] is written with the fewest decimal digits that read back as the same number, and in
    the notation Haskell's @show@ writes it in, so that text written by earlier versions of the
    language reads the same: @1.5@, @0.1@, @1234567.0@, and @1.0e-2@ or @1.0e7@ outside
    [0.1, 10^7).
    The digits are Burger and Dybvig's free-format algorithm, as GHC's @floatToDigits@ writes it,
    worked in whole numbers over the [/Data/Primitive/FloatParts] of the number: its magnitude is
    [mantissa] × 2^[exponent], and a double has 53 bits of mantissa and a least exponent of -1074.
  intPower(base -> Integer, n -> Integer) -> Integer
    # [intPower] is [base] raised to the whole power [n], and 1 for no power: squared at each even
      power, so it takes as many steps as [n] has bits.
  intPower(base, n) | n <= 0= 1
  intPower(base, n) | n > 0 && n % 2 == 0= squared(v= intPower(base= base, n= n // 2))
  intPower(base, n) else = base * intPower(base= base, n= n - 1)

  squared(v -> Integer) -> Integer
    # [squared] is [v] times itself.
  squared(v)= v * v

  shortestDigits(mantissa -> Integer, exponent -> Integer) -> String
    # [shortestDigits] writes the positive number [mantissa] × 2^[exponent] with the fewest decimal
      digits that read back as it. A subnormal mantissa is first brought to the least exponent.
  shortestDigits(mantissa, exponent) | (0 - 1074) - exponent > 0= scaledDigits(f= mantissa // intPower(base= 2, n= (0 - 1074) - exponent), e= 0 - 1074)
  shortestDigits(mantissa, exponent) else = scaledDigits(f= mantissa, e= exponent)

  scaledDigits(f -> Integer, e -> Integer) -> String
    # [scaledDigits] sets up the digit generation for [f] × 2^[e]: the number and its scale as the
      fraction [r] / [s], and the distance [mUp] / [s] and [mDn] / [s] to its neighbours above and
      below, which are unequal where [f] is the least mantissa of its exponent.
  scaledDigits(f, e) | e >= 0 && f == intPower(base= 2, n= 52)= boundedDigits(r= f * intPower(base= 2, n= e) * 4, s= 4, mUp= intPower(base= 2, n= e) * 2, mDn= intPower(base= 2, n= e), guess= pointGuess(e= e))
  scaledDigits(f, e) | e >= 0 && f != intPower(base= 2, n= 52)= boundedDigits(r= f * intPower(base= 2, n= e) * 2, s= 2, mUp= intPower(base= 2, n= e), mDn= intPower(base= 2, n= e), guess= pointGuess(e= e))
  scaledDigits(f, e) | e < 0 && e > 0 - 1074 && f == intPower(base= 2, n= 52)= boundedDigits(r= f * 4, s= intPower(base= 2, n= 1 - e) * 2, mUp= 2, mDn= 1, guess= pointGuess(e= e))
  scaledDigits(f, e) else = boundedDigits(r= f * 2, s= intPower(base= 2, n= 0 - e) * 2, mUp= 1, mDn= 1, guess= pointGuess(e= e))

  pointGuess(e -> Integer) -> Integer
    # [pointGuess] is near where the decimal point of a number [f] × 2^[e] falls, [f] having 53
      bits: its binary width times log10(2), which [pointFrom] then corrects either way.
  pointGuess(e)= ((e + 53) * 30103) // 100000

  boundedDigits(r -> Integer, s -> Integer, mUp -> Integer, mDn -> Integer, guess -> Integer) -> String
    # [boundedDigits] finds where the decimal point falls, searching from [guess], then generates
      the digits from there.
  boundedDigits(r, s, mUp, mDn, guess)= digitsFrom(r= r, s= s, mUp= mUp, mDn= mDn, k= pointFrom(r= r, s= s, mUp= mUp, n= guess))

  pointReached(r -> Integer, s -> Integer, mUp -> Integer, n -> Integer) -> Boolean
    # [pointReached] is whether the number's upper bound is at most 10^[n].
  pointReached(r, s, mUp, n) | n >= 0= r + mUp <= intPower(base= 10, n= n) * s
  pointReached(r, s, mUp, n) else = intPower(base= 10, n= 0 - n) * (r + mUp) <= s

  pointFrom(r -> Integer, s -> Integer, mUp -> Integer, n -> Integer) -> Integer
    # [pointFrom] is the least power of ten [pointReached] holds for, searched for from [n].
  pointFrom(r, s, mUp, n) | pointReached(r= r, s= s, mUp= mUp, n= n)= pointDown(r= r, s= s, mUp= mUp, n= n)
  pointFrom(r, s, mUp, n) else = pointFrom(r= r, s= s, mUp= mUp, n= n + 1)

  pointDown(r -> Integer, s -> Integer, mUp -> Integer, n -> Integer) -> Integer
    # [pointDown] steps down from a power of ten [pointReached] holds for to the least one.
  pointDown(r, s, mUp, n) | pointReached(r= r, s= s, mUp= mUp, n= n - 1)= pointDown(r= r, s= s, mUp= mUp, n= n - 1)
  pointDown(r, s, mUp, n) else = n

  digitsFrom(r -> Integer, s -> Integer, mUp -> Integer, mDn -> Integer, k -> Integer) -> String
    # [digitsFrom] scales the fraction by the point [k], generates its digits, and writes them with
      the decimal point [k] places into them: @0.d1 d2 …@ × 10^[k].
  digitsFrom(r, s, mUp, mDn, k) | k >= 0= floatDigitsText(digits= generateDigits(rn= r, sn= s * intPower(base= 10, n= k), mUp= mUp, mDn= mDn), point= k)
  digitsFrom(r, s, mUp, mDn, k) else = floatDigitsText(digits= generateDigits(rn= r * intPower(base= 10, n= 0 - k), sn= s, mUp= mUp * intPower(base= 10, n= 0 - k), mDn= mDn * intPower(base= 10, n= 0 - k)), point= k)

  generateDigits(rn -> Integer, sn -> Integer, mUp -> Integer, mDn -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [generateDigits] writes the next digit, and stops where the digits so far read back as the
      number from below, from above, or both (then the nearer).
  generateDigits(rn, sn, mUp, mDn)= nextDigit(dn= (rn * 10) // sn, rn2= (rn * 10) % sn, sn= sn, mUp= mUp * 10, mDn= mDn * 10)

  nextDigit(dn -> Integer, rn2 -> Integer, sn -> Integer, mUp -> Integer, mDn -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [nextDigit] is the digit [dn] with the remainder [rn2] still to write. Its guards are
      exclusive of one another, as a guard chain's arms are not tried in the order written.
  nextDigit(dn, rn2, sn, mUp, mDn) | rn2 < mDn && rn2 + mUp > sn && rn2 * 2 < sn= /Data/List/Cons(head= dn, tail= /Data/List/Nil)
  nextDigit(dn, rn2, sn, mUp, mDn) | rn2 < mDn && rn2 + mUp > sn && rn2 * 2 >= sn= /Data/List/Cons(head= dn + 1, tail= /Data/List/Nil)
  nextDigit(dn, rn2, sn, mUp, mDn) | rn2 < mDn && rn2 + mUp <= sn= /Data/List/Cons(head= dn, tail= /Data/List/Nil)
  nextDigit(dn, rn2, sn, mUp, mDn) | rn2 >= mDn && rn2 + mUp > sn= /Data/List/Cons(head= dn + 1, tail= /Data/List/Nil)
  nextDigit(dn, rn2, sn, mUp, mDn) else = /Data/List/Cons(head= dn, tail= generateDigits(rn= rn2, sn= sn, mUp= mUp, mDn= mDn))

  digitsText(ds -> /Data/List/ConsList[$T -> Integer]) -> /Data/List/ConsList[$T -> Char]
    # [digitsText] is the characters writing the decimal digits [ds].
  digitsText(ds= /Data/List/Nil)= /Data/List/Nil
  digitsText(ds= /Data/List/Cons(head, tail))= /Data/List/Cons(head= digitChar(digit= head), tail= digitsText(ds= tail))

  wholeDigits(ds -> /Data/List/ConsList[$T -> Integer], n -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [wholeDigits] is the first [n] digits of [ds], with zeros where it runs out.
  wholeDigits(ds, n) | n <= 0= /Data/List/Nil
  wholeDigits(ds, n) else = wholeDigit(ds= ds, n= n)

  wholeDigit(ds -> /Data/List/ConsList[$T -> Integer], n -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [wholeDigit] is [wholeDigits] past its first digit.
  wholeDigit(ds= /Data/List/Nil, n)= /Data/List/Cons(head= 0, tail= wholeDigits(ds= /Data/List/Nil, n= n - 1))
  wholeDigit(ds= /Data/List/Cons(head, tail), n)= /Data/List/Cons(head= head, tail= wholeDigits(ds= tail, n= n - 1))

  fractionDigits(ds -> /Data/List/ConsList[$T -> Integer], n -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [fractionDigits] is the digits of [ds] after its first [n], and a single zero where there
      are none.
  fractionDigits(ds, n) | n <= 0= atLeastZero(ds= ds)
  fractionDigits(ds, n) else = fractionDigit(ds= ds, n= n)

  fractionDigit(ds -> /Data/List/ConsList[$T -> Integer], n -> Integer) -> /Data/List/ConsList[$T -> Integer]
    # [fractionDigit] is [fractionDigits] past its first digit.
  fractionDigit(ds= /Data/List/Nil, n)= /Data/List/Cons(head= 0, tail= /Data/List/Nil)
  fractionDigit(ds= /Data/List/Cons(head, tail), n)= fractionDigits(ds= tail, n= n - 1)

  atLeastZero(ds -> /Data/List/ConsList[$T -> Integer]) -> /Data/List/ConsList[$T -> Integer]
    # [atLeastZero] is [ds], or a single zero where it is empty.
  atLeastZero(ds= /Data/List/Nil)= /Data/List/Cons(head= 0, tail= /Data/List/Nil)
  atLeastZero(ds= /Data/List/Cons(head, tail))= /Data/List/Cons(head= head, tail= tail)

  floatDigitsText(digits -> /Data/List/ConsList[$T -> Integer], point -> Integer) -> String
    # [floatDigitsText] writes the digits as Haskell's @show@ does: in fixed notation where the
      point falls within the first seven places, and as a mantissa and exponent otherwise.
  floatDigitsText(digits, point) | point < 0 || point > 7= String/Text(chars= /Data/appendChars(l= digitsText(ds= wholeDigits(ds= digits, n= 1)), r= /Data/List/Cons(head= '.', tail= digitsText(ds= fractionDigits(ds= digits, n= 1))))) ++ "e" ++ (point - 1).toStringBase(base= 10)
  floatDigitsText(digits, point) | point == 0= String/Text(chars= /Data/List/Cons(head= '0', tail= /Data/List/Cons(head= '.', tail= digitsText(ds= digits))))
  floatDigitsText(digits, point) else = String/Text(chars= /Data/appendChars(l= digitsText(ds= wholeDigits(ds= digits, n= point)), r= /Data/List/Cons(head= '.', tail= digitsText(ds= fractionDigits(ds= digits, n= point)))))

  floatText(parts -> /Data/Primitive/FloatParts) -> String
    # [floatText] writes a [Float] from its parts ([Float.parts]).
  floatText(parts= /Data/Primitive/FloatParts/NaN)= "NaN"
  floatText(parts= /Data/Primitive/FloatParts/Infinite(negative= /Data/Primitive/True))= "-Infinity"
  floatText(parts= /Data/Primitive/FloatParts/Infinite(negative= /Data/Primitive/False))= "Infinity"
  floatText(parts= /Data/Primitive/FloatParts/Finite(negative= /Data/Primitive/True, mantissa, exponent))= "-" ++ magnitudeText(mantissa= mantissa, exponent= exponent)
  floatText(parts= /Data/Primitive/FloatParts/Finite(negative= /Data/Primitive/False, mantissa, exponent))= magnitudeText(mantissa= mantissa, exponent= exponent)

  magnitudeText(mantissa -> Integer, exponent -> Integer) -> String
    # [magnitudeText] writes the non-negative number [mantissa] × 2^[exponent].
  magnitudeText(mantissa, exponent) | mantissa == 0= "0.0"
  magnitudeText(mantissa, exponent) else = shortestDigits(mantissa= mantissa, exponent= exponent)

  > floatText(parts= 1.5.parts)
    >>> 1.5
  > floatText(parts= 0.1.parts)
    >>> 0.1
  > floatText(parts= (0.1 + 0.2).parts)
    >>> 0.30000000000000004
  > floatText(parts= 1.0e-2.parts)
    >>> 1.0e-2
  > floatText(parts= 1234567.0.parts)
    >>> 1234567.0
  > floatText(parts= 1.0e7.parts)
    >>> 1.0e7
  > floatText(parts= 123.456.parts)
    >>> 123.456
  > floatText(parts= 100.0.parts)
    >>> 100.0
  > floatText(parts= (0.0 - 2.5).parts)
    >>> -2.5
  > floatText(parts= 0.0.parts)
    >>> 0.0
  # Each of these is what Haskell's @show@ writes for the same number: the least subnormal and the
  #   largest finite number, the least mantissa of an exponent (where the neighbours are unevenly
  #   spaced), either side of the edges of fixed notation, and @1.0e23@, whose shortest digits are
  #   not the ones it is written with.
  > floatText(parts= 5.0e-324.parts)
    >>> 5.0e-324
  > floatText(parts= 2.2250738585072014e-308.parts)
    >>> 2.2250738585072014e-308
  > floatText(parts= 1.7976931348623157e308.parts)
    >>> 1.7976931348623157e308
  > floatText(parts= 4.503599627370496e15.parts)
    >>> 4.503599627370496e15
  > floatText(parts= 9.007199254740992e15.parts)
    >>> 9.007199254740992e15
  > floatText(parts= 9.999999999999999e-2.parts)
    >>> 9.999999999999999e-2
  > floatText(parts= 9999999.0.parts)
    >>> 9999999.0
  > floatText(parts= 9999999.5.parts)
    >>> 9999999.5
  > floatText(parts= 1.0e22.parts)
    >>> 1.0e22
  > floatText(parts= 1.2345678901234568e17.parts)
    >>> 1.2345678901234568e17
  > floatText(parts= 1.0e-7.parts)
    >>> 1.0e-7
  > floatText(parts= 3.141592653589793.parts)
    >>> 3.141592653589793
  > floatText(parts= 9.999999999999999e22.parts)
    >>> 9.999999999999999e22
  # ## Ordering
    Strings are ordered the way a dictionary orders words: by their first characters that differ,
    and a string before any longer string it begins.
  every(String, isa= [/Data/Algebra/Ord])

  compareChars(a -> /Data/List/ConsList[$T -> Char], b -> /Data/List/ConsList[$T -> Char]) -> /Data/Algebra/Comparison
    # [compareChars] compares two lists of characters by their first pair that differs.
  compareChars(a= /Data/List/Nil, b= /Data/List/Nil)= /Data/Algebra/Equal
  compareChars(a= /Data/List/Nil, b= /Data/List/Cons(head, tail))= /Data/Algebra/LessThan
  compareChars(a= /Data/List/Cons(head, tail), b= /Data/List/Nil)= /Data/Algebra/GreaterThan
  compareChars(a= /Data/List/Cons(head@ah, tail@at), b= /Data/List/Cons(head@bh, tail@bt))= match(ah.compareTo(other= bh))
    c -> /Data/Algebra/Equal= compareChars(a= at, b= bt)
    c else = c

  data(StrOrdering, isa= [/Data/Algebra/Ordering])

  :StrOrdering.compare(a= String/Text(chars@ac), b= String/Text(chars@bc))= compareChars(a= ac, b= bc)
  :StrOrdering.compare(a -> /Catln/CStr, b -> /Catln/CStr)= cstrCompare(a= a, b= b)

  cstrCompare(a -> /Catln/CStr, b -> /Catln/CStr) -> /Data/Algebra/Comparison
    # [cstrCompare] compares two packed strings by their first characters that differ.
    #runtime("cstrCompare")

  :String.ord= StrOrdering

  :String.compareTo(other)= this.ord.compare(a= this, b= other)

  > "apple".compareTo(other= "banana").isLess
    >>> True
  > "pear".compareTo(other= "peach").isGreater
    >>> True
  > "ab".compareTo(other= "abc").isLess
    >>> True
  > "same".compareTo(other= "same").isEq
    >>> True
module(Data/String)
  # # What a string does
    The operations on a [String] live in the [/Data/String] namespace the type opens, as a
    list's do in [/Data/List], so that each type's [length] is a name of its own.
  # ## Size
  :/Data/String.length -> /Data/Primitive/Integer
    # [length] is how many characters the string holds.
  :/Data/String/Text(chars).length =
    countChars(cs -> /Data/List/ConsList[$T -> /Data/Char], n -> /Data/Primitive/Integer) -> /Data/Primitive/Integer
    countChars(cs= /Data/List/Nil, n)= n
    countChars(cs= /Data/List/Cons(head, tail), n)= countChars(cs= tail, n= n + 1)
    countChars(cs= chars, n= 0)
  :/Catln/CStr.length -> /Data/Primitive/Integer
    #runtime("cstrLength")

  > "hello".length
    >>> 5
  > "".length
    >>> 0
  > fromChars(chars= ['h', 'i']).length
    >>> 2
  :/Data/String.isEmpty -> /Data/Primitive/Boolean
    # [isEmpty] is whether the string holds no characters.
  :/Data/String/Text(chars= /Data/List/Nil).isEmpty= /Data/Primitive/True
  :/Data/String/Text(chars= /Data/List/Cons(head, tail)).isEmpty= /Data/Primitive/False
  :/Catln/CStr.isEmpty -> /Data/Primitive/Boolean
    #runtime("cstrIsEmpty")

  > "".isEmpty
    >>> True
  > "a".isEmpty
    >>> False
  # ## Characters
  fromChars(chars -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/String
    # [fromChars] is the string of the characters [chars], in order.
  fromChars(chars)= /Data/String/Text(chars= chars)

  :/Data/String.first -> /Data/Maybe[$T -> /Data/Char]
    # [first] is the string's first character, or [Nothing] for the empty string.
  :/Data/String/Text(chars= /Data/List/Nil).first= /Data/Maybe/Nothing
  :/Data/String/Text(chars= /Data/List/Cons(head, tail)).first= /Data/Maybe/Some(value= head)
  :/Catln/CStr.first -> /Data/Maybe[$T -> /Data/Char]
    #runtime("cstrFirst")

  :/Data/String.at(index -> /Data/Primitive/Integer) -> /Data/Maybe[$T -> /Data/Char]
    # [at] is the character at [index], counting the first as 0, or [Nothing] where the string has
      no character there.
  :/Data/String/Text(chars).at(index)= /Data/String/Text(chars= dropChars(cs= chars, n= index)).first
  :/Catln/CStr.at(index -> /Data/Primitive/Integer) -> /Data/Maybe[$T -> /Data/Char]
    #runtime("cstrAt")

  > (fromChars(chars= ['h', 'i']) == "hi")
    >>> True
  > ("hi".first == /Data/Maybe/Some(value= 'h'))
    >>> True
  > ("".first == /Data/Maybe/Nothing)
    >>> True
  > ("abc".at(index= 2) == /Data/Maybe/Some(value= 'c'))
    >>> True
  > ("abc".at(index= 3) == /Data/Maybe/Nothing)
    >>> True
  # ## Parts of a string
  takeChars(cs -> /Data/List/ConsList[$T -> /Data/Char], n -> /Data/Primitive/Integer) -> /Data/List/ConsList[$T -> /Data/Char]
    # [takeChars] is the first [n] characters of [cs], or all of them where it holds fewer.
  takeChars(cs= /Data/List/Nil, n)= /Data/List/Nil
  takeChars(cs= /Data/List/Cons(head, tail), n) | n <= 0= /Data/List/Nil
  takeChars(cs= /Data/List/Cons(head, tail), n) else = /Data/List/Cons(head= head, tail= takeChars(cs= tail, n= n - 1))

  dropChars(cs -> /Data/List/ConsList[$T -> /Data/Char], n -> /Data/Primitive/Integer) -> /Data/List/ConsList[$T -> /Data/Char]
    # [dropChars] is [cs] without its first [n] characters.
  dropChars(cs= /Data/List/Nil, n)= /Data/List/Nil
  dropChars(cs= /Data/List/Cons(head, tail), n) | n <= 0= /Data/List/Cons(head= head, tail= tail)
  dropChars(cs= /Data/List/Cons(head, tail), n) else = dropChars(cs= tail, n= n - 1)

  reverseChars(cs -> /Data/List/ConsList[$T -> /Data/Char], acc -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [reverseChars] is [cs] backwards, in front of [acc].
  reverseChars(cs= /Data/List/Nil, acc)= acc
  reverseChars(cs= /Data/List/Cons(head, tail), acc)= reverseChars(cs= tail, acc= /Data/List/Cons(head= head, tail= acc))

  :/Data/String.take(n -> /Data/Primitive/Integer) -> /Data/String
    # [take] is the first [n] characters, or the whole string where it is shorter.
  :/Data/String/Text(chars).take(n)= /Data/String/Text(chars= takeChars(cs= chars, n= n))
  :/Catln/CStr.take(n -> /Data/Primitive/Integer) -> /Catln/CStr
    #runtime("cstrTake")

  :/Data/String.drop(n -> /Data/Primitive/Integer) -> /Data/String
    # [drop] is the string without its first [n] characters.
  :/Data/String/Text(chars).drop(n)= /Data/String/Text(chars= dropChars(cs= chars, n= n))
  :/Catln/CStr.drop(n -> /Data/Primitive/Integer) -> /Catln/CStr
    #runtime("cstrDrop")

  :/Data/String.slice(start -> /Data/Primitive/Integer, end -> /Data/Primitive/Integer) -> /Data/String
    # [slice] is the characters from index [start] up to but not including index [end].
  :/Data/String/Text(chars).slice(start, end)= /Data/String/Text(chars= takeChars(cs= dropChars(cs= chars, n= start), n= end - start))
  :/Catln/CStr.slice(start -> /Data/Primitive/Integer, end -> /Data/Primitive/Integer) -> /Catln/CStr
    #runtime("cstrSlice")

  :/Data/String.reversed -> /Data/String
    # [reversed] is the string backwards.
  :/Data/String/Text(chars).reversed= /Data/String/Text(chars= reverseChars(cs= chars, acc= /Data/List/Nil))
  :/Catln/CStr.reversed -> /Catln/CStr
    #runtime("cstrReversed")

  > "hello".take(n= 2)
    >>> he
  > "hello".drop(n= 2)
    >>> llo
  > "hello".take(n= 9)
    >>> hello
  > "hello".slice(start= 1, end= 4)
    >>> ell
  > "hello".reversed
    >>> olleh
  # ## Searching
  charsStartWith(cs -> /Data/List/ConsList[$T -> /Data/Char], prefix -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/Primitive/Boolean
    # [charsStartWith] is whether [cs] begins with the characters of [prefix].
  charsStartWith(cs, prefix= /Data/List/Nil)= /Data/Primitive/True
  charsStartWith(cs= /Data/List/Nil, prefix= /Data/List/Cons(head, tail))= /Data/Primitive/False
  charsStartWith(cs= /Data/List/Cons(head@ch, tail@ct), prefix= /Data/List/Cons(head@ph, tail@pt)) | ch == ph= charsStartWith(cs= ct, prefix= pt)
  charsStartWith(cs= /Data/List/Cons(head@ch, tail@ct), prefix= /Data/List/Cons(head@ph, tail@pt)) else = /Data/Primitive/False

  dropPrefix(cs -> /Data/List/ConsList[$T -> /Data/Char], prefix -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [dropPrefix] is [cs] after the characters of [prefix], which [cs] begins with
      ([charsStartWith]): one character dropped for each of [prefix]'s.
  dropPrefix(cs, prefix= /Data/List/Nil)= cs
  dropPrefix(cs= /Data/List/Nil, prefix= /Data/List/Cons(head, tail))= /Data/List/Nil
  dropPrefix(cs= /Data/List/Cons(head@ch, tail@ct), prefix= /Data/List/Cons(head@ph, tail@pt))= dropPrefix(cs= ct, prefix= pt)

  indexOfChars(cs -> /Data/List/ConsList[$T -> /Data/Char], sub -> /Data/List/ConsList[$T -> /Data/Char], i -> /Data/Primitive/Integer) -> /Data/Maybe[$T -> /Data/Primitive/Integer]
    # [indexOfChars] is where [sub] first occurs in [cs], counting [cs] as starting at [i].
  indexOfChars(cs, sub, i) | charsStartWith(cs= cs, prefix= sub)= /Data/Maybe/Some(value= i)
  indexOfChars(cs, sub, i) else = indexAfter(cs= cs, sub= sub, i= i)

  indexAfter(cs -> /Data/List/ConsList[$T -> /Data/Char], sub -> /Data/List/ConsList[$T -> /Data/Char], i -> /Data/Primitive/Integer) -> /Data/Maybe[$T -> /Data/Primitive/Integer]
    # [indexAfter] carries the search for [sub] past the first character of [cs], which it does not
      start at.
  indexAfter(cs= /Data/List/Nil, sub, i)= /Data/Maybe/Nothing
  indexAfter(cs= /Data/List/Cons(head, tail), sub, i)= indexOfChars(cs= tail, sub= sub, i= i + 1)

  :/Data/String.startsWith(prefix -> /Data/String) -> /Data/Primitive/Boolean
    # [startsWith] is whether the string begins with [prefix].
  :/Data/String/Text(chars@cs).startsWith(prefix= /Data/String/Text(chars@p))= charsStartWith(cs= cs, prefix= p)
  :/Catln/CStr.startsWith(prefix -> /Catln/CStr) -> /Data/Primitive/Boolean
    #runtime("cstrStartsWith")

  :/Data/String.endsWith(suffix -> /Data/String) -> /Data/Primitive/Boolean
    # [endsWith] is whether the string ends with [suffix].
  :/Data/String/Text(chars@cs).endsWith(suffix= /Data/String/Text(chars@s))= charsStartWith(cs= reverseChars(cs= cs, acc= /Data/List/Nil), prefix= reverseChars(cs= s, acc= /Data/List/Nil))
  :/Catln/CStr.endsWith(suffix -> /Catln/CStr) -> /Data/Primitive/Boolean
    #runtime("cstrEndsWith")

  :/Data/String.indexOf(sub -> /Data/String) -> /Data/Maybe[$T -> /Data/Primitive/Integer]
    # [indexOf] is the index at which [sub] first occurs in the string, or [Nothing] where it does
      not occur. The empty string occurs at 0.
  :/Data/String/Text(chars@cs).indexOf(sub= /Data/String/Text(chars@s))= indexOfChars(cs= cs, sub= s, i= 0)
  :/Catln/CStr.indexOf(sub -> /Catln/CStr) -> /Data/Maybe[$T -> /Data/Primitive/Integer]
    #runtime("cstrIndexOf")

  :/Data/String.contains(sub -> /Data/String) -> /Data/Primitive/Boolean
    # [contains] is whether [sub] occurs anywhere in the string.
  :/Data/String/Text(chars@cs).contains(sub= /Data/String/Text(chars@s))= indexOfChars(cs= cs, sub= s, i= 0) != /Data/Maybe/Nothing
  :/Catln/CStr.contains(sub -> /Catln/CStr) -> /Data/Primitive/Boolean
    #runtime("cstrContains")

  > "hello".startsWith(prefix= "he")
    >>> True
  > "hello".startsWith(prefix= "lo")
    >>> False
  > "hello".endsWith(suffix= "lo")
    >>> True
  > ("hello".indexOf(sub= "ll") == /Data/Maybe/Some(value= 2))
    >>> True
  > ("hello".indexOf(sub= "z") == /Data/Maybe/Nothing)
    >>> True
  > "hello".contains(sub= "ell")
    >>> True
  > "hello".contains(sub= "elo")
    >>> False
  # ## Changing a string
  upperChars(cs -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [upperChars] is [cs] with each character made upper case ([/Data/Char/toUpper]).
  upperChars(cs= /Data/List/Nil)= /Data/List/Nil
  upperChars(cs= /Data/List/Cons(head, tail))= /Data/List/Cons(head= head.toUpper, tail= upperChars(cs= tail))

  lowerChars(cs -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [lowerChars] is [cs] with each character made lower case ([/Data/Char/toLower]).
  lowerChars(cs= /Data/List/Nil)= /Data/List/Nil
  lowerChars(cs= /Data/List/Cons(head, tail))= /Data/List/Cons(head= head.toLower, tail= lowerChars(cs= tail))

  dropSpace(cs -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [dropSpace] is [cs] without the white space it begins with.
  dropSpace(cs= /Data/List/Nil)= /Data/List/Nil
  dropSpace(cs= /Data/List/Cons(head, tail)) | head.isSpace= dropSpace(cs= tail)
  dropSpace(cs= /Data/List/Cons(head, tail)) else = /Data/List/Cons(head= head, tail= tail)

  replaceChars(cs -> /Data/List/ConsList[$T -> /Data/Char], old -> /Data/List/ConsList[$T -> /Data/Char], new -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/Char]
    # [replaceChars] is [cs] with each occurrence of [old] replaced by [new], each found after the
      one before it. [old] is not empty.
  replaceChars(cs= /Data/List/Nil, old, new)= /Data/List/Nil
  replaceChars(cs= /Data/List/Cons(head, tail), old, new) | charsStartWith(cs= /Data/List/Cons(head= head, tail= tail), prefix= old)= /Data/appendChars(l= new, r= replaceChars(cs= dropPrefix(cs= /Data/List/Cons(head= head, tail= tail), prefix= old), old= old, new= new))
  replaceChars(cs= /Data/List/Cons(head, tail), old, new) else = /Data/List/Cons(head= head, tail= replaceChars(cs= tail, old= old, new= new))

  :/Data/String.toUpper -> /Data/String
    # [toUpper] is the string with each lower case letter made upper case.
  :/Data/String/Text(chars).toUpper= /Data/String/Text(chars= upperChars(cs= chars))
  :/Catln/CStr.toUpper -> /Catln/CStr
    #runtime("cstrToUpper")

  :/Data/String.toLower -> /Data/String
    # [toLower] is the string with each upper case letter made lower case.
  :/Data/String/Text(chars).toLower= /Data/String/Text(chars= lowerChars(cs= chars))
  :/Catln/CStr.toLower -> /Catln/CStr
    #runtime("cstrToLower")

  :/Data/String.trimStart -> /Data/String
    # [trimStart] is the string without the white space it begins with.
  :/Data/String/Text(chars).trimStart= /Data/String/Text(chars= dropSpace(cs= chars))
  :/Catln/CStr.trimStart -> /Catln/CStr
    #runtime("cstrTrimStart")

  :/Data/String.trimEnd -> /Data/String
    # [trimEnd] is the string without the white space it ends with.
  :/Data/String/Text(chars).trimEnd= /Data/String/Text(chars= reverseChars(cs= dropSpace(cs= reverseChars(cs= chars, acc= /Data/List/Nil)), acc= /Data/List/Nil))
  :/Catln/CStr.trimEnd -> /Catln/CStr
    #runtime("cstrTrimEnd")

  :/Data/String.trim -> /Data/String
    # [trim] is the string without white space at either end.
  :/Data/String/Text(chars).trim= /Data/String/Text(chars= reverseChars(cs= dropSpace(cs= reverseChars(cs= dropSpace(cs= chars), acc= /Data/List/Nil)), acc= /Data/List/Nil))
  :/Catln/CStr.trim -> /Catln/CStr
    #runtime("cstrTrim")

  :/Data/String.replace(old -> /Data/String, new -> /Data/String) -> /Data/String
    # [replace] is the string with every occurrence of [old] replaced by [new], each found after
      the one before it. An empty [old] occurs nowhere, so it replaces nothing.
  :/Data/String/Text(chars@cs).replace(old= /Data/String/Text(chars= /Data/List/Nil), new)= /Data/String/Text(chars= cs)
  :/Data/String/Text(chars@cs).replace(old= /Data/String/Text(chars= /Data/List/Cons(head@oh, tail@ot)), new= /Data/String/Text(chars@n))= /Data/String/Text(chars= replaceChars(cs= cs, old= /Data/List/Cons(head= oh, tail= ot), new= n))
  :/Catln/CStr.replace(old -> /Catln/CStr, new -> /Catln/CStr) -> /Catln/CStr
    #runtime("cstrReplace")

  :/Data/String.repeat(n -> /Data/Primitive/Integer) -> /Data/String
    # [repeat] is [n] copies of the string joined end to end, and the empty string for no copies.
  :/Data/String.repeat(n) | n <= 0= ""
  :/Data/String.repeat(n) else = this ++ this.repeat(n= n - 1)

  > "Hello".toUpper
    >>> HELLO
  > "Hello".toLower
    >>> hello
  > ("  hi \n".trim == "hi")
    >>> True
  > ("  hi ".trimStart == "hi ")
    >>> True
  > (" hi  ".trimEnd == " hi")
    >>> True
  > "a-b-c".replace(old= "-", new= ", ")
    >>> a, b, c
  > "abc".replace(old= "", new= "x")
    >>> abc
  > "ab".repeat(n= 3)
    >>> ababab
  # ## Splitting and joining
  splitChars(cs -> /Data/List/ConsList[$T -> /Data/Char], sep -> /Data/List/ConsList[$T -> /Data/Char], cur -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/String]
    # [splitChars] cuts [cs] at each [sep], which is not empty, where [cur] holds, backwards, the
      piece being read.
  splitChars(cs= /Data/List/Nil, sep, cur)= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= cur, acc= /Data/List/Nil)), tail= /Data/List/Nil)
  splitChars(cs= /Data/List/Cons(head, tail), sep, cur) | charsStartWith(cs= /Data/List/Cons(head= head, tail= tail), prefix= sep)= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= cur, acc= /Data/List/Nil)), tail= splitChars(cs= dropPrefix(cs= /Data/List/Cons(head= head, tail= tail), prefix= sep), sep= sep, cur= /Data/List/Nil))
  splitChars(cs= /Data/List/Cons(head, tail), sep, cur) else = splitChars(cs= tail, sep= sep, cur= /Data/List/Cons(head= head, tail= cur))

  :/Data/String.split(sep -> /Data/String) -> /Data/List/ConsList[$T -> /Data/String]
    # [split] cuts the string at each occurrence of [sep], keeping the pieces between them, empty
      ones included, so that joining them back with [sep] gives the string again. An empty [sep]
      occurs nowhere, so the string is its only piece.
  :/Data/String/Text(chars@cs).split(sep= /Data/String/Text(chars= /Data/List/Nil))= /Data/List/Cons(head= /Data/String/Text(chars= cs), tail= /Data/List/Nil)
  :/Data/String/Text(chars@cs).split(sep= /Data/String/Text(chars= /Data/List/Cons(head@sh, tail@st)))= splitChars(cs= cs, sep= /Data/List/Cons(head= sh, tail= st), cur= /Data/List/Nil)
  :/Catln/CStr.split(sep -> /Catln/CStr) -> /Data/List/ConsList[$T -> /Catln/CStr]
    #runtime("cstrSplit")

  linesOf(cs -> /Data/List/ConsList[$T -> /Data/Char], cur -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/String]
    # [linesOf] cuts [cs] at each newline, where [cur] holds, backwards, the line being read.
  linesOf(cs= /Data/List/Nil, cur= /Data/List/Nil)= /Data/List/Nil
  linesOf(cs= /Data/List/Nil, cur= /Data/List/Cons(head, tail))= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= /Data/List/Cons(head= head, tail= tail), acc= /Data/List/Nil)), tail= /Data/List/Nil)
  linesOf(cs= /Data/List/Cons(head, tail), cur) | head == '\n'= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= cur, acc= /Data/List/Nil)), tail= linesOf(cs= tail, cur= /Data/List/Nil))
  linesOf(cs= /Data/List/Cons(head, tail), cur) else = linesOf(cs= tail, cur= /Data/List/Cons(head= head, tail= cur))

  wordsOf(cs -> /Data/List/ConsList[$T -> /Data/Char], cur -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/String]
    # [wordsOf] cuts [cs] into the runs of characters between white space, where [cur] holds,
      backwards, the word being read.
  wordsOf(cs= /Data/List/Nil, cur= /Data/List/Nil)= /Data/List/Nil
  wordsOf(cs= /Data/List/Nil, cur= /Data/List/Cons(head, tail))= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= /Data/List/Cons(head= head, tail= tail), acc= /Data/List/Nil)), tail= /Data/List/Nil)
  wordsOf(cs= /Data/List/Cons(head, tail), cur) | head.isSpace= endWord(rest= tail, cur= cur)
  wordsOf(cs= /Data/List/Cons(head, tail), cur) else = wordsOf(cs= tail, cur= /Data/List/Cons(head= head, tail= cur))

  endWord(rest -> /Data/List/ConsList[$T -> /Data/Char], cur -> /Data/List/ConsList[$T -> /Data/Char]) -> /Data/List/ConsList[$T -> /Data/String]
    # [endWord] closes the word [cur] at a space, if one was being read, and reads on from [rest].
  endWord(rest, cur= /Data/List/Nil)= wordsOf(cs= rest, cur= /Data/List/Nil)
  endWord(rest, cur= /Data/List/Cons(head, tail))= /Data/List/Cons(head= /Data/String/Text(chars= reverseChars(cs= /Data/List/Cons(head= head, tail= tail), acc= /Data/List/Nil)), tail= wordsOf(cs= rest, cur= /Data/List/Nil))

  :/Data/String.lines -> /Data/List/ConsList[$T -> /Data/String]
    # [lines] is the lines of the string, cut at each newline. A newline ends the line before it,
      so a string ending in one has no empty line after it, and the empty string has no lines.
  :/Data/String/Text(chars).lines= linesOf(cs= chars, cur= /Data/List/Nil)
  :/Catln/CStr.lines -> /Data/List/ConsList[$T -> /Catln/CStr]
    #runtime("cstrLines")

  :/Data/String.words -> /Data/List/ConsList[$T -> /Data/String]
    # [words] is the words of the string: the runs of characters between white space.
  :/Data/String/Text(chars).words= wordsOf(cs= chars, cur= /Data/List/Nil)
  :/Catln/CStr.words -> /Data/List/ConsList[$T -> /Catln/CStr]
    #runtime("cstrWords")

  join(sep -> /Data/String, parts -> /Data/List/ConsList[$T -> /Data/String]) -> /Data/String
    # [join] is the strings of [parts] joined end to end with [sep] between each two.
  join(sep, parts= /Data/List/Nil)= ""
  join(sep, parts= /Data/List/Cons(head, tail= /Data/List/Nil))= head
  join(sep, parts= /Data/List/Cons(head@first, tail= /Data/List/Cons(head, tail)))= first ++ sep ++ join(sep= sep, parts= /Data/List/Cons(head= head, tail= tail))

  > join(sep= "|", parts= "a,b,,c".split(sep= ","))
    >>> a|b||c
  > join(sep= "|", parts= "a, b".split(sep= ", "))
    >>> a|b
  > join(sep= "|", parts= "abc".split(sep= ""))
    >>> abc
  > join(sep= "|", parts= "one\ntwo\n".lines)
    >>> one|two
  > join(sep= "|", parts= "  some  words here ".words)
    >>> some|words|here
  > join(sep= ", ", parts= ["a", "b", "c"])
    >>> a, b, c
  > join(sep= ", ", parts= "x-y".split(sep= "-"))
    >>> x, y
