import "core"


module(Http)
  # # HTTP
    Requests over the network. Sending one runs in an [/Catln/IO] context, because it reaches
    outside the program: what comes back is decided by whatever answers, and sending it can change
    what answers the next one. So a program can only send a request where it runs in an io.
    This is not part of the standard library. A program which sends no request has no use for it,
    and one that does writes `import "http"`.
  data(Header(name -> String, value -> String))
    # One header of a request: its name, and what it is set to.

  class(HttpErr, [HttpErr/InvalidUrl(url -> String, detail -> String), HttpErr/Unreachable(url -> String, detail -> String), HttpErr/Status(url -> String, code -> Integer, body -> String), HttpErr/NotSent(url -> String)], isa= [/Data/Err])
    # [HttpErr] is why a request to [url] has no response: the URL is not one ([InvalidUrl]); the
      request could not be made, as where the host does not answer ([Unreachable]); the response's
      status [code] is not a success, with the [body] it came with, which is where an API says what
      the matter was ([Status]); or the run reaches no network, so it was not sent ([NotSent]).
      [detail] is what the system said went wrong.

  httpPost{io -> IO}(url -> String, headers -> /Data/List[$T -> Header..], body -> String) -> /Data/Result[$T -> String, $E -> HttpErr]{IO}
    # [httpPost] sends [body] to [url] as the body of a POST request with [headers] set, and answers
      with the body of the response, or the [HttpErr] saying why there is none. The body is sent
      and read as UTF-8.
      What a run can reach is decided by whatever started it. A program run by `catln run` reaches
      the network; the webdocs' debugger reaches none, and a request made in it is answered with
      [HttpErr/NotSent] rather than being sent.
    #runtime("ioHttpPost")
module(Data)
  :/Http/HttpErr/InvalidUrl(url, detail).msg= url ++ " is not a URL a request can be sent to: " ++ detail
  :/Http/HttpErr/Unreachable(url, detail).msg= "the request to " ++ url ++ " could not be made: " ++ detail
  :/Http/HttpErr/Status(url, code, body).msg= "the request to " ++ url ++ " answered with status " ++ code.toString ++ ": " ++ body
  :/Http/HttpErr/NotSent(url).msg= "the request to " ++ url ++ " was not sent, as this run reaches no network"
module(Http)
  > /Data/Result/Fail(err= HttpErr/Status(url= "http://x.test", code= 401, body= "no key"))
    >>> error: the request to http://x.test answered with status 401: no key
