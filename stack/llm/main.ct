import "core"
import "env"
import "http"
import "json/json.ct"
import "json/encode.ct"
import "json/decode.ct"
import hsrawprgm()


module(Llm)
  # # Asking a language model
    [llm] sends a prompt to a language model and answers with its reply. It speaks the chat
    completions API that OpenAI serves and that most other model servers copy, so where it sends is
    configured rather than fixed, by environment variables:
    - `OPENAI_BASE_URL` is the address of the API, up to and not including `/chat/completions`:
      `https://api.openai.com/v1`, or `http://localhost:11434/v1` for a model served locally.
    - `OPENAI_MODEL` is the model to ask.
    - `OPENAI_API_KEY` is the key to ask with, sent as a bearer token. It may be left unset, for a
      server that asks for none.
    It runs in an [/Catln/IO] context because everything it does reaches outside the program: it
    reads the environment and it sends a request.
    This is not part of the standard library. A program which asks no model has no use for it, and
    one that does writes `import "llm"`.
  class(LlmErr, [LlmErr/Unset(variable -> String), LlmErr/Request(cause -> /Http/HttpErr), LlmErr/NotJson(cause -> /Data/JsonParseErr..), LlmErr/ApiError(message -> String), LlmErr/NoReply(path -> String, cause -> /Data/JsonAccessErr), LlmErr/NotText(path -> String, found -> /Data/Json)], isa= [/Data/Err])
    # [LlmErr] is why a model gave no reply: the variable [variable] it is configured by is unset
      ([Unset]); the request could not be sent or was answered with a failure ([Request]); the
      response is not JSON ([NotJson]); the API answered with an error saying
      [message] ([ApiError]); or the response has nothing at [path], where the reply is
      ([NoReply]), or something other than text there ([NotText]).

  llm{io -> IO}(input -> String) -> /Data/Result[$T -> String, $E -> LlmErr]{IO}
    # [llm] is the reply of the configured model to the prompt [input], or the [LlmErr] saying why
      there is none.
  llm{io -> IO}(input) =
    base<- /System/env(name= "OPENAI_BASE_URL")

    model<- /System/env(name= "OPENAI_MODEL")

    key<- /System/env(name= "OPENAI_API_KEY")

    reply<- llmWith(input= input, base= base, model= model, key= key)
    reply

  llmWith{io -> IO}(input -> String, base -> /Data/Maybe[$T -> String], model -> /Data/Maybe[$T -> String], key -> /Data/Maybe[$T -> String]) -> /Data/Result[$T -> String, $E -> LlmErr]{IO}
    # [llmWith] asks the model [model] at [base] about [input], where both are configured.
  llmWith{io -> IO}(input, base= /Data/Maybe/Nothing, model, key)= /Data/Result/Fail(err= LlmErr/Unset(variable= "OPENAI_BASE_URL")){io}
  llmWith{io -> IO}(input, base= /Data/Maybe/Some(value), model= /Data/Maybe/Nothing, key)= /Data/Result/Fail(err= LlmErr/Unset(variable= "OPENAI_MODEL")){io}
  llmWith{io -> IO}(input, base= /Data/Maybe/Some(value@b), model= /Data/Maybe/Some(value@m), key) =
    response<- /Http/httpPost(url= b ++ "/chat/completions", headers= llmHeaders(key= key), body= llmRequest(model= m, input= input))

    llmSent(response= response)

  llmSent(response -> /Data/Result[$T -> String, $E -> /Http/HttpErr]) -> /Data/Result[$T -> String, $E -> LlmErr]
    # [llmSent] is the reply in the body of the [response], or why the request has none.
  llmSent(response= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/Request(cause= err))
  llmSent(response= /Data/Result/Ok(value))= llmReply(response= /Data/jsonParse(text= value))

  # ## Showing a model
    What a model is shown of a value is its own question, as what a person is shown of one is
    [/Catln/Doc/dshow]'s. A type may be displayed in the webdocs as markup, or as a chart, and be
    written for a model as something else again. The two share the text of a [/Data/ToString],
    which either reader can read, so a type need only say how a model sees it where that differs.
  class(LlmShow)
    # Represents values which can be shown to a language model.

  llmshow(s -> LlmShow)= s
    # [llmshow] resolves a value to what a language model is shown of it. The identity arm passes a
      value that is already [LlmShow] straight through. A type is shown some other way by an arm of
      its own, written beside it.

  every(String, isa= [/Llm/LlmShow])
  every(/Data/ToString, isa= [/Llm/LlmShow])
    # Every [/Data/ToString] value is shown to a model as its text, the same text the webdocs show a
      person ([/Catln/Doc/DShow]).

  > llmshow(s= "text")
    >>> text
  > llmshow(s= 3)
    >>> 3
  # ## Asking about the program it is asked from
    [lcm], a large code model, asks [llm] with the program it is written in. The page the call is
    written on is put before what it asks, as it was written and with each of its annotations shown
    with what it evaluates to: a `> expr` with its `>>>` result, and any other annotation a model
    can be shown ([LlmShow]) as a print of itself. So a model asked about a page reads what the
    page says it computes, and not only what it says.
    The page is the one the program was compiled from, handed to the call by the compiler rather
    than read again from the file: a call written as `lcm(input= ...)` is completed to
    `lcm(input= ..., page= ...)` where it is written ([/Catln/pageAt]).
  lcm{io -> IO}(input -> String) -> /Data/Result[$T -> String, $E -> LlmErr]{IO}
    # [lcm] is the reply of the configured model to the prompt [input], asked with the page the call
      is written in. It answers as [llm] does.
    #runtime("callerPage")
  lcm{io -> IO}(input -> String, page -> /Catln/RawPrgm..) -> /Data/Result[$T -> String, $E -> LlmErr]{IO} =
    reply<- llm(input= lcmPrompt(input= input, page= page))
    reply

  lcmPrompt(input -> String) -> String
    # [lcmPrompt] is what [lcm] asks the model: the page the call is written in, and then [input].
      Asking a model reaches outside the program, while this does not, so it is what is checked of
      [lcm] without asking anything.
    #runtime("callerPage")
  lcmPrompt(input -> String, page -> /Catln/RawPrgm..)= showPage(page= page) ++ "\n" ++ input

  # [lcm] calls [lcmPrompt] with the page it was handed, as here. A page with nothing written on
    it is shown as nothing, so what is asked is the question alone.
  > lcmPrompt(input= "What is on this page?", page= /Catln/RawPrgm(imports= [], statements= []))
    >>>
    >>> What is on this page?
  showPage(page -> /Catln/RawPrgm..) -> String
    # [showPage] is the [page] as it was written, with each annotation of it a model can be shown
      shown with what it evaluates to. An annotation which cannot be, or which fails to evaluate, is
      written as it was.
    #runtime("llmShowPage")

  # ## Asking about a page from the page
    A question about a page can be written on the page itself, as `q> ` and then the question. It
    is a [#q], and is asked by `catln process`, which writes the reply under the question as the
    `>>>` lines of its [result], the way `catln test --update` writes what a `> expr` prints. A
    question with a reply is not asked again; its `>>>` lines are removed to ask it again.
  annot(#q(input -> String))
    # [#q] is a question for a model about the page it is written on, asked by [lcm].
  annot(#q(input -> String, result -> String))
    # The [#q] can also hold the [result] the model replied with.
  annot(#q(input -> String, failure -> String))
    # A [#q] the model gave no reply to holds the [failure] saying why, for `catln process` to
      report. It is not written back: the question is left unanswered, to be asked again.

  /Catln/process{io -> /Catln/IO}(annot -> #q(input -> String)) -> #q..{IO}
    # A [#q] is processed by asking it with the page it is written on, and is updated to hold the
      reply as its [result]. Where there is no reply it holds the [failure] saying why.
    #runtime("callerPage")
  /Catln/process{io -> /Catln/IO}(annot= #q(input -> String), page -> /Catln/RawPrgm..) -> #q..{IO} =
    reply<- lcm(input= input, page= page)

    qAnswered(input= input, reply= reply)

  qAnswered(input -> String, reply -> /Data/Result[$T -> String, $E -> LlmErr]) -> #q..
    # [qAnswered] is the [#q] asking [input], holding the [reply] where there is one, and why there
      is none where there is not.
  qAnswered(input, reply= /Data/Result/Fail(err))= #q(input= input, failure= err.msg)
  qAnswered(input, reply= /Data/Result/Ok(value))= #q(input= input, result= value)

  # ## The request
  llmRequest(model -> String, input -> String) -> String
    # [llmRequest] is the body asking [model] about [input]: one message, from the user.
  llmRequest(model, input)= /Data/jsonEncode(value= /Data/Json/Object(entries= [/Data/Json/Member(key= "model", value= /Data/Json/Str(value= model)), /Data/Json/Member(key= "messages", value= /Data/Json/Array(entries= [/Data/Json/Object(entries= [/Data/Json/Member(key= "role", value= /Data/Json/Str(value= "user")), /Data/Json/Member(key= "content", value= /Data/Json/Str(value= input))])]))]))

  > llmRequest(model= "m", input= "Say \"hi\"")
    >>> {"model":"m","messages":[{"role":"user","content":"Say \"hi\""}]}
  llmHeaders(key -> /Data/Maybe[$T -> String]) -> /Data/List/ConsList[$T -> /Http/Header(name -> String, value -> String)]
    # [llmHeaders] are the headers the request is sent with: that its body is JSON, and the key to
      ask with where there is one.
  llmHeaders(key= /Data/Maybe/Nothing)= [/Http/Header(name= "Content-Type", value= "application/json")]
  llmHeaders(key= /Data/Maybe/Some(value@k))= [/Http/Header(name= "Content-Type", value= "application/json"), /Http/Header(name= "Authorization", value= "Bearer " ++ k)]

  # ## The reply
    The reply is the text at `choices[0].message.content` of the response, read one step at a
    time. A step which finds nothing where it reads fails with the path read so far, and the steps
    after it pass that on. A response holding an `error` is the API saying what was wrong, and is
    answered with that rather than with the reply it does not hold.
  llmReply(response -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonParseErr..]) -> /Data/Result[$T -> String, $E -> LlmErr]
  llmReply(response= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/NotJson(cause= err))
  llmReply(response= /Data/Result/Ok(value))= llmAnswer(error= /Data/jsonMember(value= value, key= "error"), response= value)

  llmAnswer(error -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr], response -> /Data/Json) -> /Data/Result[$T -> String, $E -> LlmErr]
    # [llmAnswer] is the reply in [response], or the [error] it holds instead.
  llmAnswer(error= /Data/Result/Ok(value), response)= /Data/Result/Fail(err= LlmErr/ApiError(message= llmErrorText(e= value)))
  llmAnswer(error= /Data/Result/Fail(err), response)= llmChoice(choices= /Data/jsonMember(value= response, key= "choices"))

  llmErrorText(e -> /Data/Json) -> String
    # [llmErrorText] is what an API's error [e] says: its `message` where it has one, as the
      OpenAI API writes one, and the error written out as JSON where it does not.
  llmErrorText(e)= llmErrorMessage(message= /Data/jsonMember(value= e, key= "message"), e= e)

  llmErrorMessage(message -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr], e -> /Data/Json) -> String
  llmErrorMessage(message= /Data/Result/Ok(value= /Data/Json/Str(value@m)), e)= m
  llmErrorMessage(message, e) else = /Data/jsonEncode(value= e)

  llmChoice(choices -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr]) -> /Data/Result[$T -> String, $E -> LlmErr]
  llmChoice(choices= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/NoReply(path= "choices", cause= err))
  llmChoice(choices= /Data/Result/Ok(value))= llmMessage(choice= /Data/jsonIndex(value= value, i= 0))

  llmMessage(choice -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr]) -> /Data/Result[$T -> String, $E -> LlmErr]
  llmMessage(choice= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/NoReply(path= "choices[0]", cause= err))
  llmMessage(choice= /Data/Result/Ok(value))= llmContent(message= /Data/jsonMember(value= value, key= "message"))

  llmContent(message -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr]) -> /Data/Result[$T -> String, $E -> LlmErr]
  llmContent(message= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/NoReply(path= "choices[0].message", cause= err))
  llmContent(message= /Data/Result/Ok(value))= llmText(content= /Data/jsonMember(value= value, key= "content"))

  llmText(content -> /Data/Result[$T -> /Data/Json, $E -> /Data/JsonAccessErr]) -> /Data/Result[$T -> String, $E -> LlmErr]
  llmText(content= /Data/Result/Fail(err))= /Data/Result/Fail(err= LlmErr/NoReply(path= "choices[0].message.content", cause= err))
  llmText(content= /Data/Result/Ok(value= /Data/Json/Str(value@s)))= /Data/Result/Ok(value= s)
  llmText(content= /Data/Result/Ok(value@v)) else = /Data/Result/Fail(err= LlmErr/NotText(path= "choices[0].message.content", found= v))

  > llmReply(response= /Data/jsonParse(text= "{\"choices\": [{\"message\": {\"role\": \"assistant\", \"content\": \"Hello!\"}}]}"))
    >>> Hello!
  > llmReply(response= /Data/jsonParse(text= "{\"error\": {\"message\": \"Incorrect API key\"}}"))
    >>> error: the model's API answered with an error: Incorrect API key
  > llmReply(response= /Data/jsonParse(text= "{\"error\": \"no\"}"))
    >>> error: the model's API answered with an error: "no"
  > llmReply(response= /Data/jsonParse(text= "{\"choices\": []}"))
    >>> error: the model's response has no reply at choices[0]: there is no entry 0 of an array of 0
  > llmReply(response= /Data/jsonParse(text= "{\"choices\": [{\"message\": {\"content\": 3}}]}"))
    >>> error: the model's reply at choices[0].message.content is a number, not text
  > llmReply(response= /Data/jsonParse(text= "<html>"))
    >>> error: the model's response is not JSON: '<' is where a value was expected, at character 0
  > llmSent(response= /Data/Result/Fail(err= /Http/HttpErr/Status(url= "http://model.test/v1/chat/completions", code= 401, body= "no key")))
    >>> error: the model could not be asked: the request to http://model.test/v1/chat/completions answered with status 401: no key
module(Data)
  :/Llm/LlmErr/Unset(variable).msg= variable ++ " is not set, so there is no model to ask"
  :/Llm/LlmErr/Request(cause).msg= "the model could not be asked: " ++ cause.msg
  :/Llm/LlmErr/NotJson(cause).msg= "the model's response is " ++ cause.msg
  :/Llm/LlmErr/ApiError(message).msg= "the model's API answered with an error: " ++ message
  :/Llm/LlmErr/NoReply(path, cause).msg= "the model's response has no reply at " ++ path ++ ": " ++ cause.msg
  :/Llm/LlmErr/NotText(path, found).msg= "the model's reply at " ++ path ++ " is " ++ /Data/jsonKind(j= found) ++ ", not text"
